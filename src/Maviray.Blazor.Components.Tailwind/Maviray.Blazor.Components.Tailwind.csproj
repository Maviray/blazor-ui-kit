<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Maviray.Blazor.Components.Tailwind</PackageId>
    <Description>Blazor UI Tailwind library</Description>
    <PackageTags>blazor;components;ui;tailwind;maviray</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Forms" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
    <PackageReference Include="Microsoft.JSInterop" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package-lock.json;package.json" />
    <None Include="package-lock.json;package.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maviray.Blazor.Components.Core\Maviray.Blazor.Components.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TailwindCssOutput>wwwroot/css/maviray.tailwind.min.css</TailwindCssOutput>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Tailwind.targets" />
</Project>
