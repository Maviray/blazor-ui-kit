@inherits MaviComponentBase

<svg id="@Id" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="@IconColorCss" class="@EffectiveCss" title="@Title" style="@Style" @onclick="HandleClick">
    @foreach (var path in IconPaths)
    {
        @((MarkupString)path)
    }
    <title>@Title</title>
</svg>

@code {

    [Parameter]
    public IconSolidType IconSolidType { get; set; }
    
    [Parameter]
    public IconColor IconColor { get; set; }

    public string IconColorCss => IconColor.ToString();

    [Parameter]
    public IconSize IconSize { get; set; }

    private string EffectiveCss
    {
        get
        {
            return IconSize switch
            {
                IconSize.Giant => Class + " " + "w-16 h-16 cursor-pointer",
                IconSize.ExtraLarge => Class + " " + "w-14 h-14 cursor-pointer",
                IconSize.Medium => Class + " " + "w-8 h-8 cursor-pointer",
                IconSize.Large => Class + " " + "w-12 h-12 cursor-pointer",
                IconSize.Small => Class + " " + "w-6 h-6 cursor-pointer",
                IconSize.ExtraSmall => Class + " " + "w-4 h-4 cursor-pointer",
                _ => Class + " " + "w-10 h-10 cursor-pointer"
            };
        }
    }

    [Parameter]
    public EventCallback<string> OnClick { get; set; }

    private IEnumerable<string> IconPaths => MaviIconSolidPaths.GetIconPaths(IconSolidType);

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate) await OnClick.InvokeAsync(Id);

        if (EnableLifeCycleLogging)
        {
            Logger?.LogDebugLifeCycle( Id, GetType());
        }
    }
}