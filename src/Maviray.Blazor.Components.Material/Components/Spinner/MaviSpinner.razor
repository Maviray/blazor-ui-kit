@inherits MaviSpinnerBase

<div class="inline-block relative w-20 h-20 text-[#1c4c5b]">
    <!-- rotating ring -->
    <div class="absolute inset-0 animate-[mavi-swing-rotate_1.35s_linear_infinite]">
        <!-- dot 0 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(0deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:0s]"></div>
        </div>

        <!-- dot 1 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(30deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-0.11s]"></div>
        </div>

        <!-- dot 2 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(60deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-0.22s]"></div>
        </div>

        <!-- dot 3 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(90deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-0.33s]"></div>
        </div>

        <!-- dot 4 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(120deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-0.44s]"></div>
        </div>

        <!-- dot 5 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(150deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-0.55s]"></div>
        </div>

        <!-- dot 6 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(180deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-0.66s]"></div>
        </div>

        <!-- dot 7 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(210deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-0.77s]"></div>
        </div>

        <!-- dot 8 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(240deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-0.88s]"></div>
        </div>

        <!-- dot 9 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(270deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-0.99s]"></div>
        </div>

        <!-- dot 10 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(300deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-1.10s]"></div>
        </div>

        <!-- dot 11 -->
        <div class="absolute top-1/2 left-1/2 w-0 h-0" style="transform: rotate(330deg) translateY(-32px);">
            <div class="w-[6px] h-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-current animate-[mavi-swing-dot_1.35s_ease-in-out_infinite] [animation-delay:-1.21s]"></div>
        </div>
    </div>
</div>