    </div>

    <!-- 4 -->
    <div class="absolute inset-0 [transform-origin:40px_40px] animate-[mavi-spinner-roller_1.2s_cubic-bezier(0.5,0,0.5,1)_infinite] [animation-delay:-0.144s]">
        <div class="absolute w-[7.2px] h-[7.2px] rounded-full bg-current -translate-x-1/2 -translate-y-1/2"
             style="top:72px; left:40px;"></div>
    </div>

    <!-- 5 -->
    <div class="absolute inset-0 [transform-origin:40px_40px] animate-[mavi-spinner-roller_1.2s_cubic-bezier(0.5,0,0.5,1)_infinite] [animation-delay:-0.18s]">
        <div class="absolute w-[7.2px] h-[7.2px] rounded-full bg-current -translate-x-1/2 -translate-y-1/2"
             style="top:70.90963px; left:31.71779px;"></div>
    </div>

