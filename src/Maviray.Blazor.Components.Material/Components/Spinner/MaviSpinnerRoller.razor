        <div class="absolute w-[7.2px] h-[7.2px] rounded-full bg-current -translate-x-1/2 -translate-y-1/2"
             style="top:62.62742px; left:17.37258px;"></div>
    </div>

    <!-- 8 -->
    <div class="absolute inset-0 [transform-origin:40px_40px] animate-[mavi-spinner-roller_1.2s_cubic-bezier(0.5,0,0.5,1)_infinite] [animation-delay:-0.288s]">
