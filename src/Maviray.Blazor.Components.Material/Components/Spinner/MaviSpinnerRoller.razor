        <div class="absolute w-[7.2px] h-[7.2px] rounded-full bg-current -translate-x-1/2 -translate-y-1/2"
             style="top:62.62742px; left:62.62742px;"></div>
    </div>

    <!-- 2 -->
    <div class="absolute inset-0 [transform-origin:40px_40px] animate-[mavi-spinner-roller_1.2s_cubic-bezier(0.5,0,0.5,1)_infinite] [animation-delay:-0.072s]">
        <div class="absolute w-[7.2px] h-[7.2px] rounded-full bg-current -translate-x-1/2 -translate-y-1/2"
             style="top:67.71281px; left:56px;"></div>
    </div>

    <!-- 3 -->
    <div class="absolute inset-0 [transform-origin:40px_40px] animate-[mavi-spinner-roller_1.2s_cubic-bezier(0.5,0,0.5,1)_infinite] [animation-delay:-0.108s]">
        <div class="absolute w-[7.2px] h-[7.2px] rounded-full bg-current -translate-x-1/2 -translate-y-1/2"
