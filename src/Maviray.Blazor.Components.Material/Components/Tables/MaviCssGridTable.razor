@using Maviray.Blazor.Components.Core.Models.Tables
@using Maviray.Blazor.Components.Material.Components.DataDisplay.Icons
@using Maviray.Blazor.Components.Material.Components.Feedback
@using Maviray.Blazor.Components.Material.Components.Inputs
@using Maviray.Blazor.Components.Material.Components.Spinner
@using Maviray.Blazor.Components.Material.Constants
@inherits MaviInMemoryTableBase

<div class="w-full overflow-hidden rounded-xl border border-zinc-200 text-sm min-h-40 relative">
    <MaviBackdrop @ref="_maviBackdrop"
                  Opacity="BackdropOpacity.Lighten"
                  ZIndex="ZIndex.Fifty"
                  CloseOnBackdropClick="false"
                  InitiallyActive="_backdropInitialState"
                  CenterContent="true">
        <MaviSpinnerStarRotate ThemeColorScheme="ThemeColorScheme.Default" ElementSize="ElementSize.Regular" />
    </MaviBackdrop>
    
    @if (Collection != null && Collection.Rows.Any())
    {
        <div class="grid divide-y divide-zinc-200" style="grid-template-columns: repeat(@VisibleColumnsCount, minmax(min-content, 200px))">
            @* Header row *@
            @foreach (var column in VisibleColumns)
            {
                <div class="@GetColumnHeaderContainerCss(column)">
                    <div class="@GetColumnHeaderCss(column)">
                        <div class="@Tailwind.Theme.Typography.LABEL_LARGE cursor-pointer select-none transition-colors @Tailwind.Theme.Colors.Text.Hover.THEME_DEFAULT_TEN_TEXT_HOVER flex items-center gap-2"
                             @onclick="() => SortByColumn(column.Key)">
                            <span>@column.Title</span>
                            @if (Collection?.SortColumnKey == column.Key)
                            {
                                if (Collection?.SortOrder == SortOrder.Ascending)
                                {
                                    <i class="lni lni-chevron-down"></i>
                                }
                                else
                                {
                                    <i class="lni lni-chevron-up"></i>
                                }
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="@GetContextMenuCellCss()">
                @if (MainMenuItems is not null && MainMenuItems.Any())
                {
                    <div id="@ContextMenuId" data-context-menu-id="@ContextMenuId" class="relative flex justify-end">
                        <!-- Btn Toggle Context Menu Dropdown -->
                        <MaviButtonIcon Icon="lni lni-menu-meatballs-1"
                                        ElementVariant="ElementVariant.Text"
                                        ThemeColorScheme="ThemeColorScheme.Default"
                                        ElementSize="ElementSize.Small"
                                        OnClick="ToggleMainContextMenuDropDown"
                                        Title="@Parameters?.ContentMenuTitle" />

                        <!-- Context Menu Dropdown -->
                        <div class="@GetMainContextMenuCss()" style="@GetMainContextMenuStyle()">
                            @foreach (var contextMenuButton in MainMenuItems)
                            {
                                <button class="@Tailwind.Theme.Typography.BODY_MEDIUM @Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT @Tailwind.Theme.Colors.Background.Hover.THEME_DEFAULT_TWO_BG_HOVER block w-full px-4 py-2.5 text-left rounded-md transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                                        disabled="@contextMenuButton?.Disabled"
                                        @onclick="async () => { await ContextMenuClick(contextMenuButton); }">
                                    @contextMenuButton?.Title
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            @* Filter row *@
            @if (Parameters?.EnableFilters == true)
            {
                @foreach (var column in VisibleColumns)
                {
                    <div class="px-4 py-2 bg-zinc-50">
                        <input type="text"
                               id="@($"filter-{column.Key}-{Id}")"
                               class="@GetSearchInputCss()"
                               placeholder="@Parameters?.FilterPlaceholderText"
                               @oninput="(e) => UpdateColumnFilter(column.Key, e)"/>
                    </div>
                }
                <div class="px-4 py-2 bg-zinc-50"></div>
            }
            @* Data rows *@
            @if (Collection != null)
            {
                foreach (var (row, rowIndex) in Collection.GetCurrentPageRows().Select((r, i) => (r, i)))
                {
                    <div @key="row.Guid" style="display:contents" class="group">
                        @foreach (var col in VisibleColumns)
                        {
                            var cell = row.Cells.FirstOrDefault(c => c.ColumnKey == col.Key);
                            <div class="@GetCellBoxClassWithAlignment(col, rowIndex)"
                                title="@cell?.Value"
                                 @onclick="async () => { await RowClick(row, col); }">
                                @TrimCellValue(cell)
                            </div>
                        }

                        <div class="@GetCellBoxClass(rowIndex, "text-right")">
                            @if (row.HasContextActions)
                            {
                                <div class="w-full flex items-center justify-end">
                                    @if (TableRowContextMenuDisplayStyle == TableRowContextMenuDisplayStyle.Icons)
                                    {
                                        <div id="@row.ContextMenuId" data-context-menu-id="@row.ContextMenuId" class="flex items-center gap-1">
                                            @foreach (var rowContextMenuButton in row.ContextActions)
                                            {
                                                <MaviButtonIcon Icon="@rowContextMenuButton.Icon"
                                                                ElementVariant="rowContextMenuButton.ElementVariant"
                                                                ThemeColorScheme="rowContextMenuButton.ThemeColorScheme"
                                                                ElementSize="rowContextMenuButton.ElementSize"
                                                                Disabled="@rowContextMenuButton.Disabled"
                                                                OnClick="async (e) => { await RowContextMenuItemClick(e, row, rowContextMenuButton); }"
                                                                Title="@rowContextMenuButton.Title" />
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div id="@row.ContextMenuId" data-context-menu-id="@row.ContextMenuId" class="relative">
                                            <!-- Btn Toggle Context Menu Dropdown -->
                                            <MaviButtonIcon Icon="lni lni-menu-meatballs-1"
                                                            ElementVariant="ElementVariant.Text"
                                                            ThemeColorScheme="ThemeColorScheme.Default"
                                                            ElementSize="ElementSize.Small"
                                                            OnClick="(e) => { ToggleRowContextMenuDropDown(row, e); }"
                                                            Title="@Parameters?.ContentMenuTitle" />

                                            <!-- Row Context Menu Dropdown -->
                                            <div class="@GetRowContextMenuCss(row, rowIndex)" style="@GetRowContextMenuStyle(row)">
                                                @foreach (var rowContextMenuButton in row.ContextActions)
                                                {
                                                    <button class="@Tailwind.Theme.Typography.BODY_MEDIUM @Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT @Tailwind.Theme.Colors.Background.Hover.THEME_DEFAULT_TWO_BG_HOVER block w-full px-4 py-2.5 text-left rounded-md transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                                                            disabled="@rowContextMenuButton?.Disabled"
                                                            @onclick="async (e) => { await RowContextMenuItemClick(e, row, rowContextMenuButton); }">
                                                        @rowContextMenuButton?.Title
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            @* ── Footer row – always spans every column ── *@
            <div id="@($"pagination-{Id}")" class="col-span-full" @onclick:stopPropagation="true">
                <div class="@GetFooterRowCss()">
                    <div class="flex items-center gap-2">
                        <span class="@GetPaginationTextCss()">@Parameters?.RowsPerPageText</span>
                        <select id="@($"select-row-number-{Id}")"
                                class="@GetCountPerPageSelectCss()"
                                @onchange="UpdatePageSize"
                                @onclick:stopPropagation="true"
                                title="@Parameters?.SelectNumberOfRowsToDisplayText">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>

                    <div class="flex items-center gap-3">
                        @if (Collection is { FilteredRows.Count: > 0 })
                        {
                            <div class="rounded-full p-1 @Tailwind.Theme.Colors.Background.Hover.THEME_DEFAULT_TWO_BG_HOVER @Tailwind.Theme.Colors.Background.Active.THEME_DEFAULT_THREE_BG_ACTIVE">
                                <MaviIconOnline IconOnlineType="IconOnlineType.ChevronLeftOnline"
                                                IconColor="ElementColor.DimGrey"
                                                IconSize="GetIconSize()"
                                                OnClick="PrevPage"/>
                            </div>
                            <span class="@GetPaginationTextCss()">
                                @Collection?.FirstRowIndex–@Collection?.LastRowIndex of @Collection?.TotalRows
                            </span>
                            <div class="rounded-full p-1 @Tailwind.Theme.Colors.Background.Hover.THEME_DEFAULT_TWO_BG_HOVER @Tailwind.Theme.Colors.Background.Active.THEME_DEFAULT_THREE_BG_ACTIVE">
                                <MaviIconOnline IconOnlineType="IconOnlineType.ChevronRightOnline"
                                                IconColor="ElementColor.DimGrey"
                                                IconSize="GetIconSize()"
                                                OnClick="NextPage"/>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (NoDataContent != null)
        {
            @NoDataContent
        }
        else
        {
            <div class="w-full min-h-40 flex items-center justify-center">
                <div class="@Tailwind.Theme.Typography.BODY_LARGE @Tailwind.Theme.Colors.Text.THEME_DEFAULT_SEVEN_TEXT">@Parameters?.NoDataAvailableTitle</div>
            </div>
        }
    }
</div>

@code {
    private int VisibleColumnsCount => VisibleColumns.Count() + 1;

    private MaviBackdrop? _maviBackdrop;
    private bool _backdropInitialState = true;

    private string? _cellSpacing;
    private string? _contextTextSize;
    private IconSize? _iconSize;
    private string? _countPerPageDropdownCss;
    private string? _contextMenuCellCss;
    private string? _footerRowCss;
    private string? _searchInputCss;

    private string GetCellBoxClassWithAlignment(MaviTableColumn column, int rowIndex)
    {
        var cellText = column.IsNavigational ? "cursor-pointer font-semibold" : string.Empty;

        return $"{GetCellBoxClass(rowIndex, GetCellContentAlignment(column))} {cellText}";
    }

    private string GetCellBoxClass(int rowIndex, string textAlignment)
    {
        var backgroundColor = Parameters?.Striped == true ? rowIndex % 2 == 0 ? "bg-white" : "bg-zinc-50" : "bg-white";

        return $"{backgroundColor} {textAlignment} {GetCellSpacing()} text-zinc-800 truncate flex items-center group-hover:bg-zinc-100";
    }

    private string GetCellContentAlignment(MaviTableColumn column)
    {
        switch (column.HorizontalTextAlignment)
        {
            case HorizontalPosition.Left:
                return "justify-start";
            case HorizontalPosition.Center:
                return "justify-center";
            case HorizontalPosition.Right:
                return "justify-end";
            default:
                return "justify-start";
        }
    }

    private string GetColumnHeaderCss(MaviTableColumn column)
    {

        return $"{Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT} flex items-center {GetColumnHeaderHorizontalAlignmentCss(column)}";
    }

    private string GetColumnHeaderHorizontalAlignmentCss(MaviTableColumn column)
    {
        switch (column.HorizontalTextAlignment)
        {
            case HorizontalPosition.Left:
                return "justify-start";
            case HorizontalPosition.Center:
                return "justify-center";
            case HorizontalPosition.Right:
                return "justify-end";
            default:
                return "justify-start";
        }
    }

    private string GetMainContextMenuCss()
    {
        return ContextMenuVisible ? ContextMenuDropDownCss : "hidden";
    }

    protected override void ToggleMainContextMenuDropDown(MouseClickEventArgs mouseEventArgs)
    {
        ContextMenuVisible = !ContextMenuVisible;
        if (ContextMenuVisible)
            MainMenuDropdownPositionStyle = $"top:{mouseEventArgs.ClientY + 8}px;left:{mouseEventArgs.ClientX - 248}px;";
    }

    protected override void ToggleRowContextMenuDropDown(MaviTableRow row, MouseClickEventArgs mouseEventArgs)
    {
        row.ContextMenuVisible = !row.ContextMenuVisible;
        if (row.ContextMenuVisible)
            ActiveRowMenuDropdownPositionStyle = $"top:{mouseEventArgs.ClientY + 8}px;left:{mouseEventArgs.ClientX - 248}px;";
    }

    // Replace absolute right-0 → fixed, raise z-index
    private string ContextMenuDropDownCss
    {
        get
        {
            field ??= Tailwind.Theme.Colors.Background.THEME_DEFAULT_ONE_BG + " " +
                      Tailwind.Theme.Colors.Border.THEME_DEFAULT_THREE_BORDER +
                      " fixed w-64 border rounded-lg shadow-lg z-[9999] p-2";

            return field;
        }
    }

    protected string MainMenuDropdownPositionStyle = string.Empty;
    protected string ActiveRowMenuDropdownPositionStyle = string.Empty;

    private string GetMainContextMenuStyle() => MainMenuDropdownPositionStyle;
    private string GetRowContextMenuStyle(MaviTableRow? row) =>
        row is { ContextMenuVisible: true } ? ActiveRowMenuDropdownPositionStyle : string.Empty;

    // Simplify — remove the bottom-full hack entirely
    private string GetRowContextMenuCss(MaviTableRow? row, int rowIndex)
        => row is { ContextMenuVisible: true } ? ContextMenuDropDownCss : "hidden";

    private string GetColumnHeaderContainerCss(MaviTableColumn column)
    {
        return $"{GetCellSpacing()} truncate flex items-center {GetCellContentAlignment(column)}";
    }

    private string GetCellSpacing()
    {
        if (string.IsNullOrWhiteSpace(_cellSpacing))
        {
            _cellSpacing = Parameters?.Condensed == true ? "px-2 py-1.5" : "px-4 py-3";
        }

        return _cellSpacing;
    }

    private IconSize GetIconSize()
    {
        _iconSize ??= Parameters?.Condensed == true ? IconSize.ExtraSmall : IconSize.Small;

        return _iconSize.Value;
    }

    private string GetContextTextSize()
    {
        if (string.IsNullOrWhiteSpace(_contextTextSize))
        {
            _contextTextSize = Parameters?.Condensed == true ? Tailwind.Theme.Typography.BODY_SMALL : Tailwind.Theme.Typography.BODY_MEDIUM;
        }

        return _contextTextSize;
    }

    private string GetPaginationTextCss()
    {
        return GetContextTextSize() + " " + Tailwind.Theme.Colors.Text.THEME_DEFAULT_EIGHT_TEXT;
    }

    private string GetCountPerPageSelectCss()
    {
        // "@Tailwind.Theme.Typography.BODY_MEDIUM @Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT @Tailwind.Theme.Colors.Background.THEME_DEFAULT_ONE_BG @Tailwind.Theme.Colors.Border.THEME_DEFAULT_THREE_BORDER border rounded-md px-2 py-1 cursor-pointer focus:outline-none focus:ring-2 @Tailwind.Theme.Colors.Ring.Focus.THEME_PRIMARY_SIX_RING_FOCUS transition-shadow w-[70px]"

        if (string.IsNullOrWhiteSpace(_countPerPageDropdownCss))
        {
            _countPerPageDropdownCss = GetContextTextSize() + " " +
                                       Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT + " " +
                                       Tailwind.Theme.Colors.Background.THEME_DEFAULT_ONE_BG + " " +
                                       Tailwind.Theme.Colors.Border.THEME_DEFAULT_THREE_BORDER + " " +
                                       Tailwind.Theme.Colors.Ring.Focus.THEME_PRIMARY_SIX_RING_FOCUS + " " +
                                       "border rounded-md px-2 py-1 cursor-pointer focus:outline-none focus:ring-2 " +
                                       "transition-shadow w-[70px]";
        }


        return _countPerPageDropdownCss;
    }

    private string GetContextMenuCellCss()
    {
        if (string.IsNullOrWhiteSpace(_contextMenuCellCss))
        {
            _contextMenuCellCss = $"{GetCellSpacing()} truncate text-right";
        }
        return _contextMenuCellCss;
    }

    private string GetFooterRowCss()
    {
        if (string.IsNullOrWhiteSpace(_footerRowCss))
        {
            _footerRowCss = $"bg-white {GetCellSpacing()} flex items-center justify-between w-full min-w-80";
        }

        return _footerRowCss;
    }

    protected override async Task RefreshTable()
    {
        try
        {
            _maviBackdrop?.Display();
            await base.RefreshTable();
        }
        catch(Exception ex)
        {
            Logger?.Error(ex, "An error occurred while refreshing the table.");
        }
        finally
        {
            _maviBackdrop?.Hide();
            _backdropInitialState = false;
        }
    }

    private string GetSearchInputCss()
    {
        if (string.IsNullOrWhiteSpace(_searchInputCss))
        {
            _searchInputCss = Tailwind.Theme.Typography.BODY_SMALL + " " +
                              Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT + " " +
                              Tailwind.Theme.Colors.Border.THEME_DEFAULT_THREE_BORDER + " " +
                              Tailwind.Theme.Colors.Ring.Focus.THEME_PRIMARY_SIX_RING_FOCUS + 
                              " bg-white border px-2 py-1 w-full focus:outline-none focus:ring-2 placeholder:text-(--theme-default-five)";
        }

        return _searchInputCss;
    }
}
