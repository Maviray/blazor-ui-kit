@using Maviray.Blazor.Components.Material.Constants
@inherits MaviComponentBase

<div id="@Id" class="@ContainerCss()">
    <div class="@TitleCss()">@Title</div>
    <div class="p-4">
        @ChildContent
    </div>
</div>

@code {
    private string? _containerCss;
    private string? _titleCss;

    [Parameter]
    public string? Width { get; set; } = "w-96";

    [Parameter]
    public ElementVariant ElementVariant { get; set; }

    [Parameter]
    public ThemeColorScheme ThemeColorScheme { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ContainerCss()
    {
        if (!string.IsNullOrWhiteSpace(_containerCss)) return _containerCss;

        var classes = new List<string?>
        {
            "rounded-sm mb-3 overflow-hidden",
            Width,
            ContainerBackgroundColorCss(),
            TextColor()
        };

        if (ElementVariant == ElementVariant.Outlined || ElementVariant == ElementVariant.Text)
        {
            classes.Add("border");
        }

        if (ElementVariant == ElementVariant.Text)
        {
            classes.Add(Tailwind.Theme.Colors.Border.THEME_LIGHT_TWO_BORDER);
        }

        _containerCss = string.Join(" ", classes);

        return _containerCss;
    }

    private string TitleCss()
    {
        if (!string.IsNullOrWhiteSpace(_titleCss)) return _titleCss;

        var classes = new List<string?>
        {
            "p-4",
            TitleBackgroundColorCss()
        };

        if (ElementVariant == ElementVariant.Outlined || ElementVariant == ElementVariant.Text)
        {
            classes.Add("border-b");
        }

        if (ElementVariant == ElementVariant.Text)
        {
            classes.Add(Tailwind.Theme.Colors.Border.THEME_LIGHT_TWO_BORDER);
        }

        _titleCss = string.Join(" ", classes);

        return _titleCss;
    }

    private string ContainerBackgroundColorCss()
    {
        if (ElementVariant == ElementVariant.Outlined || ElementVariant == ElementVariant.Text)
        {
            return Tailwind.Theme.Colors.Background.THEME_LIGHT_ONE_BG;
        }

        return ThemeColorScheme switch
        {
            ThemeColorScheme.Default => Tailwind.Theme.Colors.Background.THEME_DEFAULT_SIX_BG,
            ThemeColorScheme.Primary => Tailwind.Theme.Colors.Background.THEME_PRIMARY_SIX_BG,
            ThemeColorScheme.Secondary => Tailwind.Theme.Colors.Background.THEME_SECONDARY_SIX_BG,
            ThemeColorScheme.Success => Tailwind.Theme.Colors.Background.THEME_SUCCESS_SIX_BG,
            ThemeColorScheme.Alert => Tailwind.Theme.Colors.Background.THEME_ALERT_SIX_BG,
            ThemeColorScheme.Warning => Tailwind.Theme.Colors.Background.THEME_WARNING_SIX_BG,
            ThemeColorScheme.Info => Tailwind.Theme.Colors.Background.THEME_INFO_SIX_BG,
            ThemeColorScheme.Dark => Tailwind.Theme.Colors.Background.THEME_DARK_SIX_BG,
            ThemeColorScheme.Light => Tailwind.Theme.Colors.Background.THEME_LIGHT_TWO_BG,
            _ => Tailwind.Theme.Colors.Background.THEME_DEFAULT_SIX_BG
        };
    }

    private string TitleBackgroundColorCss()
    {
        if (ElementVariant == ElementVariant.Outlined)
        {
            return Tailwind.Theme.Colors.Background.THEME_LIGHT_TWO_BG;
        }

        if (ElementVariant == ElementVariant.Text)
        {
            return ThemeColorScheme switch
            {
                ThemeColorScheme.Default => Tailwind.Theme.Colors.Background.THEME_DEFAULT_ONE_BG,
                ThemeColorScheme.Primary => Tailwind.Theme.Colors.Background.THEME_PRIMARY_ONE_BG,
                ThemeColorScheme.Secondary => Tailwind.Theme.Colors.Background.THEME_SECONDARY_ONE_BG,
                ThemeColorScheme.Success => Tailwind.Theme.Colors.Background.THEME_SUCCESS_ONE_BG,
                ThemeColorScheme.Alert => Tailwind.Theme.Colors.Background.THEME_ALERT_ONE_BG,
                ThemeColorScheme.Warning => Tailwind.Theme.Colors.Background.THEME_WARNING_ONE_BG,
                ThemeColorScheme.Info => Tailwind.Theme.Colors.Background.THEME_INFO_ONE_BG,
                ThemeColorScheme.Dark => Tailwind.Theme.Colors.Background.THEME_DARK_ONE_BG,
                ThemeColorScheme.Light => Tailwind.Theme.Colors.Background.THEME_LIGHT_ONE_BG,
                _ => Tailwind.Theme.Colors.Background.THEME_DEFAULT_ONE_BG
            };
        }

        return ThemeColorScheme switch
        {
            ThemeColorScheme.Default => Tailwind.Theme.Colors.Background.THEME_DEFAULT_SEVEN_BG,
            ThemeColorScheme.Primary => Tailwind.Theme.Colors.Background.THEME_PRIMARY_SEVEN_BG,
            ThemeColorScheme.Secondary => Tailwind.Theme.Colors.Background.THEME_SECONDARY_SEVEN_BG,
            ThemeColorScheme.Success => Tailwind.Theme.Colors.Background.THEME_SUCCESS_SEVEN_BG,
            ThemeColorScheme.Alert => Tailwind.Theme.Colors.Background.THEME_ALERT_SEVEN_BG,
            ThemeColorScheme.Warning => Tailwind.Theme.Colors.Background.THEME_WARNING_SEVEN_BG,
            ThemeColorScheme.Info => Tailwind.Theme.Colors.Background.THEME_INFO_SEVEN_BG,
            ThemeColorScheme.Dark => Tailwind.Theme.Colors.Background.THEME_DARK_SEVEN_BG,
            ThemeColorScheme.Light => Tailwind.Theme.Colors.Background.THEME_LIGHT_FOUR_BG,
            _ => Tailwind.Theme.Colors.Background.THEME_DEFAULT_SEVEN_BG
        };
    }

    private string TextColor()
    {
        if (ElementVariant == ElementVariant.Filled)
        {
            if (ThemeColorScheme == ThemeColorScheme.Light)
            {
                return Tailwind.Theme.Colors.Text.THEME_DEFAULT_TEN_TEXT;
            }

            return Tailwind.Theme.Colors.Text.THEME_DEFAULT_ONE_TEXT;
        }

        switch (ThemeColorScheme)
        {
            case ThemeColorScheme.Default:
                return Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT;
            case ThemeColorScheme.Primary:
                return Tailwind.Theme.Colors.Text.THEME_PRIMARY_NINE_TEXT;
            case ThemeColorScheme.Secondary:
                return Tailwind.Theme.Colors.Text.THEME_SECONDARY_NINE_TEXT;
            case ThemeColorScheme.Success:
                return Tailwind.Theme.Colors.Text.THEME_SUCCESS_NINE_TEXT;
            case ThemeColorScheme.Alert:
                return Tailwind.Theme.Colors.Text.THEME_ALERT_NINE_TEXT;
            case ThemeColorScheme.Warning:
                return Tailwind.Theme.Colors.Text.THEME_WARNING_NINE_TEXT;
            case ThemeColorScheme.Info:
                return Tailwind.Theme.Colors.Text.THEME_INFO_NINE_TEXT;
            case ThemeColorScheme.Dark:
                return Tailwind.Theme.Colors.Text.THEME_DARK_NINE_TEXT;
            case ThemeColorScheme.Light:
                return Tailwind.Theme.Colors.Text.THEME_LIGHT_NINE_TEXT;
            default:
                return Tailwind.Theme.Colors.Text.THEME_DEFAULT_NINE_TEXT;
        }
    }

}