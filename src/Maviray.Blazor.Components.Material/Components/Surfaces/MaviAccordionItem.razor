@inherits MaviComponentBase

<div id="@Id" class="@ItemFrameClass">
    <h3 class="m-0">
        <button type="button"
                class="@SummaryButtonClass"
                @onclick="OnToggle"
                aria-expanded="@IsExpanded"
                aria-controls="@PanelId"
                id="@HeaderId"
                disabled="@Disabled">

            <span class="min-w-0 flex-1 text-left">
                @if (Summary is not null)
                {
                    @Summary
                }
                else
                {
                    <span class="block truncate font-medium">@Title</span>
                    @if (!string.IsNullOrWhiteSpace(SubTitle))
                    {
                        <span class="block truncate text-sm opacity-80">@SubTitle</span>
                    }
                }
            </span>

            <span class="@IconClass" aria-hidden="true">
                <svg class="@ChevronClass" viewBox="0 0 24 24" fill="none">
                    <path d="M8 10l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
        </button>
    </h3>

    @if (IsExpanded)
    {
        <div id="@PanelId"
             role="region"
             aria-labelledby="@HeaderId"
             class="@ExpandedDetailsClass">

            <div class="@DetailsInnerClass">
                @ChildContent
            </div>
        </div>
    }
</div>

@code {

    [CascadingParameter]
    internal MaviAccordion? Owner { get; set; }

    [Parameter]
    public string? SubTitle { get; set; }

    /// <summary>Custom summary markup instead of Title/SubTitle.</summary>
    [Parameter]
    public RenderFragment? Summary { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>If true, item starts expanded on first render.</summary>
    [Parameter]
    public bool DefaultExpanded { get; set; }

    /// <summary>Optional callback when toggled (fires after state changes).</summary>
    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>Item position (set by parent helper in markup if you want rounded stack).</summary>
    [Parameter]
    public bool IsFirst { get; set; }

    [Parameter]
    public bool IsLast { get; set; }

    private string PanelId => $"acc-panel-{Id}";
    private string HeaderId => $"acc-header-{Id}";

    protected override void OnInitialized()
    {
        if (Owner is null)
            throw new InvalidOperationException($"{nameof(MaviAccordionItem)} must be used inside {nameof(MaviAccordion)}.");

        Owner.RegisterDefaultOpen(Id, DefaultExpanded);
    }

    private bool IsExpanded => Owner?.IsOpen(Id) ?? false;

    private async Task OnToggle()
    {
        if (Disabled || Owner is null) return;

        Owner.Toggle(Id);

        if (ExpandedChanged.HasDelegate)
            await ExpandedChanged.InvokeAsync(IsExpanded);
    }

    private string ItemFrameClass
        => Owner?.GetItemFrameClasses(IsFirst, IsLast) ?? "overflow-hidden";

    private string SummaryButtonClass
    {
        get
        {
            var tokens = Owner?.GetSchemeTokens()
                         ?? ("bg-[var(--theme-default-one)]", "hover:bg-[var(--theme-default-two)]", "text-[var(--theme-default-ten)]",
                             "border-[var(--theme-default-four)]", "bg-[var(--theme-default-one)]", "text-[var(--theme-default-eight)]",
                             "focus-visible:ring-[var(--theme-default-six)]");

            var disabled = Disabled
                ? "opacity-50 cursor-not-allowed"
                : "cursor-pointer";

            // Material-ish spacing + interaction states
            return string.Join(" ", new[]
            {
                "w-full",
                "flex items-center gap-3",
                "px-4 py-3",
                "select-none",
                tokens.summaryBg,
                !Disabled ? tokens.summaryHoverBg : "",
                tokens.summaryText,
                "transition-colors",
                "focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-transparent",
                tokens.focusRing,
                disabled
            }.Where(s => !string.IsNullOrWhiteSpace(s)));
        }
    }

    private string IconClass
    {
        get
        {
            var tokens = Owner?.GetSchemeTokens()
                         ?? ("", "", "", "", "", "text-[var(--theme-default-eight)]", "");

            var backgroundOnHover = Owner?.GetBackgroundOnHoverClass();
            var backgroundActive = Owner?.GetBackgroundActiveClass();
            return string.Join(" ", new[]
            {
                "shrink-0",
                "rounded-full",
                backgroundOnHover,
                backgroundActive,
                tokens.iconText,
                "transition-transform"
            });
        }
    }

    private string ChevronClass
        => string.Join(" ", new[]
        {
            "h-5 w-5",
            "transition-transform duration-200",
            IsExpanded ? "rotate-180" : "rotate-0"
        });

    // Smooth expand/collapse without JS: grid-rows trick.
    private string DetailsContainerClass
    {
        get
        {
            var tokens = Owner?.GetSchemeTokens()
                         ?? ("", "", "", "", "bg-[var(--theme-default-one)]", "", "");

            return string.Join(" ", new[]
            {
                "grid",
                "transition-[grid-template-rows] duration-200 ease-out",
                IsExpanded ? "grid-rows-[1fr]" : "grid-rows-[0fr]",
                tokens.detailsBg,
                "border-t",
                Owner is not null ? tokens.border : "border-[var(--theme-default-four)]"
            });
        }
    }

    private string DetailsInnerClass
        => string.Join(" ", new[]
        {
            "min-h-0 overflow-hidden", // required for grid row animation
            "px-4 py-3",
            "text-sm leading-6"
        });

    private string ExpandedDetailsClass
    {
        get
        {
            var tokens = Owner?.GetSchemeTokens()
                         ?? ("", "", "", "", "bg-[var(--theme-default-one)]", "", "");

            return string.Join(" ", new[]
            {
                tokens.detailsBg,
                "border-t",
                Owner is not null ? tokens.border : "border-[var(--theme-default-four)]"
            }.Where(s => !string.IsNullOrWhiteSpace(s)));
        }
    }

}