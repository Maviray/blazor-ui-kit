<CascadingValue Value="this" IsFixed="true">
    <div class="@RootClass" role="presentation">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Single (Material default) or multiple expanded items.</summary>
    [Parameter] public bool AllowMultiple { get; set; } = false;

    /// <summary>Show thin dividers between items.</summary>
    [Parameter] public bool Dividers { get; set; } = true;

    [Parameter] public ThemeColorScheme ColorScheme { get; set; } = ThemeColorScheme.Default;

    /// <summary>Optional additional classes for the root container.</summary>
    [Parameter] public string? Class { get; set; }

    private readonly HashSet<string> _open = new(StringComparer.Ordinal);

    internal bool IsOpen(string id) => _open.Contains(id);

    internal void RegisterDefaultOpen(string id, bool defaultExpanded)
    {
        if (defaultExpanded) _open.Add(id);
    }

    internal void Toggle(string id)
    {
        if (AllowMultiple)
        {
            if (!_open.Add(id)) _open.Remove(id);
        }
        else
        {
            if (_open.Contains(id)) _open.Clear();
            else
            {
                _open.Clear();
                _open.Add(id);
            }
        }

        StateHasChanged();
    }

    internal string GetItemFrameClasses(bool isFirst, bool isLast)
    {
        // Material-ish: subtle rounding on the whole stack
        var rounding = (isFirst, isLast) switch
        {
            (true, true) => "rounded-xl",
            (true, false) => "rounded-t-xl",
            (false, true) => "rounded-b-xl",
            _ => "rounded-none"
        };

        var border = Dividers ? $"border-b {GetDividerBorderClass()}" : "";
        if (isLast) border = ""; // no divider on last

        return $"overflow-hidden {rounding} {border}";
    }

    internal (string summaryBg, string summaryHoverBg, string summaryText, string border, string detailsBg, string iconText, string focusRing)
        GetSchemeTokens()
        => ColorScheme switch
        {
            ThemeColorScheme.Primary => (
                "bg-[var(--theme-primary-one)]",
                "hover:bg-[var(--theme-primary-two)]",
                "text-[var(--theme-primary-ten)]",
                "border-[var(--theme-primary-three)]",
                "bg-[var(--theme-primary-one)]",
                "text-[var(--theme-primary-eight)]",
                "focus-visible:ring-[var(--theme-primary-six)]"
            ),
            ThemeColorScheme.Secondary => (
                "bg-[var(--theme-secondary-one)]",
                "hover:bg-[var(--theme-secondary-two)]",
                "text-[var(--theme-secondary-ten)]",
                "border-[var(--theme-secondary-three)]",
                "bg-[var(--theme-secondary-one)]",
                "text-[var(--theme-secondary-eight)]",
                "focus-visible:ring-[var(--theme-secondary-six)]"
            ),
            ThemeColorScheme.Success => (
                "bg-[var(--theme-success-one)]",
                "hover:bg-[var(--theme-success-two)]",
                "text-[var(--theme-success-ten)]",
                "border-[var(--theme-success-three)]",
                "bg-[var(--theme-success-one)]",
                "text-[var(--theme-success-eight)]",
                "focus-visible:ring-[var(--theme-success-six)]"
            ),
            ThemeColorScheme.Alert => (
                "bg-[var(--theme-alert-one)]",
                "hover:bg-[var(--theme-alert-two)]",
                "text-[var(--theme-alert-ten)]",
                "border-[var(--theme-alert-three)]",
                "bg-[var(--theme-alert-one)]",
                "text-[var(--theme-alert-eight)]",
                "focus-visible:ring-[var(--theme-alert-six)]"
            ),
            ThemeColorScheme.Warning => (
                "bg-[var(--theme-warning-one)]",
                "hover:bg-[var(--theme-warning-two)]",
                "text-[var(--theme-warning-ten)]",
                "border-[var(--theme-warning-three)]",
                "bg-[var(--theme-warning-one)]",
                "text-[var(--theme-warning-nine)]",
                "focus-visible:ring-[var(--theme-warning-six)]"
            ),
            ThemeColorScheme.Info => (
                "bg-[var(--theme-info-one)]",
                "hover:bg-[var(--theme-info-two)]",
                "text-[var(--theme-info-ten)]",
                "border-[var(--theme-info-three)]",
                "bg-[var(--theme-info-one)]",
                "text-[var(--theme-info-eight)]",
                "focus-visible:ring-[var(--theme-info-six)]"
            ),
            ThemeColorScheme.Dark => (
                "bg-[var(--theme-dark-eight)]",
                "hover:bg-[var(--theme-dark-seven)]",
                "text-[var(--theme-dark-one)]",
                "border-[var(--theme-dark-six)]",
                "bg-[var(--theme-dark-eight)]",
                "text-[var(--theme-dark-two)]",
                "focus-visible:ring-[var(--theme-dark-four)]"
            ),
            ThemeColorScheme.Light => (
                "bg-[var(--theme-light-one)]",
                "hover:bg-[var(--theme-light-two)]",
                "text-[var(--theme-light-ten)]",
                "border-[var(--theme-light-four)]",
                "bg-[var(--theme-light-one)]",
                "text-[var(--theme-light-eight)]",
                "focus-visible:ring-[var(--theme-light-six)]"
            ),
            _ => ( // Default
                "bg-[var(--theme-default-one)]",
                "hover:bg-[var(--theme-default-two)]",
                "text-[var(--theme-default-ten)]",
                "border-[var(--theme-default-four)]",
                "bg-[var(--theme-default-one)]",
                "text-[var(--theme-default-eight)]",
                "focus-visible:ring-[var(--theme-default-six)]"
            )
        };

    private string GetDividerBorderClass()
        => ColorScheme switch
        {
            ThemeColorScheme.Primary => "border-[var(--theme-primary-three)]",
            ThemeColorScheme.Secondary => "border-[var(--theme-secondary-three)]",
            ThemeColorScheme.Success => "border-[var(--theme-success-three)]",
            ThemeColorScheme.Alert => "border-[var(--theme-alert-three)]",
            ThemeColorScheme.Warning => "border-[var(--theme-warning-three)]",
            ThemeColorScheme.Info => "border-[var(--theme-info-three)]",
            ThemeColorScheme.Dark => "border-[var(--theme-dark-six)]",
            ThemeColorScheme.Light => "border-[var(--theme-light-four)]",
            _ => "border-[var(--theme-default-four)]"
        };

    private string RootClass
        => string.Join(" ", new[]
        {
            "w-full",
            "rounded-xl",
            "border",
            GetDividerBorderClass(),
            "shadow-sm",                  // Material-ish elevation 1
            "overflow-hidden",
            Class
        }.Where(s => !string.IsNullOrWhiteSpace(s)));

    internal string GetBackgroundOnHoverClass()
        => ColorScheme switch
        {
            ThemeColorScheme.Primary => "hover:bg-[var(--theme-primary-three)]",
            ThemeColorScheme.Secondary => "hover:bg-[var(--theme-secondary-three)]",
            ThemeColorScheme.Success => "hover:bg-[var(--theme-success-three)]",
            ThemeColorScheme.Alert => "hover:bg-[var(--theme-alert-three)]",
            ThemeColorScheme.Warning => "hover:bg-[var(--theme-warning-three)]",
            ThemeColorScheme.Info => "hover:bg-[var(--theme-info-three)]",
            ThemeColorScheme.Dark => "hover:bg-[var(--theme-dark-five)]",
            ThemeColorScheme.Light => "hover:bg-[var(--theme-light-four)]",
            _ => "hover:bg-[var(--theme-default-four)]"
        };

    internal string GetBackgroundActiveClass()
        => ColorScheme switch
        {
            ThemeColorScheme.Primary => "active:bg-[var(--theme-primary-four)]",
            ThemeColorScheme.Secondary => "active:bg-[var(--theme-secondary-four)]",
            ThemeColorScheme.Success => "active:bg-[var(--theme-success-four)]",
            ThemeColorScheme.Alert => "active:bg-[var(--theme-alert-four)]",
            ThemeColorScheme.Warning => "active:bg-[var(--theme-warning-four)]",
            ThemeColorScheme.Info => "active:bg-[var(--theme-info-four)]",
            ThemeColorScheme.Dark => "active:bg-[var(--theme-dark-four)]",
            ThemeColorScheme.Light => "active:bg-[var(--theme-light-five)]",
            _ => "active:bg-[var(--theme-default-five)]"
        };
}