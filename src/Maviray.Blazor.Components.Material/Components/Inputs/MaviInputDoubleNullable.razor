@using System.ComponentModel.DataAnnotations
@using System.Diagnostics.CodeAnalysis
@using System.Globalization
@using System.Reflection
@using Microsoft.Extensions.Logging
@inherits MaviNumericInputBase<double?>

<div class="@Width">
    <!-- Floating Label Input Container -->
    <div class="@GetContainerClass()">
        <!-- Input Field -->
        <input value="@GetDisplayValue()"
               @oninput="HandleInput"
               @onchange="HandleChange"
               @onfocus="OnFocus"
               @onblur="OnBlur"
               type="@GetInputType()"
               inputmode="@GetInputMode()"
               id="@Id"
               min="@Min"
               max="@Max"
               step="@Step"
               disabled="@Disabled"
               readonly="@Readonly"
               class="@BuildInputClass()"
               style="@Style"
               title="@GetTitle()"
               aria-describedby="@GetAriaDescribedByString()"
               aria-invalid="@GetAreaInvalidValue()"
               aria-label="@Label"
               aria-required="@Required.ToString().ToLowerInvariant()"
               data-val="@(!Disabled && !Readonly ? "true" : "false")"
               @attributes="AdditionalAttributes"/>

        <!-- Floating Label -->
        @if (!string.IsNullOrEmpty(Label))
        {
            <label for="@Id"
                   class="@BuildLabelClass()"
                   title="@Title">
                @Label
                @if (Required && !Disabled && !Readonly)
                {
                    <span class="@BuildRequiredAsteriskClass()">*</span>
                }
            </label>
        }

        <!-- Start Icon -->
        @if (!string.IsNullOrEmpty(StartIcon))
        {
            <div class="@GetStartIconClass()">
                <i class="@StartIcon text-xl"></i>
            </div>
        }

        <!-- End Icon (Clickable) or Loading Spinner -->
        @if (!string.IsNullOrEmpty(EndIcon))
        {
            @if (IsEndIconLoading)
            {
                <!-- Loading Spinner -->
                <div class="@GetEndIconLoadingClass()"
                     aria-label="Loading"
                     role="status">
                    <div class="animate-spin rounded-full border-2 border-solid border-current border-r-transparent"
                         style="@GetLoadingSpinnerSize()">
                    </div>
                </div>
            }
            else
            {
                <!-- End Icon Button -->
                <button type="button"
                        class="@GetEndIconClass()"
                        @onclick="HandleEndIconClick"
                        disabled="@(Disabled || EndIconDisabled)"
                        title="@ButtonLabel"
                        aria-label="@ButtonLabel"
                        tabindex="-1">
                    <i class="@EndIcon text-xl"></i>
                </button>
            }
        }

        <!-- Fieldset for Outlined Border -->
        <fieldset aria-hidden="true" class="@BuildFieldsetClass()">
            <legend class="@BuildLegendClass()">
                <span class="@(string.IsNullOrEmpty(Label) || Disabled || Readonly ? "" : "px-2")">@Label@(Required && !Disabled && !Readonly ? " *" : "")</span>
            </legend>
        </fieldset>
    </div>

    <!-- Helper Text -->
    @if (DisplayHelperText && !string.IsNullOrEmpty(HelperText))
    {
        <div class="mt-1.5 px-3.5 text-xs leading-tight text-black/60" id="@($"{Id}-helper")">
            @HelperText
        </div>
    }
</div>

@code {

    /// <summary>
    ///     Minimum allowed value for the double input.
    /// </summary>
    [Parameter]
    public double? Min { get; set; }

    /// <summary>
    ///     Maximum allowed value for the double input.
    /// </summary>
    [Parameter]
    public double? Max { get; set; }

    /// <summary>
    ///     Step value for increment/decrement operations.
    /// </summary>
    [Parameter]
    public double Step { get; set; } = 0.01;

    /// <summary>
    ///     Number of decimal places to use when parsing input. Default is null (allows any precision).
    ///     When set, restricts the input to the specified number of decimal places.
    /// </summary>
    [Parameter]
    public int? DecimalPlaces { get; set; }

    /// <summary>
    ///     When true, allows scientific notation input (e.g., 1.23e+10).
    ///     Default is false.
    /// </summary>
    [Parameter]
    public bool AllowScientificNotation { get; set; }

    protected override bool HasValue => CurrentValue.HasValue || !string.IsNullOrWhiteSpace(RawInputValue);

    protected override bool TryParseValueFromString(
        string? value,
        out double? result,
        [NotNullWhen(false)]
        out string? validationErrorMessage)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            validationErrorMessage = null;
            return true;
        }

        // Remove formatting characters for parsing
        var cleanValue = CleanValueForParsing(value);

        // Determine number styles based on configuration
        var numberStyles = NumberStyles.Float | NumberStyles.AllowThousands;
        if (AllowScientificNotation)
        {
            numberStyles |= NumberStyles.AllowExponent;
        }

        if (double.TryParse(cleanValue, numberStyles, CurrentCulture, out var parsedValue))
        {
            // Apply decimal places restriction if specified
            if (DecimalPlaces.HasValue)
            {
                parsedValue = Math.Round(parsedValue, DecimalPlaces.Value, MidpointRounding.AwayFromZero);
            }

            // Validate range if specified
            if (Min.HasValue && parsedValue < Min.Value)
            {
                result = parsedValue;
                validationErrorMessage = $"The {Label ?? FieldIdentifier.FieldName} field must be at least {Min.Value}.";
                return false;
            }

            if (Max.HasValue && parsedValue > Max.Value)
            {
                result = parsedValue;
                validationErrorMessage = $"The {Label ?? FieldIdentifier.FieldName} field must not exceed {Max.Value}.";
                return false;
            }

            // Validate for special values
            if (double.IsNaN(parsedValue))
            {
                result = null;
                validationErrorMessage = $"The {Label ?? FieldIdentifier.FieldName} field must be a valid number.";
                return false;
            }

            if (double.IsInfinity(parsedValue))
            {
                result = null;
                validationErrorMessage = $"The {Label ?? FieldIdentifier.FieldName} field value is too large.";
                return false;
            }

            result = parsedValue;
            validationErrorMessage = null;
            return true;
        }

        result = null;
        validationErrorMessage = $"The {Label ?? FieldIdentifier.FieldName} field must be a valid decimal number.";
        return false;
    }

    protected override string? FormatValueAsString(double? value)
    {
        if (!value.HasValue)
        {
            return null;
        }

        var actualValue = value.Value;

        // Handle special values
        if (double.IsNaN(actualValue))
        {
            return "NaN";
        }

        if (double.IsPositiveInfinity(actualValue))
        {
            return "∞";
        }

        if (double.IsNegativeInfinity(actualValue))
        {
            return "-∞";
        }

        if (string.IsNullOrWhiteSpace(FormatMask))
        {
            // Default formatting with decimal places if specified
            if (DecimalPlaces.HasValue)
            {
                return actualValue.ToString($"F{DecimalPlaces.Value}", CurrentCulture);
            }

            return actualValue.ToString(CurrentCulture);
        }

        try
        {
            return actualValue.ToString(FormatMask, CurrentCulture);
        }
        catch (FormatException ex)
        {
            Logger?.LogWarning(ex, "Invalid format mask '{FormatMask}' for double value. Falling back to default format.", FormatMask);

            if (DecimalPlaces.HasValue)
            {
                return actualValue.ToString($"F{DecimalPlaces.Value}", CurrentCulture);
            }

            return actualValue.ToString(CurrentCulture);
        }
    }

    protected override string? GetDisplayValue()
    {
        // When focused and not showing formatted value, show raw input or plain number
        if (IsFocused && !ShowFormattedWhileFocused)
        {
            return RawInputValue ?? (CurrentValue.HasValue ? CurrentValue.Value.ToString(CurrentCulture) : string.Empty);
        }

        // When not focused or ShowFormattedWhileFocused is true, show formatted value
        if (!CurrentValue.HasValue && string.IsNullOrWhiteSpace(RawInputValue))
        {
            return string.Empty;
        }

        return FormatValueAsString(CurrentValue);
    }

    protected override Task HandleInput(ChangeEventArgs e)
    {
        if (Disabled || Readonly) return Task.CompletedTask;

        RawInputValue = e.Value?.ToString();

        if (TryParseValueFromString(RawInputValue, out var parsedValue, out _))
        {
            CurrentValue = parsedValue;
        }

        return Task.CompletedTask;
    }

    protected override Task HandleChange(ChangeEventArgs e)
    {
        if (Disabled || Readonly) return Task.CompletedTask;

        RawInputValue = e.Value?.ToString();
        CurrentValueAsString = RawInputValue;
        EditContext?.NotifyFieldChanged(FieldIdentifier);

        return Task.CompletedTask;
    }

    protected override string GetInputType() =>
        // For double values, always use text to support decimal separators across cultures
        // and to avoid browser inconsistencies with type="number" and decimal values
        "text";

    protected override string GetInputMode()
    {
        if (string.IsNullOrWhiteSpace(FormatMask))
        {
            return "decimal";
        }

        // Use decimal keyboard for most numeric formats
        var decimalFormats = new[] { "N", "F", "G", "C", "P", "E" };
        if (decimalFormats.Any(f => FormatMask.StartsWith(f, StringComparison.OrdinalIgnoreCase)))
        {
            return "decimal";
        }

        // Default to decimal for custom formats
        return "decimal";
    }

    protected override string? GetMinAttribute() => Min?.ToString(CurrentCulture);
    protected override string? GetMaxAttribute() => Max?.ToString(CurrentCulture);
    protected override string? GetStepAttribute() => Step.ToString(CurrentCulture);

    protected override void InferTypeSpecificAttributes(PropertyInfo propertyInfo)
    {
        var rangeAttr = propertyInfo.GetCustomAttribute<RangeAttribute>();

        if (rangeAttr == null) return;

        Min ??= Convert.ToDouble(rangeAttr.Minimum);

        Max ??= Convert.ToDouble(rangeAttr.Maximum);
    }

    private string CleanValueForParsing(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return value;

        var cleaned = value.Trim();

        // Don't clean scientific notation if allowed
        if (AllowScientificNotation && cleaned.Contains('e', StringComparison.OrdinalIgnoreCase))
        {
            // Only remove currency and percent symbols for scientific notation
            cleaned = cleaned.Replace(CurrentCulture.NumberFormat.CurrencySymbol, "");
            cleaned = cleaned.Replace(CurrentCulture.NumberFormat.PercentSymbol, "");
            return cleaned;
        }

        // Remove currency symbols
        cleaned = cleaned.Replace(CurrentCulture.NumberFormat.CurrencySymbol, "");

        // Remove percent symbols
        cleaned = cleaned.Replace(CurrentCulture.NumberFormat.PercentSymbol, "");

        // Remove group separators (thousand separators)
        cleaned = cleaned.Replace(CurrentCulture.NumberFormat.NumberGroupSeparator, "");
        cleaned = cleaned.Replace(CurrentCulture.NumberFormat.CurrencyGroupSeparator, "");

        // Remove spaces that might be used as group separators
        if (CurrentCulture.NumberFormat.NumberGroupSeparator == " " ||
            CurrentCulture.NumberFormat.CurrencyGroupSeparator == " ")
        {
            cleaned = cleaned.Replace(" ", "");
        }

        return cleaned.Trim();
    }

}