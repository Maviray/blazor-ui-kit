@inherits MaviComponentBase
@using Maviray.Blazor.Components.Core.Models
@typeparam TValue

<CascadingValue Value="Context">
    <div id="@Id" class="@CssManager.Combine(Width, "flex flex-col gap-2")">
        @ChildContent

        @if (!string.IsNullOrEmpty(HelperText))
        {
            <div class="@GetHelperTextClass()">@HelperText</div>
        }
    </div>
</CascadingValue>

@code {
    [Parameter] public override string? Id { get; set; } = $"mavi-radio-group-{Guid.NewGuid():N}";

    // Selected value for the group
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<ValueChangedCallbackParameters<TValue?>> ValueChanged { get; set; }

    // Group state
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Readonly { get; set; }

    // Group styling
    [Parameter] public ElementSize ElementSize { get; set; } = ElementSize.Regular;
    [Parameter] public ThemeColorScheme ThemeColorScheme { get; set; } = ThemeColorScheme.Default;

    // Layout / helper
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? HelperText { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Context object cascaded to all MaviRadioButton children
    private RadioGroupContext<TValue> Context => new()
    {
        GroupId = Id ?? $"mavi-radio-group-{Guid.NewGuid():N}",
        GetValue = () => Value,
        SetValueAsync = SetValueAsync,
        Disabled = Disabled,
        Readonly = Readonly,
        ElementSize = ElementSize,
        ThemeColorScheme = ThemeColorScheme
    };

    private async Task SetValueAsync(TValue? newValue)
    {
        if (Disabled || Readonly) return;

        Value = newValue;

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(new()
            {
                ElementId = Id,
                Value = Value
            });
        }
    }

    private static string GetHelperTextClass()
        => "mt-1 text-xs text-(--theme-default-seven)";
}