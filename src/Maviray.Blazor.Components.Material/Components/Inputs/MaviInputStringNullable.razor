﻿@using System.Diagnostics.CodeAnalysis
@using Maviray.Blazor.Components.Core.Constants
@using System.ComponentModel.DataAnnotations
@using System.Diagnostics.CodeAnalysis
@using System.Reflection
@inherits MaviInputBase<string?>

<div class="@Width">
    <!-- Floating Label Input Container -->
    <div class="@GetContainerClass()">
        <!-- Input Field -->
        <input value="@CurrentValue"
               @oninput="HandleInput"
               @onchange="HandleChange"
               type="@GetInputType()"
               id="@Id"
               maxlength="@MaxLength"
               disabled="@Disabled"
               readonly="@Readonly"
               class="@BuildInputClass()"
               style="@Style"
               title="@GetTitle()"
               aria-describedby="@GetAriaDescribedByString()"
               aria-invalid="@GetAreaInvalidValue()"
               aria-label="@Label"
               aria-required="@Required.ToString().ToLowerInvariant()"
               data-val="@(!Disabled && !Readonly ? "true" : "false")"
               @onfocus="OnFocus"
               @onblur="OnBlur"
               @attributes="AdditionalAttributes" />

        <!-- Floating Label -->
        @if (!string.IsNullOrEmpty(Label))
        {
            <label for="@Id"
                   class="@BuildLabelClass()"
                   title="@Title">
                @Label
                @if (Required && !Disabled && !Readonly)
                {
                    <span class="@BuildRequiredAsteriskClass()">*</span>
                }
            </label>
        }

        <!-- Start Icon -->
        @if (!string.IsNullOrEmpty(StartIcon))
        {
            <div class="@GetStartIconClass()">
                <i class="@StartIcon text-xl"></i>
            </div>
        }

        <!-- End Icon (Clickable) or Loading Spinner -->
        @if (!string.IsNullOrEmpty(EndIcon))
        {
            @if (IsEndIconLoading)
            {
                <!-- Loading Spinner -->
                <div class="@GetEndIconLoadingClass()"
                     aria-label="Loading"
                     role="status">
                    <div class="animate-spin rounded-full border-2 border-solid border-current border-r-transparent"
                         style="@GetLoadingSpinnerSize()"></div>
                </div>
            }
            else
            {
                <!-- End Icon Button -->
                <button type="button"
                        class="@GetEndIconClass()"
                        @onclick="HandleEndIconClick"
                        disabled="@(Disabled || EndIconDisabled)"
                        title="@ButtonLabel"
                        aria-label="@ButtonLabel"
                        tabindex="-1">
                    <i class="@EndIcon text-xl"></i>
                </button>
            }
        }

        <!-- Fieldset for Outlined Border -->
        <fieldset aria-hidden="true" class="@BuildFieldsetClass()">
            <legend class="@BuildLegendClass()">
                <span class="@(string.IsNullOrEmpty(Label) || Disabled || Readonly ? "" : "px-2")">@Label@((Required && !Disabled && !Readonly) ? " *" : "")</span>
            </legend>
        </fieldset>
    </div>

    <!-- Helper Text -->
    @if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="mt-1.5 px-3.5 text-xs leading-tight text-black/60" id="@($"{Id}-helper")">
            @HelperText
        </div>
    }
</div>

@code {
    private bool _passwordVisible = false;

    #region String-Specific Parameters

    /// <summary>
    /// Maximum number of characters allowed in the input.
    /// Can be automatically inferred from [MaxLength] or [StringLength] attributes.
    /// </summary>
    [Parameter] public int MaxLength { get; set; } = FormatConstants.DEFAULT_MAX_STRING_INPUT_LIMIT;

    /// <summary>
    /// The type of string input (e.g., Text, Email, Password).
    /// Can be automatically inferred from [DataType] attribute.
    /// </summary>
    [Parameter] public StringInputType StringInputType { get; set; } = StringInputType.Text;

    /// <summary>
    /// When true and StringInputType is Password, automatically adds a visibility toggle icon.
    /// Default is false.
    /// </summary>
    [Parameter] public bool TogglePasswordOnClick { get; set; }

    #endregion

    #region Overrides

    protected override bool HasValue => !string.IsNullOrWhiteSpace(CurrentValue);

    protected override bool TryParseValueFromString(string? value, out string? result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (ComponentOptions is { EnableLifecycleLogging: true })
        {
            Logger?.LogDebugLifeCycle(ComponentOptions, Id, GetType());
        }

        // For nullable string, null or empty string returns null
        result = string.IsNullOrWhiteSpace(value) ? null : value;
        validationErrorMessage = null;
        return true;
    }

    protected override void HandleInput(ChangeEventArgs e)
    {
        // Don't update value for disabled/readonly fields
        if (Disabled || Readonly)
            return;

        var inputValue = e.Value?.ToString();
        CurrentValue = string.IsNullOrWhiteSpace(inputValue) ? null : inputValue;
        // Don't trigger validation on every keystroke - just update the UI
    }

    protected override void HandleChange(ChangeEventArgs e)
    {
        // Don't update value or validate disabled/readonly fields
        if (Disabled || Readonly)
            return;

        var inputValue = e.Value?.ToString();
        CurrentValue = string.IsNullOrWhiteSpace(inputValue) ? null : inputValue;

        // Trigger validation on change (blur)
        // ReSharper disable once ConditionIsAlwaysTrueOrFalseAccordingToNullableAPIContract - outside of Form context EditContext can be null
        EditContext?.NotifyFieldChanged(FieldIdentifier);
    }

    protected override async Task HandleEndIconClick(MouseEventArgs args)
    {
        if (TogglePasswordOnClick)
        {
            _passwordVisible = !_passwordVisible;
        }

        // Call base implementation which handles icon swapping and callback
        await base.HandleEndIconClick(args);
    }

    protected override void InferTypeSpecificAttributes(PropertyInfo propertyInfo)
    {
        // Infer MaxLength if still at default value
        if (MaxLength == FormatConstants.DEFAULT_MAX_STRING_INPUT_LIMIT)
        {
            var maxLengthAttr = propertyInfo.GetCustomAttribute<MaxLengthAttribute>();
            var stringLengthAttr = propertyInfo.GetCustomAttribute<StringLengthAttribute>();

            var inferredMaxLength = maxLengthAttr?.Length ?? stringLengthAttr?.MaximumLength;

            if (inferredMaxLength.HasValue)
            {
                MaxLength = inferredMaxLength.Value;
            }
        }

        // Add min length info to HelperText if available
        var stringLengthAttribute = propertyInfo.GetCustomAttribute<StringLengthAttribute>();

        if (stringLengthAttribute is { MinimumLength: > 0 })
        {
            var minLengthText = $"Minimum {stringLengthAttribute.MinimumLength} characters";
            HelperText = string.IsNullOrEmpty(HelperText)
                ? minLengthText
                : $"{HelperText}. {minLengthText}";
        }

        // Infer StringInputType if still at default (Text)
        if (StringInputType != StringInputType.Text) return;

        var dataTypeAttr = propertyInfo.GetCustomAttribute<DataTypeAttribute>();
        if (dataTypeAttr != null)
        {
            StringInputType = dataTypeAttr.DataType switch
            {
                DataType.Password => StringInputType.Password,
                DataType.EmailAddress => StringInputType.Email,
                DataType.PhoneNumber => StringInputType.Tel,
                DataType.Url => StringInputType.Url,
                _ => StringInputType.Text
            };
        }
    }

    #endregion

    #region String-Specific Methods

    private string GetInputType()
    {
        // Override type for password visibility toggle
        if (StringInputType == StringInputType.Password && _passwordVisible)
        {
            return "text";
        }

        return StringInputType switch
        {
            StringInputType.Password => "password",
            StringInputType.Email => "email",
            StringInputType.Tel => "tel",
            StringInputType.Url => "url",
            StringInputType.Search => "search",
            StringInputType.Text => "text",
            _ => "text"
        };
    }

    #endregion

}