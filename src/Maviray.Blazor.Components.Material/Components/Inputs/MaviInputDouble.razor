            ThemeColorScheme.Success => Tailwind.Theme.Colors.Border.THEME_SUCCESS_EIGHT_BORDER,
            ThemeColorScheme.Warning => Tailwind.Theme.Colors.Border.THEME_WARNING_EIGHT_BORDER,
            ThemeColorScheme.Alert => Tailwind.Theme.Colors.Border.THEME_ALERT_EIGHT_BORDER,
            ThemeColorScheme.Info => Tailwind.Theme.Colors.Border.THEME_INFO_EIGHT_BORDER,
            _ => Tailwind.Theme.Colors.Border.THEME_PRIMARY_EIGHT_BORDER
        };

        _themeBorderDarkColor = ThemeColorScheme switch
        {
            ThemeColorScheme.Secondary => Tailwind.Theme.Colors.Border.THEME_SECONDARY_NINE_BORDER,
            ThemeColorScheme.Success => Tailwind.Theme.Colors.Border.THEME_SUCCESS_NINE_BORDER,
            ThemeColorScheme.Warning => Tailwind.Theme.Colors.Border.THEME_WARNING_NINE_BORDER,
            ThemeColorScheme.Alert => Tailwind.Theme.Colors.Border.THEME_ALERT_NINE_BORDER,
