@using System.Diagnostics.CodeAnalysis
@using System.Reflection
@using Maviray.Blazor.Components.Core.Models
@using Maviray.Blazor.Components.Material.Constants
@typeparam TItem
@typeparam TValue
@implements IAsyncDisposable
@inherits MaviMaterialInputBase<List<TValue>>
@inject IJSRuntime JsRuntime

<div class="@CssManager.Combine(Width, "relative")" @ref="_containerRef">
    <!-- Floating Label Multi-Select Container -->
    <div class="@GetContainerClass()">
        <!-- Multi-Select Display Area -->
        <div class="@BuildMultiSelectClass()"
             @onclick="ToggleDropdown"
             @onfocus="OnFocus"
             @onblur="OnBlur"
             id="@Id"
             tabindex="@(Disabled ? "-1" : "0")"
             role="combobox"
             aria-describedby="@GetAriaDescribedByString()"
             aria-invalid="@GetAreaInvalidValue()"
             aria-label="@Label"
             aria-required="@Required.ToString().ToLowerInvariant()"
             aria-expanded="@_isOpen.ToString().ToLowerInvariant()"
             aria-haspopup="listbox"
             aria-multiselectable="true"
             @attributes="AdditionalAttributes">

            @if (HasValue && CurrentValue != null && CurrentValue.Any())
            {
                <!-- Selected Items as Chips -->
                <div class="@GetChipsContainerClass()">
                    @foreach (var selectedValue in CurrentValue)
                    {
                        var displayText = GetDisplayTextForValue(selectedValue);
                        <div class="@GetChipClass()">
                            <span class="@GetChipTextClass()">@displayText</span>
                            @if (!Disabled && !Readonly)
                            {
                                <button type="button"
                                        class="@GetChipRemoveButtonClass()"
                                        @onclick="async (e) => await RemoveSelection(selectedValue, e)"
                                        @onclick:stopPropagation="true"
                                        aria-label="Remove @displayText">
                                    <i class="lni lni-xmark text-xs"></i>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Floating Label -->
        @if (!string.IsNullOrEmpty(Label))
        {
            <label for="@Id"
                   class="@BuildLabelClass()"
                   title="@Title">
                @Label
                @if (Required && !Disabled && !Readonly)
                {
                    <span class="@BuildRequiredAsteriskClass()">*</span>
                }
            </label>
        }

        <!-- Start Icon -->
        @if (!string.IsNullOrEmpty(StartIcon))
        {
            <div class="@GetStartIconClass()">
                <i class="@StartIcon text-xl"></i>
            </div>
        }

        <!-- Dropdown Arrow Icon -->
        <div class="@GetDropdownArrowClass()" @onclick="ToggleDropdown">
            <i class="@CssManager.Combine(DropdownIcon, "text-xl", "transition-transform duration-200", _isOpen ? "rotate-180" : "")"></i>
        </div>

        <!-- Fieldset for Outlined Border -->
        <fieldset aria-hidden="true" class="@BuildFieldsetClass()">
            <legend class="@BuildLegendClass()">
                <span class="@(string.IsNullOrEmpty(Label) || Disabled || Readonly ? "" : "px-2")">@Label@((Required && !Disabled && !Readonly) ? " *" : "")</span>
            </legend>
        </fieldset>
    </div>

    <!-- Dropdown Options Overlay -->
    @if (_isOpen && !Disabled && !Readonly)
    {
        <div class="@GetDropdownOverlayClass()"
             role="listbox"
             aria-label="@Label"
             aria-multiselectable="true"
             @onclick:stopPropagation="true">

            <!-- Select All / Clear All Actions -->
            @if (ShowSelectAllOption && Items != null && Items.Any())
            {
                <div class="@GetSelectAllContainerClass()">
                    <button type="button"
                            class="@GetSelectAllButtonClass()"
                            @onclick="SelectAll"
                            @onclick:stopPropagation="true">
                        Select All
                    </button>
                    @if (HasValue && CurrentValue != null && CurrentValue.Any())
                    {
                        <button type="button"
                                class="@GetSelectAllButtonClass()"
                                @onclick="ClearAll"
                                @onclick:stopPropagation="true">
                            Clear All
                        </button>
                    }
                </div>
            }

            <!-- Options List Container with Scrolling -->
            <div class="@GetOptionsContainerClass()">
                <!-- Options from Items -->
                @if (Items != null)
                {
                    @foreach (var item in Items)
                    {
                        var value = GetItemValue(item);
                        var text = GetItemText(item);
                        var isSelected = IsSelected(value);

                        <div class="@GetOptionClass(isSelected)"
                             role="option"
                             aria-selected="@isSelected.ToString().ToLowerInvariant()"
                             @onclick="() => ToggleSelection(value)"
                             @onclick:stopPropagation="true"
                             @onmouseenter="() => _hoveredValue = value"
                             @onmouseleave="() => _hoveredValue = default(TValue)">

                            <!-- Checkbox -->
                            <div class="@GetCheckboxClass(isSelected)">
                                @if (isSelected)
                                {
                                    <i class="lni lni-checkmark text-xs"></i>
                                }
                            </div>

                            <span class="block truncate flex-1">@text</span>
                        </div>
                    }
                }
            </div>
        </div>
    }

    <!-- Helper Text -->
    @if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="mt-1.5 px-3.5 text-xs leading-tight text-black/60" id="@($"{Id}-helper")">
            @HelperText
        </div>
    }
</div>

@code {
    private ElementReference _containerRef;
    private bool _isOpen = false;
    private TValue? _hoveredValue = default;
    private DotNetObjectReference<MaviMultiSelect<TItem, TValue>>? _dotNetRef;
    private IJSObjectReference? _jsModule;

    #region MultiSelect-Specific Parameters

    /// <summary>
    /// The collection of items to display in the dropdown.
    /// </summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// Expression to extract the value from each item.
    /// If not provided, the item itself is used as the value.
    /// </summary>
    [Parameter] public Func<TItem, TValue>? ValueSelector { get; set; }

    /// <summary>
    /// Expression to extract the display text from each item.
    /// If not provided, ToString() is called on the item.
    /// </summary>
    [Parameter] public Func<TItem, string>? TextSelector { get; set; }

    /// <summary>
    /// Whether to show Select All / Clear All options.
    /// Default is true.
    /// </summary>
    [Parameter] public bool ShowSelectAllOption { get; set; } = true;

    /// <summary>
    /// Custom icon for the dropdown arrow. Default is a down chevron icon.
    /// </summary>
    [Parameter] public string DropdownIcon { get; set; } = "lni lni-chevron-down";

    /// <summary>
    /// Maximum height for the dropdown options list. Default is "max-h-60".
    /// </summary>
    [Parameter] public string MaxDropdownHeight { get; set; } = "max-h-60";

    /// <summary>
    /// Maximum number of chips to display before showing a count badge.
    /// Default is 3. Set to 0 for unlimited.
    /// </summary>
    [Parameter] public int MaxVisibleChips { get; set; } = 3;

    /// <summary>
    /// Event callback invoked when the selection changes.
    /// </summary>
    [Parameter] public EventCallback<ValueChangedCallbackParameters<List<TValue>>> OnSelectionChanged { get; set; }

    #endregion

    #region Overrides

    protected override bool HasValue
    {
        get
        {
            return CurrentValue != null && CurrentValue.Any();
        }
    }

    protected override bool TryParseValueFromString(
        string? value,
        [MaybeNullWhen(false)] out List<TValue> result,
        [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (ComponentOptions is { EnableLifecycleLogging: true })
        {
            Logger?.LogDebugLifeCycle(ComponentOptions, Id, GetType());
        }

        // Multi-select doesn't parse from string directly
        result = new List<TValue>();
        validationErrorMessage = null;
        return true;
    }

    protected override Task HandleInput(ChangeEventArgs e)
    {
        // Not used for multi-select
        return Task.CompletedTask;
    }

    protected override Task HandleChange(ChangeEventArgs e)
    {
        // Not used for multi-select
        return Task.CompletedTask;
    }

    protected override void InferTypeSpecificAttributes(PropertyInfo propertyInfo)
    {
        // Auto-populate enum values if TValue is an enum or nullable enum
        if (Items != null) return;

        var underlyingType = Nullable.GetUnderlyingType(typeof(TValue));
        var enumType = underlyingType ?? typeof(TValue);

        if (!enumType.IsEnum) return;

        var enumValues = Enum.GetValues(enumType)
            .Cast<object>()
            .Select(e => (TItem)(object)(TValue)e)
            .ToList();
        Items = enumValues;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Maviray.Blazor.Components.Material/js/maviDropDownJsInterop.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _jsModule.InvokeVoidAsync("initializeDropdown", _dotNetRef, _containerRef);
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // Initialize CurrentValue as empty list if null
        if (CurrentValue == null)
        {
            CurrentValue = new List<TValue>();
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        _dotNetRef?.Dispose();
    }

    #endregion

    #region MultiSelect Logic

    [JSInvokable]
    public async Task CloseFromJs()
    {
        if (_isOpen)
        {
            _isOpen = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleDropdown()
    {
        if (Disabled || Readonly)
            return;

        _isOpen = !_isOpen;
        IsFocused = _isOpen;

        if (ComponentOptions is { EnableLifecycleLogging: true })
        {
            Logger?.LogDebugLifeCycle(ComponentOptions, Id, GetType());
        }

        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task ToggleSelection(TValue value)
    {
        if (Disabled || Readonly)
            return;

        if (CurrentValue == null)
        {
            CurrentValue = new List<TValue>();
        }

        if (IsSelected(value))
        {
            CurrentValue.Remove(value);
        }
        else
        {
            CurrentValue.Add(value);
        }

        await NotifySelectionChanged();
    }

    private async Task RemoveSelection(TValue value, MouseEventArgs e)
    {
        if (Disabled || Readonly)
            return;

        if (CurrentValue != null && CurrentValue.Contains(value))
        {
            CurrentValue.Remove(value);
            await NotifySelectionChanged();
        }
    }

    private async Task SelectAll()
    {
        if (Disabled || Readonly || Items == null)
            return;

        CurrentValue = Items.Select(GetItemValue).ToList();
        await NotifySelectionChanged();
    }

    private async Task ClearAll()
    {
        if (Disabled || Readonly)
            return;

        CurrentValue = new List<TValue>();
        await NotifySelectionChanged();
    }

    private async Task NotifySelectionChanged()
    {
        // Trigger validation
        EditContext?.NotifyFieldChanged(FieldIdentifier);

        // Invoke custom callback
        if (OnSelectionChanged.HasDelegate)
        {
            await OnSelectionChanged.InvokeAsync(new() { ElementId = Id, Value = CurrentValue });
        }

        StateHasChanged();
    }

    private bool IsSelected(TValue value)
    {
        if (CurrentValue == null || !CurrentValue.Any())
            return false;

        return CurrentValue.Any(v => EqualityComparer<TValue>.Default.Equals(v, value));
    }

    private string GetDisplayTextForValue(TValue value)
    {
        if (Items == null)
            return value?.ToString() ?? string.Empty;

        foreach (var item in Items)
        {
            var itemValue = GetItemValue(item);
            if (EqualityComparer<TValue>.Default.Equals(itemValue, value))
            {
                return GetItemText(item);
            }
        }

        return value?.ToString() ?? string.Empty;
    }

    #endregion

    #region CSS Classes

    private string BuildMultiSelectClass()
    {
        var classes = new List<string>
        {
            CssManager.Combine(
                "block w-full bg-transparent border-0 outline-none rounded",
                "transition-all duration-200",
                "flex items-center gap-1.5", // Changed from flex-wrap to keep single line
                "overflow-hidden" // Hide overflow chips
            )
        };

        // Cursor
        if (Disabled)
        {
            classes.Add("cursor-not-allowed");
        }
        else if (Readonly)
        {
            classes.Add("cursor-default");
        }
        else
        {
            classes.Add("cursor-pointer");
        }

        // Focus
        classes.Add("focus:outline-none focus:ring-0");

        // Padding and font size for each size
        var (padding, fontSize) = ElementSize switch
        {
            ElementSize.Small => GetMultiSelectSizePadding(
                "px-3 py-2", // Simplified padding for single line
                "pl-[36px] pr-8 py-2",
                "text-sm"
            ),
            ElementSize.Large => GetMultiSelectSizePadding(
                "px-4 py-3",
                "pl-[38px] pr-10 py-3",
                "text-lg"
            ),
            _ => GetMultiSelectSizePadding(
                "px-3.5 py-2.5",
                "pl-[36px] pr-9 py-2.5",
                "text-base"
            )
        };

        classes.Add(padding);
        classes.Add(fontSize);

        return CssManager.Combine(classes.ToArray());
    }

    private (string padding, string fontSize) GetMultiSelectSizePadding(
        string defaultPadding,
        string iconPadding,
        string fontSize)
    {
        var hasStartIcon = !string.IsNullOrEmpty(StartIcon);
        var padding = hasStartIcon ? iconPadding : defaultPadding;
        return (padding, fontSize);
    }

    private string GetChipsContainerClass()
    {
        return CssManager.Combine(
            "flex gap-1.5 mt-[4px] w-full",
            "overflow-hidden" // Prevent wrapping and hide overflow
        );
    }

    private string GetChipClass()
    {
        var bgColor = Disabled ? "bg-gray-50" : "bg-gray-100";
        var textColor = Disabled ? "text-black/[0.38]" : ThemeTextDarkColor;

        var size = ElementSize switch
        {
            ElementSize.Small => "px-2 py-0.5 text-xs",
            ElementSize.Large => "px-3 py-1 text-base",
            _ => "px-2.5 py-0.5 text-sm"
        };

        return CssManager.Combine(
            "inline-flex items-center gap-1.5 rounded-full",
            "flex-shrink-0", // Prevent chips from shrinking
            bgColor,
            textColor,
            size,
            "max-w-[200px]" // Optional: set max width for individual chips
        );
    }

    private string GetChipTextClass()
    {
        return "truncate";
    }

    private string GetChipRemoveButtonClass()
    {
        return CssManager.Combine(
            "flex-shrink-0 rounded-full",
            "hover:bg-black/[0.08] active:bg-black/[0.12]",
            "transition-colors duration-150",
            "w-4 h-4 flex items-center justify-center",
            "focus:outline-none focus:ring-1 focus:ring-black/20"
        );
    }

    private string GetDropdownArrowClass()
    {
        var classes = new List<string>
        {
            CssManager.Combine(
                $"absolute {GetIconTopOffset()} -translate-y-1/2 right-2",
                "transition-colors duration-200 z-10 cursor-pointer"
            )
        };

        // Icon color based on state
        if (HasError)
        {
            classes.Add(TextAlertColor);
        }
        else if (IsFocused || _isOpen)
        {
            classes.Add(ThemeTextDarkColor);
        }
        else if (Disabled)
        {
            classes.Add("text-black/[0.23]");
        }
        else if (Readonly)
        {
            classes.Add("text-black/[0.38]");
        }
        else
        {
            classes.Add(ThemeTextLightColor);
        }

        return CssManager.Combine(classes.ToArray());
    }

    private string GetDropdownOverlayClass()
    {
        var borderColor = HasError ? BorderAlertColor : ThemeBorderLightColor;

        return CssManager.Combine(
            "absolute left-0 right-0 z-50",
            "mt-1 rounded-md shadow-lg",
            "bg-white border-2",
            borderColor,
            "transform transition-all duration-200 ease-out",
            "origin-top"
        );
    }

    private string GetSelectAllContainerClass()
    {
        return CssManager.Combine(
            "flex items-center justify-between gap-2",
            "px-3.5 py-2 border-b border-black/[0.12]"
        );
    }

    private string GetSelectAllButtonClass()
    {
        return CssManager.Combine(
            "text-sm font-medium",
            ThemeTextDarkColor,
            "hover:underline",
            "focus:outline-none focus:underline",
            "transition-all duration-150"
        );
    }

    private string GetOptionsContainerClass()
    {
        return CssManager.Combine(
            MaxDropdownHeight,
            "overflow-y-auto",
            "py-1",
            "scrollbar-thin scrollbar-thumb-gray-300 scrollbar-track-gray-100"
        );
    }

    private string GetOptionClass(bool isSelected)
    {
        var baseClasses = CssManager.Combine(
            "relative px-3.5 py-2.5 cursor-pointer select-none",
            "flex items-center gap-3",
            "transition-colors duration-150"
        );

        string stateClasses;
        if (isSelected)
        {
            stateClasses = CssManager.Combine(
                ThemeTextDarkColor,
                "bg-black/[0.04]"
            );
        }
        else
        {
            stateClasses = CssManager.Combine(
                "text-black/[0.87]",
                "hover:bg-black/[0.04]",
                "active:bg-black/[0.08]"
            );
        }

        var fontSize = ElementSize switch
        {
            ElementSize.Small => "text-sm",
            ElementSize.Large => "text-lg",
            _ => "text-base"
        };

        return CssManager.Combine(baseClasses, stateClasses, fontSize);
    }

    private string GetCheckboxClass(bool isSelected)
    {
        var baseClasses = CssManager.Combine(
            "flex-shrink-0 w-5 h-5 rounded border-2",
            "flex items-center justify-center",
            "transition-all duration-150"
        );

        var stateClasses = isSelected
            ? CssManager.Combine(Tailwind.Theme.Colors.Background.THEME_LIGHT_FIVE_BG, ThemeBorderDarkColor, "text-white")
            : "border-black/[0.54] bg-transparent";

        return CssManager.Combine(baseClasses, stateClasses);
    }

    private TValue GetItemValue(TItem item)
    {
        if (item == null)
            return default(TValue)!;

        if (ValueSelector != null)
        {
            return ValueSelector(item);
        }

        // If TItem and TValue are the same type, cast directly
        if (typeof(TItem) == typeof(TValue))
        {
            return (TValue)(object)item;
        }

        // Try to convert
        try
        {
            return (TValue)Convert.ChangeType(item, typeof(TValue))!;
        }
        catch
        {
            return default!;
        }
    }

    private string GetItemText(TItem item)
    {
        if (item == null)
            return string.Empty;

        if (TextSelector != null)
        {
            return TextSelector(item);
        }

        return item.ToString() ?? string.Empty;
    }

    #endregion

    private bool _disposed = false;

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;

        // Cleanup JavaScript event listeners
        if (_jsModule != null)
        {
            try
            {
                // Call the JavaScript cleanup function to remove event listeners
                await _jsModule.InvokeVoidAsync("disposeDropdown", _containerRef);
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException ex)
            {
                Logger?.Error(ex, ex.Message);
            }
        }

        // Dispose the .NET object reference
        _dotNetRef?.Dispose();

        // Call base disposal
        base.Dispose();
    }
}