<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Maviray.Blazor.Components.Material</PackageId>
    <Description>Blazor UI Material library</Description>
    <PackageTags>blazor;components;ui;material;maviray</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Forms" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.JSInterop" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package-lock.json;package.json" />
    <None Include="package-lock.json;package.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maviray.Blazor.Components.Core\Maviray.Blazor.Components.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maviray.Blazor.Components.Material.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TailwindCssOutput>wwwroot/css/maviray.material.min.css</TailwindCssOutput>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Tailwind.targets" />
</Project>
