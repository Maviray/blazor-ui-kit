<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Maviray.Blazor.Components.Material\Maviray.Blazor.Components.Material.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TailwindCssOutput>wwwroot/css/maviray.showcase.client.min.css</TailwindCssOutput>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Tailwind.targets" />
</Project>
