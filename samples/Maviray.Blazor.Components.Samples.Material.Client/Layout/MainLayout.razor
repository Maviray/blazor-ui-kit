@using Maviray.Blazor.Components.Core.Utilities
@using Maviray.Blazor.Components.Material.Components.Inputs
@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="@CssManager.Combine(Tailwind.Theme.Colors.Background.THEME_LIGHT_ONE_BG, Tailwind.Theme.Colors.Border.THEME_LIGHT_THREE_BORDER, "border-b sticky top-0 z-50")">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center">
                    <h1 class="@CssManager.Combine(Tailwind.Theme.Typography.TITLE_LARGE, Tailwind.Theme.Colors.Text.THEME_DARK_NINE_TEXT)">Maviray Blazor UI Kit</h1>
                </div>
                <nav class="flex gap-4">
                    <a href="/" class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, Tailwind.Theme.Colors.Text.THEME_DARK_SIX_TEXT, Tailwind.Theme.Colors.Text.Hover.THEME_DARK_NINE_TEXT_HOVER, "px-3 py-2 rounded-md")">Home</a>
                    <a href="/components" class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, Tailwind.Theme.Colors.Text.THEME_DARK_SIX_TEXT, Tailwind.Theme.Colors.Text.Hover.THEME_DARK_NINE_TEXT_HOVER, "px-3 py-2 rounded-md")">Components</a>
                    <a href="/about" class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, Tailwind.Theme.Colors.Text.THEME_DARK_SIX_TEXT, Tailwind.Theme.Colors.Text.Hover.THEME_DARK_NINE_TEXT_HOVER, "px-3 py-2 rounded-md")">About</a>
                </nav>
            </div>
        </div>
    </header>

    <div class="flex flex-1">
        <!-- Side Navigation -->
        <aside class="@CssManager.Combine(Tailwind.Theme.Colors.Background.THEME_LIGHT_TWO_BG, Tailwind.Theme.Colors.Border.THEME_LIGHT_THREE_BORDER, "w-64 border-r overflow-y-auto")">
            <nav class="py-4 pr-4 pl-16 space-y-2 flex flex-col gap-2">
                <div class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, Tailwind.Theme.Colors.Text.THEME_DARK_FIVE_TEXT, "px-3 py-2")">
                    Base
                </div>
                <MaviLink Href="/PageCustomColors"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="Custom Theme Colors"
                          Title="Custom Theme Colors">
                </MaviLink>
                <MaviLink Href="/PageIconsMini"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="Icons Mini"
                          Title="Icons Mini">
                </MaviLink>
                <MaviLink Href="/PageIconsOnline"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="Icons Online"
                          Title="Icons Online">
                </MaviLink>
                <MaviLink Href="/PageIconsSolid"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="Icons Solid"
                          Title="Icons Solid">
                </MaviLink>
                <MaviLink Href="/PageIconColors"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="Icons Colors"
                          Title="Icons Colors">
                </MaviLink>
                <MaviLink Href="/PageLineIcons"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="Line Icons"
                          Title="Line Icons">
                </MaviLink>
            <MaviLink Href="/PageTypography"
                      ThemeColorScheme="ThemeColorScheme.Default"
                      ElementSize="ElementSize.Large"
                      ElementVariant="ElementVariant.Text"
                      Label="Typography"
                      Title="Typography">
            </MaviLink>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, Tailwind.Theme.Colors.Text.THEME_DARK_FIVE_TEXT, "px-3 py-2")">
                Inputs
            </div>
                <MaviLink Href="/PageMaviButton"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviButton"
                          Title="MaviButton">
                </MaviLink>
                <MaviLink Href="/PageMaviButtonGroup"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviButtonGroup"
                          Title="MaviButtonGroup">
                </MaviLink>
                <MaviLink Href="/PageForm"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="Form Elements"
                          Title="Form Elements">
                </MaviLink>
                <MaviLink Href="/PageMaviInputInteger"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputInteger"
                          Title="MaviInputInteger">

                </MaviLink>
                <MaviLink Href="/PageMaviInputIntegerNullable"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputIntegerNullable"
                          Title="MaviInputIntegerNullable">
                </MaviLink>
                <MaviLink Href="/PageMaviInputString"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputString"
                          Title="MaviInputString">
                </MaviLink>
                <MaviLink Href="/PageMaviInputStringNullable"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputStringNullable"
                          Title="MaviInputStringNullable">
                </MaviLink>
                <MaviLink Href="/PageMaviInputDouble"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputDouble"
                          Title="MaviInputDouble">

                </MaviLink>
                <MaviLink Href="/PageMaviInputDoubleNullable"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputDoubleNullable"
                          Title="MaviInputDoubleNullable">

                </MaviLink>
                <MaviLink Href="/PageMaviLink"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviLink"
                          Title="MaviLink">
                </MaviLink>
                <MaviLink Href="/PageMaviInputDecimal"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputDecimal"
                          Title="MaviInputDecimal">

                </MaviLink>
                <MaviLink Href="/PageMaviInputLong"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputLong"
                          Title="MaviInputLong">

                </MaviLink>
                <MaviLink Href="/PageMaviInputFloat"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputFloat"
                          Title="MaviInputFloat">

                </MaviLink>
                <MaviLink Href="/PageMaviInputShort"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputShort"
                          Title="MaviInputShort">

                </MaviLink>
                <MaviLink Href="/PageMaviInputDate"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputDate"
                          Title="MaviInputDate">

                </MaviLink>
                <MaviLink Href="/PageMaviInputDateNullable"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviInputDateNullable"
                          Title="MaviInputDateNullable">

                </MaviLink>
                <MaviLink Href="/PageMaviDropdown"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviDropdown"
                          Title="MaviDropdown">

                </MaviLink>
                <MaviLink Href="/PageMaviMultiSelect"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviMultiSelect"
                          Title="MaviMultiSelect">

                </MaviLink>
                <MaviLink Href="/PageMaviCheckbox"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviCheckbox"
                          Title="MaviCheckbox">

                </MaviLink>
                <MaviLink Href="/PageMaviToggle"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviToggle"
                          Title="MaviToggle">
                </MaviLink>
                <MaviLink Href="/PageMaviSwitch"
                          ThemeColorScheme="ThemeColorScheme.Default"
                          ElementSize="ElementSize.Large"
                          ElementVariant="ElementVariant.Text"
                          Label="MaviSwitch"
                          Title="MaviSwitch">
                </MaviLink>
            <MaviLink Href="/PageMaviAutocomplete"
                      ThemeColorScheme="ThemeColorScheme.Default"
                      ElementSize="ElementSize.Large"
                      ElementVariant="ElementVariant.Text"
                      Label="MaviAutocomplete"
                      Title="MaviAutocomplete">
            </MaviLink>
            <MaviLink Href="/PageMaviSlider"
                      ThemeColorScheme="ThemeColorScheme.Default"
                      ElementSize="ElementSize.Large"
                      ElementVariant="ElementVariant.Text"
                      Label="MaviSlider"
                      Title="MaviSlider">
            </MaviLink>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, Tailwind.Theme.Colors.Text.THEME_DARK_FIVE_TEXT, "px-3 py-2")">
                Data Display
            </div>
            <MaviLink Href="/PageMaviChip"
                      ThemeColorScheme="ThemeColorScheme.Default"
                      ElementSize="ElementSize.Large"
                      ElementVariant="ElementVariant.Text"
                      Label="MaviChip"
                      Title="MaviChip">
            </MaviLink>
                <MaviLink Href="/PageMaviAlert"
                      ThemeColorScheme="ThemeColorScheme.Default"
                      ElementSize="ElementSize.Large"
                      ElementVariant="ElementVariant.Text"
                          Label="MaviAlert"
                          Title="MaviAlert">
            </MaviLink>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 overflow-y-auto">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                @Body
            </div>
        </main>
    </div>
</div>