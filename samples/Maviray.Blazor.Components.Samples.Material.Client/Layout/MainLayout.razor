@using Maviray.Blazor.Components.Core.Components
@using Maviray.Blazor.Components.Core.Interfaces
@using Maviray.Blazor.Components.Material.Components.ErrorHandlers
@using Maviray.Blazor.Components.Material.Components.Menus
@using Maviray.Blazor.Components.Material.Components.NavBars
@inherits MavirayLayoutBase

<div class="w-full h-dvh flex">
    <MaviErrorHandler>
        <CascadingValue Value="@(this)">
            <!-- 1) Left side nav -->
            <aside class="@GetSideNavContainerCss()">
                <div class="h-[48px] flex items-center justify-center">
                    <div>BUIK</div>
                </div>
                <div class="h-[80dvh] overflow-y-auto overflow-x-hidden">
                    <MaviMenuVertical @ref="_maviMenuVertical" PullMenuItems="GetMenuItems" ElementSize="ElementSize.Large" ItemClicked="ItemClicked" DarkMode="true" />
                </div>
            </aside>

            <!-- 2) Right side -->
            <div class="flex-1 min-w-0 flex flex-col">
                <!-- a) Header -->
                <header class="shrink-0 p-1 h-[48px]">
                    <TopNavBar>
                        <LeftContent>
                            <MaviButtonIcon Icon="lni lni-menu-hamburger-1"
                                            ID="@ElementConstants.Button.TOGGLE_SIDE_NAV_BAR"
                                            ElementSize="ElementSize.Regular"
                                            ElementVariant="ElementVariant.Text"
                                            OnClick="OnHamburgerButtonClick"
                                            Title="Toggle Side Nav Bar" />
                        </LeftContent>
                        <CenterContent>
                            <div class="hidden md:block!">
                                <h1 class="@CssManager.Combine(Tailwind.Theme.Typography.TITLE_LARGE, Tailwind.Theme.Colors.Text.THEME_DARK_NINE_TEXT)">Blazor UI Kit</h1>
                            </div>
                        </CenterContent>
                        <RightContent>
                            <MaviLink Href="/"
                                      ThemeColorScheme="ThemeColorScheme.Default"
                                      ElementSize="ElementSize.Large"
                                      ElementVariant="ElementVariant.Text"
                                      Label="Home"
                                      Title="Home">
                            </MaviLink>
                        </RightContent>
                    </TopNavBar>
                </header>

                <!-- b) Main content -->
                <main class="flex-1 h-0 min-h-0 overflow-auto">
                    @Body
                </main>

                <!-- c) Footer -->
                <footer class="@CssManager.Combine("shrink-0 flex justify-between bg-(--theme-dark-eight) text-(--theme-light-two) py-1 px-2", Tailwind.Theme.Typography.BODY_SMALL)">
                    <span class="hidden md:block!">Blazor UI Kit</span>
                    <span class="hidden md:block!">Designed & Supported by Maviray</span>
                </footer>
            </div>
        </CascadingValue>
    </MaviErrorHandler>
</div>

@code
{
    private MaviMenuVertical? _maviMenuVertical;

    private Task OnHamburgerButtonClick(MouseClickEventArgs args)
    {
        CircuitStateService?.ReportClick(args.ButtonId);
        return Task.CompletedTask;
    }

    private async Task<IEnumerable<IMenuItem>> GetMenuItems()
    {
        if (CircuitStateService != null)
        {
            return await CircuitStateService.GetMenuItems();
        }

        return Enumerable.Empty<IMenuItem>();
    }

    private Task ItemClicked(IMenuItem item)
    {
        if (string.IsNullOrWhiteSpace(item.NavigateTo))
        {
            return Task.CompletedTask;
        }

        NavigationManager?.NavigateTo(item.NavigateTo, item.RequireFullPageReload);

        return Task.CompletedTask;
    }

    private string GetSideNavContainerCss()
    {
        var expanded = true;

        if (_maviMenuVertical is not null)
        {
            expanded = _maviMenuVertical.Expanded;
        }
        var width = expanded ? "w-64" : "w-[64px]";

        return $"{width} shrink-0 flex flex-col bg-(--theme-dark-eight) text-(--theme-light-two)";
    }
}
