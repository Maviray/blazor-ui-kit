@page "/PageMaviTabs"
@using Maviray.Blazor.Components.Material.Components.Navigation
@inherits SamplePageBase

<PageTitle>Tabs</PageTitle>


<div class="p-4 flex flex-col gap-4">
    <div class="flex flex-col">
        <MaviTabNavBar @ref="_tabNavBar" OnTabClick="OnTabClick" ThemeColorScheme="ThemeColorScheme.Primary" ElementSize="ElementSize.Regular">
            <MaviTab Title="Tab One" Icon="lni lni-alarm-1" Id="SampleTabOne" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Large"></MaviTab>
            <MaviTab Title="Tab Two" Icon="lni lni-android-old" Id="SampleTabTwo" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Large"></MaviTab>
            <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right" Id="SampleTabThree" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Large"></MaviTab>
            <MaviTab Title="Tab Four" Icon="lni lni-home-2" Id="SampleTabFour" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Large"></MaviTab>
        </MaviTabNavBar>
        <div>
            <MaviTabContent BoundToTabId="SampleTabOne" Context="_tabNavBar?.Context">
               TAB ONE
            </MaviTabContent>
            <MaviTabContent BoundToTabId="SampleTabTwo" Context="_tabNavBar?.Context">
                TAB  TWO
            </MaviTabContent>
            <MaviTabContent BoundToTabId="SampleTabThree" Context="_tabNavBar?.Context">
                TAB THREE
            </MaviTabContent>
            <MaviTabContent BoundToTabId="SampleTabFour" Context="_tabNavBar?.Context">
                TAB  FOUR
            </MaviTabContent>
        </div>
    </div>

    <MaviTabNavBar @ref="_tabNavBarPrimarySmall" OnTabClick="OnTabClick" ThemeColorScheme="ThemeColorScheme.Primary" ElementSize="ElementSize.Small">
        <MaviTab Title="Tab One" Icon="lni lni-alarm-1"></MaviTab>
        <MaviTab Title="Tab Two" Icon="lni lni-android-old"></MaviTab>
        <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right"></MaviTab>
        <MaviTab Title="Tab Four" Icon="lni lni-home-2"></MaviTab>
    </MaviTabNavBar>

    <MaviTabNavBar @ref="_tabNavBarPrimaryRegular" OnTabClick="OnTabClick" ThemeColorScheme="ThemeColorScheme.Primary" ElementSize="ElementSize.Regular">
        <MaviTab Title="Tab One" Icon="lni lni-alarm-1"></MaviTab>
        <MaviTab Title="Tab Two" Icon="lni lni-android-old"></MaviTab>
        <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right"></MaviTab>
        <MaviTab Title="Tab Four" Icon="lni lni-home-2"></MaviTab>
    </MaviTabNavBar>

    <MaviTabNavBar @ref="_tabNavBarPrimaryLarge" OnTabClick="OnTabClick" ThemeColorScheme="ThemeColorScheme.Primary" ElementSize="ElementSize.Large">
        <MaviTab Title="Tab One" Icon="lni lni-alarm-1"></MaviTab>
        <MaviTab Title="Tab Two" Icon="lni lni-android-old"></MaviTab>
        <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right"></MaviTab>
        <MaviTab Title="Tab Four" Icon="lni lni-home-2"></MaviTab>
    </MaviTabNavBar>

    <MaviTabNavBar @ref="_tabNavBarPrimarySecondary"
                   OnTabClick="OnTabClick"
                   ThemeColorScheme="ThemeColorScheme.Secondary"
                   ElementSize="ElementSize.Regular"
                   InitialActiveTabId="InitialTabId">
        <MaviTab Id="InitialTabId" Title="Tab One" Icon="lni lni-alarm-1"></MaviTab>
        <MaviTab Title="Tab Two" Icon="lni lni-android-old"></MaviTab>
        <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right"></MaviTab>
        <MaviTab Title="Tab Four" Icon="lni lni-home-2"></MaviTab>
    </MaviTabNavBar>

    <MaviTabNavBar @ref="_tabNavBarPrimarySuccess" OnTabClick="OnTabClick"
                   ThemeColorScheme="ThemeColorScheme.Success"
                   ElementSize="ElementSize.Regular">

        <MaviTab Title="Tab One" Icon="lni lni-alarm-1" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Small"></MaviTab>
        <MaviTab Title="Tab Two" Icon="lni lni-android-old" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Small"></MaviTab>
        <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Small"></MaviTab>
        <MaviTab Title="Tab Four" Icon="lni lni-home-2" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Small"></MaviTab>
    </MaviTabNavBar>
    <MaviTabNavBar @ref="_tabNavBarPrimaryWarning" OnTabClick="OnTabClick"
                   ThemeColorScheme="ThemeColorScheme.Warning"
                   ElementSize="ElementSize.Regular">

        <MaviTab Title="Tab One" Icon="lni lni-alarm-1" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Large"></MaviTab>
        <MaviTab Title="Tab Two" Icon="lni lni-android-old" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Large"></MaviTab>
        <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Large"></MaviTab>
        <MaviTab Title="Tab Four" Icon="lni lni-home-2" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Large"></MaviTab>
    </MaviTabNavBar>
    <MaviTabNavBar @ref="_tabNavBarPrimaryAlert" OnTabClick="OnTabClick"
                   ThemeColorScheme="ThemeColorScheme.Alert"
                   ElementSize="ElementSize.Regular">

        <MaviTab Title="Tab One" Icon="lni lni-alarm-1" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.ExtraLarge"></MaviTab>
        <MaviTab Title="Tab Two" Icon="lni lni-android-old" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.ExtraLarge"></MaviTab>
        <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.ExtraLarge"></MaviTab>
        <MaviTab Title="Tab Four" Icon="lni lni-home-2" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.ExtraLarge"></MaviTab>
    </MaviTabNavBar>
    <MaviTabNavBar @ref="_tabNavBarPrimaryInfo" OnTabClick="OnTabClick"
                   ThemeColorScheme="ThemeColorScheme.Info"
                   ElementSize="ElementSize.Regular">

        <MaviTab Title="Tab One" Icon="lni lni-alarm-1" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.TwoExtraLarge"></MaviTab>
        <MaviTab Title="Tab Two" Icon="lni lni-android-old" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.TwoExtraLarge"></MaviTab>
        <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.TwoExtraLarge"></MaviTab>
        <MaviTab Title="Tab Four" Icon="lni lni-home-2" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.TwoExtraLarge"></MaviTab>
    </MaviTabNavBar>
    <MaviTabNavBar @ref="_tabNavBarPrimaryDark" OnTabClick="OnTabClick"
                   ThemeColorScheme="ThemeColorScheme.Dark"
                   ElementSize="ElementSize.Regular">

        <MaviTab Title="Tab One" Icon="lni lni-alarm-1" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Small"></MaviTab>
        <MaviTab Title="Tab Two" Icon="lni lni-android-old" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Medium"></MaviTab>
        <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.Large"></MaviTab>
        <MaviTab Title="Tab Four" Icon="lni lni-home-2" ShowTitleOnBreakpoint="ScreenSizeBreakpoint.ExtraLarge"></MaviTab>
    </MaviTabNavBar>
    <MaviTabNavBar @ref="_tabNavBarPrimaryLight" OnTabClick="OnTabClick"
                   ThemeColorScheme="ThemeColorScheme.Light"
                   ElementSize="ElementSize.Regular">

        <MaviTab Title="Tab One" Icon="lni lni-alarm-1"></MaviTab>
        <MaviTab Title="Tab Two" Icon="lni lni-android-old"></MaviTab>
        <MaviTab Title="Tab Three" Icon="lni lni-angle-double-right"></MaviTab>
        <MaviTab Title="Tab Four" Icon="lni lni-home-2"></MaviTab>
    </MaviTabNavBar>
</div>

@code
{
    private MaviTabNavBar? _tabNavBar;

    private MaviTabNavBar? _tabNavBarPrimarySmall;
    private MaviTabNavBar? _tabNavBarPrimaryRegular;
    private MaviTabNavBar? _tabNavBarPrimaryLarge;

    private MaviTabNavBar? _tabNavBarPrimarySecondary;
    private MaviTabNavBar? _tabNavBarPrimarySuccess;
    private MaviTabNavBar? _tabNavBarPrimaryWarning;
    private MaviTabNavBar? _tabNavBarPrimaryAlert;
    private MaviTabNavBar? _tabNavBarPrimaryInfo;
    private MaviTabNavBar? _tabNavBarPrimaryDark;
    private MaviTabNavBar? _tabNavBarPrimaryLight;

    private Task OnTabClick(TabClickEventArgs args)
    {
        Logger?.LogInformation("Tab clicked: {ButtonId} (NavBar: {TabNavBarId})", args.ButtonId, args.TabNavBarId);
        return Task.CompletedTask;
    }
}