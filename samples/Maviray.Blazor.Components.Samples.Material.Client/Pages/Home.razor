@page "/"
@using Maviray.Blazor.Components.Material.Components.Menus
@inherits SamplePageBase

<div class="max-w-7xl mx-auto p-4 flex flex-col gap-4">
    <div class="flex">
        <div class="basis-1/3">
            <MaviMenuVertical PullMenuItems="GetMenuItems" InitiallyExpanded="true" ElementSize="ElementSize.Small" ItemClicked="ItemClicked"/>
        </div>
        <div class="basis-1/3">
            <MaviMenuVertical PullMenuItems="GetMenuItems" InitiallyExpanded="true" ElementSize="ElementSize.Regular" ItemClicked="ItemClicked"/>
        </div>
        <div class="basis-1/3">
            <MaviMenuVertical PullMenuItems="GetMenuItems" InitiallyExpanded="true" ElementSize="ElementSize.Large" ItemClicked="ItemClicked"/>
        </div>
    </div>
    <div>
        @_message
    </div>
</div>

@code
{
    private string _message = string.Empty;

    readonly List<IMenuItem> _menuItems =
    [
        new MenuItem
        {
            Title = "Home",
            Icon = "lni lni-home-2",
