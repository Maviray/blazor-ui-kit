@page "/"
@using Maviray.Blazor.Components.Material.Components.Surfaces
@inherits SamplePageBase

<div class="w-full flex gap-2 p-4">
    <div class="basis-1/3 flex flex-col gap-2">
        @foreach (var theme in Enum.GetValues<ThemeColorScheme>())
        {
            <MaviCard Title="Card Title" ElementVariant="ElementVariant.Filled" ThemeColorScheme="theme">
                <div>
                    <h2>Title</h2>
                    <div>
                        this is sample content of a card
                    </div>
                </div>
            </MaviCard>
        }
       
    </div>
    <div class="basis-1/3 flex flex-col gap-2">
        @foreach (var theme in Enum.GetValues<ThemeColorScheme>())
        {
            <MaviCard Title="Card Title" ElementVariant="ElementVariant.Outlined" ThemeColorScheme="theme">
                <div>
                    <h2>Title</h2>
                    <div>
                        this is sample content of a card
                    </div>
                </div>
            </MaviCard>
        }
    </div>
    <div class="basis-1/3 flex flex-col gap-2">
        @foreach (var theme in Enum.GetValues<ThemeColorScheme>())
        {
            <MaviCard Title="Card Title" ElementVariant="ElementVariant.Text" ThemeColorScheme="theme">
                <div>
                    <h2>Title</h2>
                    <div>
                        this is sample content of a card
                    </div>
                </div>
            </MaviCard>
        }
    </div>
</div>