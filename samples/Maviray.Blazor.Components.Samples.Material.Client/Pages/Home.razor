@page "/"
@using Maviray.Blazor.Components.Core.Models.Tables
@using Maviray.Blazor.Components.Material.Components.Tables
@using Maviray.Blazor.Components.Samples.Material.Client.Enums
@inherits SamplePageBase

<PageTitle>Blazor UI Kit</PageTitle>

<div class="max-w-7xl mx-auto p-2 flex flex-col space-y-4">
    <h1 class="@Tailwind.Theme.Typography.DISPLAY_MEDIUM">Blazor UI Kit</h1>

    <p class="@Tailwind.Theme.Typography.BODY_LARGE">This is a Blazor UI component library.</p>

    <p class="@Tailwind.Theme.Typography.BODY_LARGE">Its role is to provide simple and hopefully straight-forward set of UI components for everyday typical requirements of UI development and help speed things up.</p>

    <p class="@Tailwind.Theme.Typography.BODY_LARGE">Its not designed to be feature-rich and attempt to cover all possible scenarios. It is here to give you basic stuff to speed up UI development for most standard scenarios where you need to get something done quickly. </p>

    <p class="@Tailwind.Theme.Typography.BODY_LARGE">The library uses Tailwind to manage CSS. I find it to be a great way to manage CSS under control.</p>

    <p class="@Tailwind.Theme.Typography.BODY_LARGE">The library uses Lineicons library for icons. Theoretically one can attempt to use other icons, I find what Lineicons team does to be really cool – simple and straight-forward. I also find their pricing policy to be reasonable should one require professional icon package.</p>

    <p class="@Tailwind.Theme.Typography.BODY_LARGE">There are multiple individual input components. It’s a conscious decision. Yes, it could have been implemented as a generic component. IMHO – it’s an unnecessary complication of introducing heavy reflection overhead. The number of primitives is not likely to change in any foreseeable future so its not like scalability is an issue in this case. </p>

    <p class="@Tailwind.Theme.Typography.BODY_LARGE">I am sure there are plenty of room for improvement and optimization. There are probably lots of aspects which one may find could have been done better, more optimally. If you believe its worth the effort, lets look into it.</p>
    
    <div class="mx-auto flex gap-4">
        <div>
            <MaviLink Href="https://github.com/Maviray/blazor-ui-kit"
                      ThemeColorScheme="ThemeColorScheme.Primary"
                      ElementSize="ElementSize.Large"
                      ElementVariant="ElementVariant.Text"
                      Label="GitHub Repo"
                      Title="GitHub Repo">
            </MaviLink>
        </div>
        <div>&#100;&#101;&#118;&#111;&#112;&#115;&#64;&#109;&#97;&#118;&#105;&#114;&#97;&#121;&#46;&#99;&#111;&#109;</div>
    </div>
    
    <div class="mb-8">
        <MaviCssGridTable @ref="_maviCssGridTable"
                           FetchData="FetchDataFullFeatures"
                           ConstructContextMenu="ConstructMainContextMenu"
                           OnMainContextMenuClick="OnMainContextMenuClick"
                           OnRowClick="OnRowClick"
                           Parameters="_fullFeaturedParameters"
                           OnRowContextMenuClick="OnRowContextMenuClick">
        </MaviCssGridTable>
    </div>
</div>

@code {

    private MaviCssGridTable? _maviCssGridTable;

    private readonly TableParameters _fullFeaturedParameters = new()
    {
        TableRowContextMenuDisplayStyle = TableRowContextMenuDisplayStyle.DropDown,
        EnableFilters = true,
        PaginationHorizontalAlignment = ElementHorizontalAlignment.Center,
        ContentMenuTitle = "Table Actions",
        FilterPlaceholderText = "Search...",
        NoDataAvailableTitle = "No data available to display",
        RowsPerPageText = "Rows per page",
        Condensed = true
    };

    private async Task<TableDataCollection> FetchDataFullFeatures()
    {
        // var collection = TableDataCollectionFactory.FromDataSource(Enumerable.Empty<SampleTableCollectionItemModel>());
        // return Task.FromResult(collection);
       return await GenerateTableData(50);
    }  

    private async Task<TableDataCollection> GenerateTableData(int count, bool includeContextMenu = true)
    {
        await Task.Delay(5000);

        var collection = new List<SampleTableCollectionItemModel>();

        for (var i = 0; i < count; i++)
        {
            var guid = System.Guid.NewGuid().ToString("N");

            var contextMenu = includeContextMenu ? new List<MaviTableRowContextMenuItem>
            {
                new()
                {
                    Id = 1,
                    Key = "edit",
                    Title = "Edit",
                    Icon = "lni lni-file-pencil",
                    ElementVariant = ElementVariant.Text,
                    ThemeColorScheme = ThemeColorScheme.Primary,
                    ElementSize = ElementSize.Small
                },
                new()
                {
                    Id = 2,
                    Key = "delete",
                    Title = "Delete",
                    Icon = "lni lni-trash-3",
                    ElementVariant = ElementVariant.Text,
                    ThemeColorScheme = ThemeColorScheme.Alert,
                    ElementSize = ElementSize.Small
                },
                new()
                {
                    Id = 3,
                    Key = "details",
                    Title = "Details",
                    Icon = "lni lni-envelope-1",
                    ElementVariant = ElementVariant.Text,
                    ThemeColorScheme = ThemeColorScheme.Info,
                    ElementSize = ElementSize.Small
                }
            } : new List<MaviTableRowContextMenuItem>();

            collection.Add(new()
            {
                Id = i,
                Guid = guid,
                SampleEnum = GetRandomSampleEnum(i),
                SampleBoolean = i % 2 == 0,
                SampleInteger = i,
                SampleString = $"Item {i}",
                SampleDecimal = i + 0.5m,
                SampleDouble = i + 0.5,
                SampleDateTime = DateTime.Now.AddDays(-i),
                ContextMenu = contextMenu
            });
        }

        return TableDataCollectionFactory.FromDataSource(collection);
    }

    private static SampleEnum GetRandomSampleEnum(int seed)
    {
        var random = new Random(seed);
        var value = random.Next(0, 11);
        return (SampleEnum)value;
    }

    private Task<IEnumerable<MaviTableContextMenuItem>> ConstructMainContextMenu()
    {
        IEnumerable<MaviTableContextMenuItem> menu = new List<MaviTableContextMenuItem>()
        {
            new() { Id = "export", Title = "Export to CSV" },
            new() { Id = "import", Title = "Import Data" },
            new() { Id = "refresh", Title = "Refresh Table" },
            new() { Id = "settings", Title = "Table Settings" }
        };

        return Task.FromResult(menu);
    }

    private async Task OnMainContextMenuClick(MaviTableContextMenuItem item)
    {
        if (item.Id == "refresh")
        {
            if (_maviCssGridTable != null)
            {
               await _maviCssGridTable.Refresh();
            }
        }
    }

    private Task OnRowClick(TableClickData item)
    {
        return Task.CompletedTask;
    }

    private Task OnRowContextMenuClick(MaviTableRowContextMenuItem menuItem)
    {
        return Task.CompletedTask;
    }
}