@page "/"
@using Maviray.Blazor.Components.Material.Components.Spinner
@inherits SamplePageBase

<PageTitle>Home</PageTitle>

<div class="flex flex-col gap-4 p-4">
    <div class="flex gap-4">
        @foreach (var colorScheme in (ThemeColorScheme[])Enum.GetValues(typeof(ThemeColorScheme)))
        {
            <MaviSpinnerStar ThemeColorScheme="colorScheme"></MaviSpinnerStar>
        }
       
    </div>
    <div class="flex flex-col gap-2">
        @foreach (var colorScheme in (ThemeColorScheme[])Enum.GetValues(typeof(ThemeColorScheme)))
        {
            <div class="flex gap-4">
                <MaviSpinnerEqualizer ThemeColorScheme="colorScheme"
                                      ElementSize="ElementSize.Small"/>

                <MaviSpinnerEqualizer ThemeColorScheme="colorScheme"
                                      ElementSize="ElementSize.Regular"
                                      Lines="9"
                                      Label="Loading..."/>

                <MaviSpinnerEqualizer ThemeColorScheme="colorScheme"
                                      ElementSize="ElementSize.Large"
                                      AriaLabel="Submitting form"/>
            </div>
        }
        
    </div>
    <div class="flex gap-4">
        @foreach (var colorScheme in (ThemeColorScheme[])Enum.GetValues(typeof(ThemeColorScheme)))
        {
            <MaviSpinnerGrid ThemeColorScheme="colorScheme" />
        }
    </div>
    <div class="flex gap-4">
        @foreach (var colorScheme in (ThemeColorScheme[])Enum.GetValues(typeof(ThemeColorScheme)))
        {
            <MaviSpinnerStarRotate ThemeColorScheme="colorScheme" />
        }
    </div>
    <div class="flex gap-4">
        @foreach (var colorScheme in (ThemeColorScheme[])Enum.GetValues(typeof(ThemeColorScheme)))
        {
            <MaviSpinnerRoller ThemeColorScheme="colorScheme" />
        }
    </div>
</div>