@page "/"

@using Maviray.Blazor.Components.Material.Components.DataDisplay
@inherits SamplePageBase

<PageTitle>Home</PageTitle>

<div class="p-4 flex flex-col gap-2">
    <div>
        <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                    ElementSize="ElementSize.Large"
                    Title="Large Button"
                    TextTransform="TextTransform.UpperCase"
                    OnClick="DisplayModals">
        </MaviButton>
    </div>
    <MaviDialog @ref="_maviDialogDefault" DialogButtonClick="ReactToDialogButtonClick" MaviDialogBaseParameters="_maviDialogDefaultParameters"></MaviDialog>
    <MaviDialog @ref="_maviDialogPrimary" DialogButtonClick="ReactToDialogButtonClick" MaviDialogBaseParameters="_maviDialogPrimaryParameters"></MaviDialog>
    <MaviDialog @ref="_maviDialogSecondary" DialogButtonClick="ReactToDialogButtonClick" MaviDialogBaseParameters="_maviDialogSecondaryParameters"></MaviDialog>
    <MaviDialog @ref="_maviDialogSuccess" DialogButtonClick="ReactToDialogButtonClick" MaviDialogBaseParameters="_maviDialogSuccessParameters"></MaviDialog>
    <MaviDialog @ref="_maviDialogWarning" DialogButtonClick="ReactToDialogButtonClick" MaviDialogBaseParameters="_maviDialogWarningParameters"></MaviDialog>
    <MaviDialog @ref="_maviDialogAlert" DialogButtonClick="ReactToDialogButtonClick" MaviDialogBaseParameters="_maviDialogAlertParameters"></MaviDialog>
    <MaviDialog @ref="_maviDialogInfo" DialogButtonClick="ReactToDialogButtonClick" MaviDialogBaseParameters="_maviDialogInfoParameters"></MaviDialog>
    <MaviDialog @ref="_maviDialogDark" DialogButtonClick="ReactToDialogButtonClick" MaviDialogBaseParameters="_maviDialogDarkParameters"></MaviDialog>
    <MaviDialog @ref="_maviDialogLight" DialogButtonClick="ReactToDialogButtonClick" MaviDialogBaseParameters="_maviDialogLightParameters"></MaviDialog>
</div>

@code
{ 
    private MaviDialog? _maviDialogDefault;
    private MaviDialog? _maviDialogPrimary;
    private MaviDialog? _maviDialogSecondary;
    private MaviDialog? _maviDialogSuccess;
    private MaviDialog? _maviDialogWarning;
    private MaviDialog? _maviDialogAlert;
    private MaviDialog? _maviDialogInfo;
    private MaviDialog? _maviDialogDark;
    private MaviDialog? _maviDialogLight;

    private readonly MaviDialogBaseParameters? _maviDialogDefaultParameters = new()
    {
        ThemeColorScheme = ThemeColorScheme.Default, 
        Width = Tailwind.Theme.Dialog.WIDTH_SMALL
    };
    private readonly MaviDialogBaseParameters? _maviDialogPrimaryParameters = new()
    {
        ThemeColorScheme = ThemeColorScheme.Primary,
        Width = Tailwind.Theme.Dialog.WIDTH_MEDIUM
    };
    private readonly MaviDialogBaseParameters? _maviDialogSecondaryParameters = new()
    {
        ThemeColorScheme = ThemeColorScheme.Secondary,
        Width = Tailwind.Theme.Dialog.WIDTH_LARGE
    };
    private readonly MaviDialogBaseParameters? _maviDialogSuccessParameters = new()
    {
        ThemeColorScheme = ThemeColorScheme.Success,
        Width = Tailwind.Theme.Dialog.WIDTH_SMALL_FLUID
    };
    private readonly MaviDialogBaseParameters? _maviDialogWarningParameters = new()
    {
        ThemeColorScheme = ThemeColorScheme.Warning,
        Width = Tailwind.Theme.Dialog.WIDTH_MEDIUM_FLUID
    };
    private readonly MaviDialogBaseParameters? _maviDialogAlertParameters = new()
    {
        ThemeColorScheme = ThemeColorScheme.Alert,
        Width = Tailwind.Theme.Dialog.WIDTH_LARGE_FLUID
    };
    private readonly MaviDialogBaseParameters? _maviDialogInfoParameters = new()
    {
        ThemeColorScheme = ThemeColorScheme.Info,
        Width = Tailwind.Theme.Dialog.WIDTH_SMALL_FLUID
    };
    private readonly MaviDialogBaseParameters? _maviDialogDarkParameters = new()
    {
        ThemeColorScheme = ThemeColorScheme.Dark,
        Width = Tailwind.Theme.Dialog.WIDTH_MEDIUM_FLUID
    };
    private readonly MaviDialogBaseParameters? _maviDialogLightParameters = new()
    {
        ThemeColorScheme = ThemeColorScheme.Light,
        Width = Tailwind.Theme.Dialog.WIDTH_LARGE_FLUID
    };

    private async Task DisplayModals(MouseClickEventArgs args)
    {
        if (_maviDialogDefault != null)
        {
            await _maviDialogDefault.Display();
        }

        if (_maviDialogPrimary != null)
        {
            await _maviDialogPrimary.Display();
        }

        if (_maviDialogSecondary != null)
        {
            await _maviDialogSecondary.Display();
        }

        if (_maviDialogSuccess != null)
        {
            await _maviDialogSuccess.Display();
        }

        if (_maviDialogWarning != null)
        {
            await _maviDialogWarning.Display();
        }

        if (_maviDialogAlert != null)
        {
            await _maviDialogAlert.Display();
        }

        if (_maviDialogInfo != null)
        {
            await _maviDialogInfo.Display();
        }

        if (_maviDialogDark != null)
        {
            await _maviDialogDark.Display();
        }

        if (_maviDialogLight != null)
        {
            await _maviDialogLight.Display();
        }

    }

    private async Task ReactToDialogButtonClick(DialogButtonClickEventArgs args)
    {
        Logger?.LogInformation($"Dialog ID: {args.ComponentId}. Button Id: {args.MouseEventArgs.ButtonId}. Click Type: {args.ButtonClicked}");
    }
}
