        },

        new MenuItem
        {
            Title = "Settings",
            Icon = "lni lni-sliders-horizontal-square-2",
            BadgeColor = ThemeColorScheme.Info,
            BadgeText = "A"
        },

        new MenuItem
        {
            Title = "UI Component",
            Icon = "lni lni-bar-chart-4",
            BadgeColor = ThemeColorScheme.Alert,
            BadgeText = "A"
        },
        new MenuItemGroup()
        {
            Title = "Support",
            Icon = "lni lni-hand-taking-user",
            BadgeColor = ThemeColorScheme.Alert,
            BadgeText = "A",
