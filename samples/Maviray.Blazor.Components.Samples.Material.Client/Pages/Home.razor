                }
            ]
        }
    ];

    private Task<IEnumerable<IMenuItem>> GetMenuItems()
    {
        return Task.FromResult(_menuItems.AsEnumerable());
    }

    private Task ItemClicked(IMenuItem item)
    {
        _message = $"Clicked on Item: {item.Title} GUID: {item.Guid}";
        return Task.CompletedTask;
    }
}
