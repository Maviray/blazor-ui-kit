@page "/"
@using Maviray.Blazor.Components.Core.Models.Tables
@using Maviray.Blazor.Components.Material.Components.Tables
@using Maviray.Blazor.Components.Samples.Material.Client.Enums
@inherits SamplePageBase

<div class="p-4">
    <MaviInMemoryTable FetchData="FetchData"
               ConstructContextMenu="ConstructContextMenu"
               OnMainContextMenuClick="OnGridContextMenuClick"
               OnRowClick="OnRowClick"
               Parameters="_parameters"
               OnRowContextMenuClick="RowContextMenuClick">
    </MaviInMemoryTable>
</div>

@code{

    private readonly TableParameters _parameters = new();

    private static Task<TableDataCollection> FetchData()
    {
        var collection = new List<SampleTableCollectionItemModel>();

        for(var i = 0; i < 100; i++)
        {
            var guid = System.Guid.NewGuid().ToString("N");

            collection.Add(new()
            {
                Id = i,
                Guid = guid,
                SampleEnum = GetRandomSampleEnum(i),
                SampleBoolean = i % 2 == 0,
                SampleInteger = i,
                SampleString = guid,
                SampleDecimal = i + 0.5m,
                SampleDouble = i + 0.5,
                SampleDateTime = DateTime.Now.AddDays(i),
                ContextMenu = new List<MaviTableRowContextMenuItem>
                {
                    new()
                    {
                        Title = "Action 1"
                    },
                    new()
                    {
                        Title = "Action 2",
                        Disabled = true
                    },
                    new()
                    {
                        Title = "Action 3"
                    }
                }

            });
        }

        return Task.FromResult(TableDataCollectionFactory.FromDataSource(collection));
    }

    private Task<IEnumerable<MaviTableContextMenuItem>> ConstructContextMenu()
    {
        IEnumerable<MaviTableContextMenuItem> menu = new List<MaviTableContextMenuItem>()
        {
            new MaviTableContextMenuItem() { Id = System.Guid.NewGuid().ToString(), Title = "Main Context Action One" },
            new MaviTableContextMenuItem() { Id = System.Guid.NewGuid().ToString(), Title = "Main Context Action Two" },
            new MaviTableContextMenuItem() { Id = System.Guid.NewGuid().ToString(), Title = "Main Context Action Three" },
        };
       
        return Task.FromResult(menu);
    }

    private Task OnGridContextMenuClick(MaviTableContextMenuItem item)
    {
        return Task.CompletedTask;
    }

    private Task OnRowClick(TableClickData item)
    {
        return Task.CompletedTask;
    }

    private Task RowContextMenuClick(MaviTableRowContextMenuItem menuItem)
    {
        return Task.CompletedTask;
    }

    public static SampleEnum GetRandomSampleEnum(int seed)
    {
        var random = new Random(seed);

        var value = random.Next(0, 11);

        return (SampleEnum)value;
    }
}