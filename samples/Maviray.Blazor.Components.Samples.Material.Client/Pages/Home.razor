@page "/"
@using Maviray.Blazor.Components.Material.Components.DataDisplay
@using Maviray.Blazor.Components.Material.Components.DataDisplay.MaviToastr
@inherits SamplePageBase

<PageTitle>Home</PageTitle>

<MaviToastr Notifications="_toasts"
            Position="_sampleToastrDemoModel.ElementRelativePosition"
            AutoDismiss="true"
            MaxVisible="5"
            OnClose="HandleClose" />
            
            
<div class="mx-auto max-w-7xl flex flex-col p-4">
    <EditForm FormName="DemoMaviToastr" Model="@_sampleToastrDemoModel" OnValidSubmit="OnValidFormSubmit">
        <DataAnnotationsValidator />
        <div class="flex flex-col gap-4">
            <div class="flex flex-col lg:flex-row! gap-2">
                <MaviDropdown TItem="ElementVariant" TValue="ElementVariant"
                              @bind-Value="_sampleToastrDemoModel.ElementVariant"
                              Items="_elementVariants"
                              ElementSize="ElementSize.Small"
                              StartIcon="lni lni-gears-3"
                              Width="w-full" />

                <MaviDropdown TItem="ThemeColorScheme" TValue="ThemeColorScheme"
                              @bind-Value="_sampleToastrDemoModel.ThemeColorScheme"
                              Items="_colorSchemes"
                              ElementSize="ElementSize.Small"
                              StartIcon="lni lni-gears-3"
                              Width="w-full" />

                <MaviDropdown TItem="ElementSize" TValue="ElementSize"
                              @bind-Value="_sampleToastrDemoModel.ElementSize"
                              Items="_size"
                              ElementSize="ElementSize.Small"
                              StartIcon="lni lni-gears-3"
                              Width="w-full" />

                <MaviDropdown TItem="ElementRelativePosition" TValue="ElementRelativePosition"
                              @bind-Value="_sampleToastrDemoModel.ElementRelativePosition"
                              Items="_relativePosition"
                              ElementSize="ElementSize.Small"
                              StartIcon="lni lni-gears-3"
                              Width="w-full" />

                <MaviInputInteger @bind-Value="_sampleToastrDemoModel.Duration"
                                  ElementSize="ElementSize.Small"
                                  StartIcon="lni lni-android-old"
                                  Width="w-full" />
            </div>
            <div>
                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementSize="ElementSize.Regular"
                            Title="Display"
                            ButtonRole="ButtonRole.Submit"
                            ElementVariant="ElementVariant.Outlined"
                            TextTransform="TextTransform.Capitalize">

                </MaviButton>
            </div>
        </div>
    </EditForm>
</div>

@code {

    private readonly SampleToastrDemoModel _sampleToastrDemoModel = new();

    private List<MaviToastNotification> _toasts = new();

    private readonly IEnumerable<ElementVariant> _elementVariants = Enum.GetValues<ElementVariant>();
    private readonly IEnumerable<ThemeColorScheme> _colorSchemes = Enum.GetValues<ThemeColorScheme>();
    private readonly IEnumerable<ElementSize> _size = Enum.GetValues<ElementSize>();
    private readonly IEnumerable<ElementRelativePosition> _relativePosition = Enum.GetValues<ElementRelativePosition>();

    private void OnValidFormSubmit(EditContext context)
    {
        var id = Guid.NewGuid().ToString("N");
        _toasts.Insert(0, new MaviToastNotification(
            Id: id,
            Title: "Saved",
            Message: "Your changes were saved successfully.",
            ThemeColorScheme: _sampleToastrDemoModel.ThemeColorScheme,
            ElementVariant: _sampleToastrDemoModel.ElementVariant,
            ElementSize: _sampleToastrDemoModel.ElementSize,
            CreatedAt: DateTimeOffset.UtcNow,
            Duration: TimeSpan.FromSeconds(_sampleToastrDemoModel.Duration)
        ));
    }

    private Task HandleClose(string id)
    {
        _toasts = _toasts.Where(t => t.Id != id).ToList();
        return Task.CompletedTask;
    }
}