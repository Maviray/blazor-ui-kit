@page "/"

@inherits SamplePageBase

<PageTitle>Home</PageTitle>

<div class="p-8 space-y-8">
    <h3>Slider Demo</h3>

    <div class="space-y-8 p-4">
        <div>
            <h4>Primary Slider - Small</h4>
            <MaviSlider @bind-Value="small"
                Size="ElementSize.Small" 
                Color="ThemeColorScheme.Primary" />
            <p>Value: @small</p>
        </div>
        <div>
            <h4>Primary Slider - Regular</h4>
            <MaviSlider @bind-Value="regular"
                Size="ElementSize.Regular" 
                Color="ThemeColorScheme.Primary" />
            <p>Value: @regular</p>
        </div>
        <div>
            <h4>Primary Slider - Large</h4>
            <MaviSlider @bind-Value="large"
                Size="ElementSize.Large" 
                Color="ThemeColorScheme.Primary" />
            <p>Value: @large</p>
        </div>
        <div>
            <h4>Default Slider - Regular</h4>
            <MaviSlider @bind-Value="primary"
                        Size="ElementSize.Regular"
                        Color="ThemeColorScheme.Default" />
            <p>Value: @primary</p>
        </div>
        <div>
            <h4>Primary Slider - Regular</h4>
            <MaviSlider @bind-Value="secondary"
                        Size="ElementSize.Regular"
                        Color="ThemeColorScheme.Primary" />
            <p>Value: @secondary</p>
        </div>
        <div>
            <h4>Secondary Slider - Regular</h4>
            <MaviSlider @bind-Value="defaultColor"
                        Size="ElementSize.Regular"
                        Color="ThemeColorScheme.Secondary" />
            <p>Value: @defaultColor</p>
        </div>
        
        <div>
            <h4>Success Slider - Regular</h4>
            <MaviSlider @bind-Value="success"
                        Size="ElementSize.Regular"
                        Color="ThemeColorScheme.Success" />
            <p>Value: @success</p>
        </div>
        <div>
            <h4>Alert Slider - Regular</h4>
            <MaviSlider @bind-Value="alert"
                        Size="ElementSize.Regular"
                        Color="ThemeColorScheme.Alert" />
            <p>Value: @alert</p>
        </div>
        <div>
            <h4>Warning Slider - Regular</h4>
            <MaviSlider @bind-Value="warning"
                        Size="ElementSize.Regular"
                        Color="ThemeColorScheme.Warning" />
            <p>Value: @warning</p>
        </div>
        
        
        <div>
            <h4>Info Slider - Regular</h4>
            <MaviSlider @bind-Value="info"
                        Size="ElementSize.Regular"
                        Color="ThemeColorScheme.Info" />
            <p>Value: @info</p>
        </div>
        <div>
            <h4>Dark Slider - Regular</h4>
            <MaviSlider @bind-Value="dark"
                        Size="ElementSize.Regular"
                        Color="ThemeColorScheme.Dark" />
            <p>Value: @dark</p>
        </div>
        <div>
            <h4>Light Slider - Regular</h4>
            <MaviSlider @bind-Value="lite"
                        Size="ElementSize.Regular"
                        Color="ThemeColorScheme.Light" />
            <p>Value: @lite</p>
        </div>
    </div>
</div>

@code {
    private double small = 25;
    private double regular = 50;
    private double large = 75;
    
    private double primary = 5;
    private double secondary = 5;
    private double defaultColor = 5;
    private double success = 5;
    private double alert = 5;
    private double warning = 5;
    private double info = 5;
    private double dark = 5;
    private double lite = 5;
}