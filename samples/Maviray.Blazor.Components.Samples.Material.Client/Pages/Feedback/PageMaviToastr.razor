<!-- Code Examples Section -->
<section class="space-y-6">
    <div class="space-y-2">
        <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Code Examples</h2>
        <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
            Sample code snippets demonstrating common usage patterns.
        </p>
    </div>

    <!-- Basic Usage Example -->
    <div class="space-y-3">
        <h3 class="@Tailwind.Theme.Typography.TITLE_LARGE">Basic Usage</h3>
        <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
            <pre class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-100"><code>&lt;MaviToastr Notifications="_toasts"
            Position="ElementRelativePosition.CenterTop"
            AutoDismiss="true"
            MaxVisible="5"
            OnClose="HandleClose" /&gt;

@@code {
    private List&lt;MaviToastNotification&gt; _toasts = [];

    private Task HandleClose(string id)
    {
        _toasts = _toasts.Where(t =&gt; t.Id != id).ToList();
        return Task.CompletedTask;
    }
}</code></pre>
        </div>
    </div>

    <!-- Success Notification Example -->
    <div class="space-y-3">
        <h3 class="@Tailwind.Theme.Typography.TITLE_LARGE">Success Notification</h3>
        <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
            <pre class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-100"><code>private void ShowSuccess()
{
    var id = Guid.NewGuid().ToString("N");
    _toasts.Add(new MaviToastNotification(
        Id: id,
        Title: "Success!",
        Message: "Your operation completed successfully.",
        ThemeColorScheme: ThemeColorScheme.Success,
        ElementVariant: ElementVariant.Filled,
        Duration: TimeSpan.FromSeconds(5)
    ));
}</code></pre>
        </div>
    </div>

    <!-- Error Notification Example -->
    <div class="space-y-3">
        <h3 class="@Tailwind.Theme.Typography.TITLE_LARGE">Error Notification</h3>
        <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
            <pre class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-100"><code>private void ShowError()
{
    var id = Guid.NewGuid().ToString("N");
    _toasts.Add(new MaviToastNotification(
        Id: id,
        Title: "Error",
        Message: "Something went wrong. Please try again.",
        ThemeColorScheme: ThemeColorScheme.Error,
        ElementVariant: ElementVariant.Outlined,
        Duration: TimeSpan.FromSeconds(10),
        ShowProgress: true
    ));
}</code></pre>
        </div>
    </div>

    <!-- Warning Notification Example -->
    <div class="space-y-3">
        <h3 class="@Tailwind.Theme.Typography.TITLE_LARGE">Warning Notification</h3>
