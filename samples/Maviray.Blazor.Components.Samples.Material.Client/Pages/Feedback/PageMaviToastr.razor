        ThemeColorScheme: ThemeColorScheme.Info,
        ElementVariant: ElementVariant.Outlined,
        ElementSize: ElementSize.Regular,
        Duration: null, // No auto-dismiss
        Closable: true
    ));
}</code></pre>
        </div>
    </div>

    <!-- Custom Position Example -->
    <div class="space-y-3">
        <h3 class="@Tailwind.Theme.Typography.TITLE_LARGE">Custom Position Configuration</h3>
        <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
            <pre class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-100"><code>&lt;!-- Top Right Position --&gt;
&lt;MaviToastr Notifications="_toasts"
            Position="ElementRelativePosition.TopRight"
            AutoDismiss="true"
            NewestOnTop="false"
            MaxVisible="3"
            OnClose="HandleClose" /&gt;

&lt;!-- Bottom Left Position --&gt;
&lt;MaviToastr Notifications="_toasts"
            Position="ElementRelativePosition.BottomLeft"
            AutoDismiss="true"
            OnClose="HandleClose" /&gt;</code></pre>
        </div>
    </div>

    <!-- Multiple Toasts Example -->
    <div class="space-y-3">
        <h3 class="@Tailwind.Theme.Typography.TITLE_LARGE">Adding Multiple Toasts at Once</h3>
        <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
            <pre class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-100"><code>private void ShowMultipleNotifications()
{
    var notifications = new[]
    {
        new MaviToastNotification(
            Id: Guid.NewGuid().ToString("N"),
            Message: "Processing started...",
            ThemeColorScheme: ThemeColorScheme.Info,
            Duration: TimeSpan.FromSeconds(3)
        ),
        new MaviToastNotification(
            Id: Guid.NewGuid().ToString("N"),
            Message: "Upload in progress...",
            ThemeColorScheme: ThemeColorScheme.Primary,
            Duration: TimeSpan.FromSeconds(5)
        ),
        new MaviToastNotification(
            Id: Guid.NewGuid().ToString("N"),
            Title: "Complete",
            Message: "All tasks finished successfully!",
            ThemeColorScheme: ThemeColorScheme.Success,
            Duration: TimeSpan.FromSeconds(4)
        )
    };

    _toasts.AddRange(notifications);
}</code></pre>
        </div>
    </div>

    <!-- Different Sizes Example -->
    <div class="space-y-3">
        <h3 class="@Tailwind.Theme.Typography.TITLE_LARGE">Different Toast Sizes</h3>
        <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
            <pre class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-100"><code>// Small size toast
_toasts.Add(new MaviToastNotification(
    Id: Guid.NewGuid().ToString("N"),
    Message: "Small toast notification",
    ElementSize: ElementSize.Small,
    Duration: TimeSpan.FromSeconds(3)
));

// Regular size toast (default)
_toasts.Add(new MaviToastNotification(
    Id: Guid.NewGuid().ToString("N"),
    Title: "Regular Toast",
    Message: "This is a regular-sized notification",
    ElementSize: ElementSize.Regular,
    Duration: TimeSpan.FromSeconds(5)
));

// Large size toast
_toasts.Add(new MaviToastNotification(
    Id: Guid.NewGuid().ToString("N"),
    Title: "Large Important Notice",
    Message: "This is a large notification with more emphasis",
    ElementSize: ElementSize.Large,
    Duration: TimeSpan.FromSeconds(7)
));</code></pre>
        </div>
    </div>
</section>
</div>

@code {

    private readonly SampleToastrDemoModel _sampleToastrDemoModel = new();

    private List<MaviToastNotification> _toasts = [];

    private readonly IEnumerable<ElementVariant> _elementVariants = Enum.GetValues<ElementVariant>();
    private readonly IEnumerable<ThemeColorScheme> _colorSchemes = Enum.GetValues<ThemeColorScheme>();
    private readonly IEnumerable<ElementSize> _size = Enum.GetValues<ElementSize>();
    private readonly IEnumerable<ElementRelativePosition> _relativePosition = Enum.GetValues<ElementRelativePosition>();

    private void OnValidFormSubmit(EditContext context)
    {
        var id = Guid.NewGuid().ToString("N");
        _toasts.Insert(0, new(
            id,
            _sampleToastrDemoModel.Title,
            _sampleToastrDemoModel.Text,
            _sampleToastrDemoModel.ThemeColorScheme,
            _sampleToastrDemoModel.ElementVariant,
            _sampleToastrDemoModel.ElementSize,
            DateTimeOffset.UtcNow,
            TimeSpan.FromSeconds(_sampleToastrDemoModel.Duration),
            ShowProgress: _sampleToastrDemoModel.ShowProgress
        ));
    }

    private Task HandleClose(string id)
    {
        _toasts = _toasts.Where(t => t.Id != id).ToList();
        return Task.CompletedTask;
    }

}