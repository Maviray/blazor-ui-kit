@page "/PageMaviToastr"
@using Maviray.Blazor.Components.Material.Components.DataDisplay
@using Maviray.Blazor.Components.Material.Components.DataDisplay.MaviToastr
@inherits SamplePageBase

<PageTitle>MaviToastr</PageTitle>

<MaviToastr Notifications="_toasts"
            Position="_sampleToastrDemoModel.ElementRelativePosition"
            AutoDismiss="true"
            MaxVisible="5"
            OnClose="HandleClose"/>

<div class="mx-auto max-w-7xl flex flex-col p-4 space-y-8">

<!-- Interactive Demo Section -->
<section class="space-y-4">
    <div class="space-y-2">
        <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Interactive Demo</h2>
        <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
            Configure and test the MaviToastr component with different parameters.
        </p>
    </div>

    <EditForm FormName="DemoMaviToastr" Model="@_sampleToastrDemoModel" OnValidSubmit="OnValidFormSubmit">
        <DataAnnotationsValidator/>
        <div class="flex flex-col gap-4">
            <div class="flex flex-col lg:flex-row! gap-2">
                <div class="basis-1/3 flex flex-col">
                    <MaviInputStringNullable @bind-Value="_sampleToastrDemoModel.Title"
                                             ElementSize="ElementSize.Regular"
                                             StartIcon="lni lni-android-old"
                                             Width="w-full"/>
                </div>
                <div class="basis-2/3 flex flex-col gap-2">
                    <MaviInputStringNullable @bind-Value="_sampleToastrDemoModel.Text"
                                             ElementSize="ElementSize.Regular"
                                             StartIcon="lni lni-android-old"
                                             Width="w-full"/>
                </div>
            </div>
            <div class="flex flex-col lg:flex-row! gap-2">
                <MaviDropdown TItem="ElementVariant" TValue="ElementVariant"
                              @bind-Value="_sampleToastrDemoModel.ElementVariant"
                              Items="_elementVariants"
                              ElementSize="ElementSize.Small"
                              StartIcon="lni lni-gears-3"
                              Width="w-full"/>

                <MaviDropdown TItem="ThemeColorScheme" TValue="ThemeColorScheme"
                              @bind-Value="_sampleToastrDemoModel.ThemeColorScheme"
                              Items="_colorSchemes"
                              ElementSize="ElementSize.Small"
                              StartIcon="lni lni-gears-3"
                              Width="w-full"/>

                <MaviDropdown TItem="ElementSize" TValue="ElementSize"
                              @bind-Value="_sampleToastrDemoModel.ElementSize"
                              Items="_size"
                              ElementSize="ElementSize.Small"
                              StartIcon="lni lni-gears-3"
                              Width="w-full"/>
            </div>
            <div class="flex flex-col lg:flex-row! gap-2">
                <MaviDropdown TItem="ElementRelativePosition" TValue="ElementRelativePosition"
                              @bind-Value="_sampleToastrDemoModel.ElementRelativePosition"
                              Items="_relativePosition"
                              ElementSize="ElementSize.Small"
                              StartIcon="lni lni-gears-3"
                              Width="w-full"/>

                <MaviInputInteger @bind-Value="_sampleToastrDemoModel.Duration"
                                  ElementSize="ElementSize.Small"
                                  StartIcon="lni lni-android-old"
                                  Width="w-full"/>
                <MaviCheckbox @bind-Value="_sampleToastrDemoModel.ShowProgress" ElementSize="ElementSize.Large" Label="Show Progress"/>
            </div>
            <div>
                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementSize="ElementSize.Regular"
                            Title="Display Toast"
                            ButtonRole="ButtonRole.Submit"
                            ElementVariant="ElementVariant.Outlined"
                            TextTransform="TextTransform.Capitalize">
                </MaviButton>
            </div>
        </div>
    </EditForm>
</section>

<!-- Component Parameters Section -->
<section class="space-y-6">
    <div class="space-y-2">
        <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Component Parameters</h2>
        <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
            Complete list of all available parameters and their descriptions for the MaviToastr component.
        </p>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 border border-gray-200 rounded-lg">
            <thead class="bg-gray-50">
            <tr>
                <th scope="col" class="px-6 py-3 text-left @Tailwind.Theme.Typography.LABEL_MEDIUM text-gray-700 uppercase tracking-wider">
                    Parameter
                </th>
                <th scope="col" class="px-6 py-3 text-left @Tailwind.Theme.Typography.LABEL_MEDIUM text-gray-700 uppercase tracking-wider">
                    Type
                </th>
                <th scope="col" class="px-6 py-3 text-left @Tailwind.Theme.Typography.LABEL_MEDIUM text-gray-700 uppercase tracking-wider">
                    Default
                </th>
                <th scope="col" class="px-6 py-3 text-left @Tailwind.Theme.Typography.LABEL_MEDIUM text-gray-700 uppercase tracking-wider">
                    Description
                </th>
            </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
            <tr>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_MEDIUM font-mono text-purple-600">
                    Notifications
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    IReadOnlyList&lt;MaviToastNotification&gt;
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    Required
                </td>
                <td class="px-6 py-4 @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    The list of notifications to display. This parameter is required.
                </td>
            </tr>
            <tr>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_MEDIUM font-mono text-purple-600">
                    Position
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    ElementRelativePosition
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    CenterTop
                </td>
                <td class="px-6 py-4 @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    Screen position where toasts appear (TopLeft, TopRight, CenterTop, CenterBottom, BottomLeft, BottomRight).
                </td>
            </tr>
            <tr>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_MEDIUM font-mono text-purple-600">
                    AutoDismiss
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    bool
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    true
                </td>
                <td class="px-6 py-4 @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    If true, toasts with a Duration will automatically close after the specified time. Parent must handle OnClose to remove items.
                </td>
            </tr>
            <tr>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_MEDIUM font-mono text-purple-600">
                    NewestOnTop
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    bool
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    true
                </td>
                <td class="px-6 py-4 @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    If true, newer notifications appear at the top of the stack. If false, they appear at the bottom.
                </td>
            </tr>
            <tr>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_MEDIUM font-mono text-purple-600">
                    MaxVisible
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    int
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    5
                </td>
                <td class="px-6 py-4 @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    Maximum number of toasts to display at once. Older toasts beyond this limit won't be shown.
                </td>
            </tr>
            <tr>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_MEDIUM font-mono text-purple-600">
                    OnClose
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    EventCallback&lt;string&gt;
                </td>
                <td class="px-6 py-4 whitespace-nowrap @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    -
                </td>
                <td class="px-6 py-4 @Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                    Event fired when a toast is closed (via user click or auto-dismiss). Receives the toast ID. Parent should remove the notification from the list.
                </td>
            </tr>
            </tbody>
        </table>
    </div>
</section>

<!-- MaviToastNotification Record Parameters Section -->
