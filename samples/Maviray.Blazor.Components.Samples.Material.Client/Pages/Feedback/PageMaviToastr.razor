    <div class="space-y-2">
        <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">MaviToastNotification Record</h2>
        <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
