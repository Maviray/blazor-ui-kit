    ));
}</code></pre>
        </div>
    </div>

    <!-- Info Notification (No Auto-Dismiss) Example -->
    <div class="space-y-3">
        <h3 class="@Tailwind.Theme.Typography.TITLE_LARGE">Info Notification (Manual Dismiss Only)</h3>
        <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
            <pre class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-100"><code>private void ShowInfo()
{
    var id = Guid.NewGuid().ToString("N");
    _toasts.Add(new MaviToastNotification(
        Id: id,
        Title: "Important Information",
