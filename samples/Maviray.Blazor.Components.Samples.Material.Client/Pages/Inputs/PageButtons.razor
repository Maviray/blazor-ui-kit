                            OnClick="OnButtonClickAsync">
                </MaviButton>
                <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                            ElementSize="ElementSize.Regular"
                            ElementVariant="ElementVariant.Text"
                            Title="Secondary"
                            TextTransform="TextTransform.Capitalize"
                            StartIcon="lni lni-chevron-left"
                            SpinnerText="Working..."
