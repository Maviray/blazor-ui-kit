@code
{
    private string GetButtonTitle(ThemeColorScheme buttonType, ElementSize elementSize)
    {
        return $"{buttonType} {elementSize}";
    }

    private async Task OnButtonClickAsync(MouseClickEventArgs mouseEventArgs)
    {
        Logger?.LogInformation("Button Click! ID: {ButtonId} Introduce 4s delay to demo inline spinner effect.", mouseEventArgs.ButtonId);
        await Task.Delay(4000);
        Logger?.LogInformation("Button Click! ID: {ButtonId} End 4s delay.", mouseEventArgs.ButtonId);
    }
}
