                            TextTransform="TextTransform.Capitalize"
                            StartIcon="lni lni-chevron-left"
                            SpinnerText="Working..."
                            ShowSpinner="true"
                            OnClick="OnButtonClickAsync">
                </MaviButton>
                <MaviButton ThemeColorScheme="ThemeColorScheme.Light"
                            ElementSize="ElementSize.Regular"
                            Title="Light"
                            TextTransform="TextTransform.Capitalize"
                            StartIcon="lni lni-chevron-left"
                            SpinnerText="Working..."
                            ShowSpinner="true"
                            OnClick="OnButtonClickAsync">
                </MaviButton>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 border border-gray-200 rounded-lg p-4")">
                <code class="text-purple-600">
                    &lt;MaviButton StartIcon="lni lni-chevron-left" ShowSpinner="true" SpinnerText="Working..." ... /&gt;
                </code>
            </div>
        </div>

        <!-- Outlined Colors -->
        <div class="space-y-3">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Outlined Variant - All Colors</h3>
            <div class="flex gap-3 flex-wrap">
