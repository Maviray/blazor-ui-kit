                <MaviButton ThemeColorScheme="ThemeColorScheme.Success"
                            ElementSize="ElementSize.Regular"
                            Title="Success"
                            TextTransform="TextTransform.Capitalize"
                            StartIcon="lni lni-chevron-left"
                            SpinnerText="Working..."
                            ShowSpinner="true"
