                            ElementVariant="ElementVariant.Outlined"
                            Title="Success"
                            TextTransform="TextTransform.Capitalize"
                            StartIcon="lni lni-chevron-left"
                            SpinnerText="Working..."
                            ShowSpinner="true"
                            OnClick="OnButtonClickAsync">
                </MaviButton>
            </div>
            <div class="flex gap-3 flex-wrap">
                <MaviButton ThemeColorScheme="ThemeColorScheme.Alert"
                            ElementSize="ElementSize.Regular"
                            ElementVariant="ElementVariant.Outlined"
                            Title="Danger"
                            TextTransform="TextTransform.Capitalize"
                            StartIcon="lni lni-chevron-left"
                            SpinnerText="Working..."
