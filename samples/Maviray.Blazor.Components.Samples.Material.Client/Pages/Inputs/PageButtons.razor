@page "/PageButtons"
@inherits SamplePageBase
@using Maviray.Blazor.Components.Core.EventArgs
@using Maviray.Blazor.Components.Core.Utilities
@using Maviray.Blazor.Components.Material.Components.Inputs

<PageTitle>Buttons</PageTitle>


<div class="p-8 max-w-7xl mx-auto space-y-12">

    <!-- Page Header -->
    <div class="space-y-2">
        <h1 class="@Tailwind.Theme.Typography.DISPLAY_MEDIUM">Button Components</h1>
        <p class="@Tailwind.Theme.Typography.BODY_LARGE text-gray-600">
            Comprehensive examples of button component variations including sizes, variants, colors, states, and icon usage.
        </p>
    </div>

    <!-- Section 1: Size Variations -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Size Variations</h2>
            <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
                Buttons support three sizes: Large, Regular, and Small. Choose the appropriate size based on context and hierarchy.
            </p>
        </div>

        <!-- Primary Sizes -->
        <div class="space-y-3">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Primary Buttons</h3>
            <div class="flex gap-4 items-center flex-wrap">
                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementSize="ElementSize.Large"
                            Title="Large Button"
                            TextTransform="TextTransform.UpperCase"
                            OnClick="OnButtonClickAsync">
                </MaviButton>

                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementSize="ElementSize.Regular"
                            Title="Regular Button"
                            TextTransform="TextTransform.UpperCase"
                            OnClick="OnButtonClickAsync">
                </MaviButton>

                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementSize="ElementSize.Small"
                            Title="Small Button"
                            TextTransform="TextTransform.UpperCase"
                            OnClick="OnButtonClickAsync">
                </MaviButton>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 border border-gray-200 rounded-lg p-4")">
                <code class="text-purple-600">
                    &lt;MaviButton ElementSize="ElementSize.Large" ... /&gt;<br />
                    &lt;MaviButton ElementSize="ElementSize.Regular" ... /&gt;<br />
                    &lt;MaviButton ElementSize="ElementSize.Small" ... /&gt;
                </code>
            </div>
        </div>

        <!-- Secondary Sizes -->
        <div class="space-y-3">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Secondary Buttons</h3>
            <div class="flex gap-4 items-center flex-wrap">
                <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                            ElementSize="ElementSize.Large"
                            Title="Large Button"
                            TextTransform="TextTransform.LowerCase"
                            OnClick="OnButtonClickAsync">
                </MaviButton>

                <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                            ElementSize="ElementSize.Regular"
                            Title="Regular Button"
                            TextTransform="TextTransform.LowerCase"
                            OnClick="OnButtonClickAsync">
                </MaviButton>

                <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                            ElementSize="ElementSize.Small"
                            Title="Small Button"
                            TextTransform="TextTransform.LowerCase"
                            OnClick="OnButtonClickAsync">
                </MaviButton>
            </div>
        </div>
    </section>

    <!-- Section 2: Variant Styles -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Variant Styles</h2>
            <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
                Three visual styles: Filled (default), Outlined, and Text. Each serves different visual hierarchies.
            </p>
        </div>

        <!-- Filled Variant (default) -->
        <div class="space-y-3">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Filled Variant (Default)</h3>
            <p class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                Highest emphasis. Use for primary actions.
            </p>
            <div class="flex gap-4 items-center flex-wrap">
                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementSize="ElementSize.Regular"
                            Title="Primary Filled"
                            OnClick="OnButtonClickAsync">
                </MaviButton>
                <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                            ElementSize="ElementSize.Regular"
                            Title="Secondary Filled"
                            OnClick="OnButtonClickAsync">
                </MaviButton>
            </div>
        </div>

        <!-- Outlined Variant -->
        <div class="space-y-3">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Outlined Variant</h3>
            <p class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                Medium emphasis. Use for secondary actions.
            </p>
            <div class="flex gap-4 items-center flex-wrap">
                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementVariant="ElementVariant.Outlined"
                            ElementSize="ElementSize.Large"
                            Title="Large Outlined"
                            OnClick="OnButtonClickAsync">
                </MaviButton>

                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementVariant="ElementVariant.Outlined"
                            ElementSize="ElementSize.Regular"
                            Title="Regular Outlined"
                            OnClick="OnButtonClickAsync">
                </MaviButton>

                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementVariant="ElementVariant.Outlined"
                            ElementSize="ElementSize.Small"
                            Title="Small Outlined"
                            OnClick="OnButtonClickAsync">
                </MaviButton>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 border border-gray-200 rounded-lg p-4")">
                <code class="text-purple-600">
                    &lt;MaviButton ElementVariant="ElementVariant.Outlined" ... /&gt;
                </code>
            </div>
        </div>

        <div class="flex gap-4 items-center flex-wrap">
            <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                        ElementVariant="ElementVariant.Outlined"
                        ElementSize="ElementSize.Large"
                        Title="Large Outlined"
                        OnClick="OnButtonClickAsync">
            </MaviButton>

            <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                        ElementVariant="ElementVariant.Outlined"
                        ElementSize="ElementSize.Regular"
                        Title="Regular Outlined"
                        OnClick="OnButtonClickAsync">
            </MaviButton>

            <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                        ElementVariant="ElementVariant.Outlined"
                        ElementSize="ElementSize.Small"
                        Title="Small Outlined"
                        OnClick="OnButtonClickAsync">
            </MaviButton>
        </div>

        <!-- Text Variant -->
        <div class="space-y-3">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Text Variant</h3>
            <p class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                Lowest emphasis. Use for tertiary actions or inline links.
            </p>
            <div class="flex gap-4 items-center flex-wrap">
                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementVariant="ElementVariant.Text"
                            ElementSize="ElementSize.Large"
                            Title="Large Text"
                            OnClick="OnButtonClickAsync">
                </MaviButton>

                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementVariant="ElementVariant.Text"
                            ElementSize="ElementSize.Regular"
                            Title="Regular Text"
                            OnClick="OnButtonClickAsync">
                </MaviButton>

                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementVariant="ElementVariant.Text"
                            ElementSize="ElementSize.Small"
                            Title="Small Text"
                            OnClick="OnButtonClickAsync">
                </MaviButton>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 border border-gray-200 rounded-lg p-4")">
                <code class="text-purple-600">
                    &lt;MaviButton ElementVariant="ElementVariant.Text" ... /&gt;
                </code>
            </div>
        </div>

        <div class="flex gap-4 items-center flex-wrap">
            <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                        ElementVariant="ElementVariant.Text"
                        ElementSize="ElementSize.Large"
                        Title="Large Text"
                        OnClick="OnButtonClickAsync">
            </MaviButton>

            <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                        ElementVariant="ElementVariant.Text"
                        ElementSize="ElementSize.Regular"
                        Title="Regular Text"
                        OnClick="OnButtonClickAsync">
            </MaviButton>

            <MaviButton ThemeColorScheme="ThemeColorScheme.Secondary"
                        ElementVariant="ElementVariant.Text"
                        ElementSize="ElementSize.Small"
                        Title="Small Text"
                        OnClick="OnButtonClickAsync">
            </MaviButton>
        </div>
    </section>

    <!-- Section 3: Color Schemes -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Color Schemes</h2>
            <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
                Comprehensive color palette for different contexts and semantic meanings.
            </p>
        </div>

        <!-- Filled Colors -->
        <div class="space-y-3">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Filled Buttons with Icons & Spinners</h3>
            <p class="@Tailwind.Theme.Typography.BODY_SMALL text-gray-600">
                All available color schemes with loading state demonstration.
            </p>
            <div class="flex gap-3 flex-wrap">
                <MaviButton ThemeColorScheme="ThemeColorScheme.Default"
                            ElementSize="ElementSize.Regular"
                            Title="Default"
                            TextTransform="TextTransform.Capitalize"
                            StartIcon="lni lni-chevron-left"
                            SpinnerText="Working..."
                            ShowSpinner="true"
                            OnClick="OnButtonClickAsync">
                </MaviButton>
                <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                            ElementSize="ElementSize.Regular"
                            Title="Primary"
                            TextTransform="TextTransform.Capitalize"
                            StartIcon="lni lni-chevron-left"
