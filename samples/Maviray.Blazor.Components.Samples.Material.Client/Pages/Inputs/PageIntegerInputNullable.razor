@page "/PageIntegerInputNullable"
@inherits SamplePageBase
@using Maviray.Blazor.Components.Core.Constants
@using Maviray.Blazor.Components.Core.EventArgs
@using Maviray.Blazor.Components.Core.Utilities
@using Maviray.Blazor.Components.Material.Components.Inputs

<PageTitle>Integer Input Nullable</PageTitle>


<div class="p-6 max-w-7xl mx-auto">
    <!-- Page Header -->
    <div class="mb-8">
        <h1 class="@CssManager.Combine(Tailwind.Theme.Typography.DISPLAY_MEDIUM, "mb-2")">MaviInputIntegerNullable Component</h1>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_LARGE, "text-gray-600")">
            Comprehensive showcase demonstrating all available parameters, use cases, and formatting options for the MaviInputIntegerNullable component.
            This component supports nullable integers, allowing users to leave fields empty (null) instead of defaulting to zero.
        </p>
    </div>

    <!-- Nullable vs Non-Nullable Info Box -->
    <div class="mb-8 p-6 bg-blue-50 border-l-4 border-blue-500 rounded-md">
        <div class="flex items-start">
            <div class="flex-shrink-0">
                <i class="lni lni-power-button text-blue-500 text-2xl"></i>
            </div>
            <div class="ml-3">
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "text-blue-800 mb-2")">
                    Why Use Nullable Integer Input?
                </h3>
                <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-blue-700 space-y-2")">
                    <p>✓ <strong>Distinguish between "no value" and "zero"</strong> - Empty field means null, not 0</p>
                    <p>✓ <strong>Optional form fields</strong> - Users can skip fields without providing a value</p>
                    <p>✓ <strong>Better data integrity</strong> - Prevents unintended zero values in database</p>
                    <p>✓ <strong>Validation support</strong> - Required validation works correctly with nullable fields</p>
                </div>
            </div>
        </div>
    </div>

    <EditForm Model="@_formSampleModel" OnValidSubmit="OnValidFormSubmit" OnInvalidSubmit="OnInValidFormSubmit" novalidate>
        <DataAnnotationsValidator />

        <!-- Section 1: Nullable Behavior Demonstration -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">1. Nullable Behavior</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Demonstrating how nullable integers handle empty values differently from non-nullable integers
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Required Nullable (starts null) -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Required (Starts Null)</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.NumberOne"
                                                  ElementSize="ElementSize.Regular"
                                                  StartIcon="lni lni-android-old"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberOne)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Current value: @(_formSampleModel.NumberOne?.ToString() ?? "null")
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            int? NumberOne {{ get; set; }}
                            [Required] - Must have value
                        </code>
                    </div>
                </div>

                <!-- Optional Nullable (starts null) -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Optional (Starts Null)</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.NumberSix"
                                                  ElementSize="ElementSize.Regular"
                                                  StartIcon="lni lni-angle-double-right"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberSix)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Current value: @(_formSampleModel.NumberSix?.ToString() ?? "null")
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            int? NumberSix {{ get; set; }}
                            No [Required] - Can stay null
                        </code>
                    </div>
                </div>

                <!-- Has Default Value -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Default Value</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.NumberFour"
                                                  ElementSize="ElementSize.Regular"
                                                  StartIcon="lni lni-adobe"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberFour)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Current value: @(_formSampleModel.NumberFour?.ToString() ?? "null")
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            int? NumberFour {{ get; set; }} = 34;
                            Has initial value
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 2: Size Variants -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">2. Size Variants</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Three size options: Small, Regular (default), and Large
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Small -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Small</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.NumberOne"
                                                  ElementSize="ElementSize.Small"
                                                  StartIcon="lni lni-android-old"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberOne)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviInputIntegerNullable
                            @@bind-Value="value"
                            ElementSize="ElementSize.Small"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>

                <!-- Regular -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Regular (Default)</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.NumberTwo"
                                                  ElementSize="ElementSize.Regular"
                                                  StartIcon="lni lni-angle-double-right"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberTwo)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviInputIntegerNullable
                            @@bind-Value="value"
                            ElementSize="ElementSize.Regular"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>

                <!-- Large -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Large</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.NumberThree"
                                                  ElementSize="ElementSize.Large"
                                                  StartIcon="lni lni-adobe"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberThree)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviInputIntegerNullable
                            @@bind-Value="value"
                            ElementSize="ElementSize.Large"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 3: Input States -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">3. Input States</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Control input interactivity with Disabled and Readonly states
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Disabled -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Disabled</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.NumberFour"
                                                  ElementSize="ElementSize.Regular"
                                                  Disabled="true"
                                                  StartIcon="lni lni-angle-double-right"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberFour)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            User cannot interact with disabled inputs
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            Disabled="true"
                        </code>
                    </div>
                </div>

                <!-- Readonly -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Readonly</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.NumberFive"
                                                  ElementSize="ElementSize.Regular"
                                                  Readonly="true"
                                                  StartIcon="lni lni-angle-double-right"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberFive)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Value is visible but not editable
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            Readonly="true"
                        </code>
                    </div>
                </div>

                <!-- Normal -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Normal (Enabled)</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.NumberSix"
                                                  ElementSize="ElementSize.Regular"
                                                  StartIcon="lni lni-angle-double-right"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberSix)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Fully interactive input - can be null or have value
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            Default state - fully editable
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 4: Format Masks -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">4. Format Masks</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Apply various formatting patterns using InputFormatMasks constants. When null, field appears empty.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Fixed Point -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Fixed Point</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.FixedPoint"
                                                  ElementSize="ElementSize.Regular"
                                                  FormatMask="@InputFormatMasks.FIXED_POINT"
                                                  StartIcon="lni lni-angle-double-right"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.FixedPoint)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Value: @(_formSampleModel.FixedPoint?.ToString() ?? "null") | Format: 1234.00
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="@@InputFormatMasks.FIXED_POINT"
                        </code>
                    </div>
                </div>

                <!-- Currency -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Currency</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.Currency"
                                                  ElementSize="ElementSize.Regular"
                                                  FormatMask="@InputFormatMasks.CURRENCY"
                                                  StartIcon="lni lni-euro"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Currency)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Value: @(_formSampleModel.Currency?.ToString() ?? "null") | Format: $1,234
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="@@InputFormatMasks.CURRENCY"
                        </code>
                    </div>
                </div>

                <!-- Percentage -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Percentage</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.Percentage"
                                                  ElementSize="ElementSize.Regular"
                                                  FormatMask="@InputFormatMasks.CUSTOM_PERCENTAGE"
                                                  StartIcon="lni lni-euro"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Percentage)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Value: @(_formSampleModel.Percentage?.ToString() ?? "null") | Format: 99%
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="@@InputFormatMasks.CUSTOM_PERCENTAGE"
                        </code>
                    </div>
                </div>

                <!-- General -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">General</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.General"
                                                  ElementSize="ElementSize.Regular"
                                                  FormatMask="@InputFormatMasks.GENERAL"
                                                  StartIcon="lni lni-euro"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.General)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Value: @(_formSampleModel.General?.ToString() ?? "null")
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="@@InputFormatMasks.GENERAL"
                        </code>
                    </div>
                </div>

                <!-- ZIP Code -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">ZIP Code (5-digit)</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.ZipCode"
                                                  ElementSize="ElementSize.Regular"
                                                  FormatMask="@InputFormatMasks.ZIP_CODE5"
                                                  StartIcon="lni lni-euro"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.ZipCode)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Value: @(_formSampleModel.ZipCode?.ToString() ?? "null") | Format: 12345
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="@@InputFormatMasks.ZIP_CODE5"
                        </code>
                    </div>
                </div>

                <!-- Thousand Separators -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Thousand Separators</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.Separator"
                                                  ElementSize="ElementSize.Regular"
                                                  FormatMask="@InputFormatMasks.THOUSAND_SEPARATORS"
                                                  StartIcon="lni lni-euro"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Separator)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Value: @(_formSampleModel.Separator?.ToString() ?? "null") | Format: 1,234,567
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="@@InputFormatMasks.THOUSAND_SEPARATORS"
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 5: Icons & Interactive Elements -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">5. Icons & Interactive Elements</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Add visual context and interaction through start icons, end icons, buttons, and event handlers
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Start Icon Only -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Start Icon</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.Age"
                                                  ElementSize="ElementSize.Regular"
                                                  StartIcon="lni lni-euro"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Age)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Icon positioned at input start
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            StartIcon="lni lni-euro"
                        </code>
                    </div>
                </div>

                <!-- End Icon & Alternative -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">End Icon with Alternative</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.Quantity"
                                                  ElementSize="ElementSize.Regular"
                                                  EndIcon="lni lni-power-button"
                                                  EndIconAlternative="lni lni-euro"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Quantity)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Switches between two end icons on click
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            EndIcon="lni lni-power-button"
                            EndIconAlternative="lni lni-euro"
                        </code>
                    </div>
                </div>

                <!-- With Button -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Action Button</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.FixedPoint"
                                                  ElementSize="ElementSize.Regular"
                                                  FormatMask="@InputFormatMasks.FIXED_POINT"
                                                  ButtonLabel="Calculate"
                                                  EndIcon="lni lni-power-button"
                                                  OnEndIconClick="SimulateCalculation"
                                                  Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Button triggers custom action
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            ButtonLabel="Calculate"
                            EndIcon="lni lni-power-button"
                            OnEndIconClick="HandleClick"
                        </code>
                    </div>
                </div>

                <!-- Complete Example -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Complete: Icons + Button</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.Currency"
                                                  ElementSize="ElementSize.Regular"
                                                  FormatMask="@InputFormatMasks.CURRENCY"
                                                  StartIcon="lni lni-euro"
                                                  EndIcon="lni lni-power-button"
                                                  EndIconAlternative="lni lni-hourglass"
                                                  ButtonLabel="Process"
                                                  OnEndIconClick="SimulateCalculation"
                                                  Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            All icon and button features combined
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            StartIcon="lni lni-euro"
                            EndIcon="lni lni-power-button"
                            EndIconAlternative="lni lni-hourglass"
                            ButtonLabel="Process"
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 6: Real-World Use Cases -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">6. Real-World Use Cases</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Common scenarios where nullable integers are preferred over non-nullable
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Age (Optional) -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Age (Optional Field)</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.Age"
                                                  ElementSize="ElementSize.Regular"
                                                  StartIcon="lni lni-android-old"
                                                  Min="0"
                                                  Max="120"
                                                  Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Age)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            User may choose not to provide age (null), not 0
                        </span>
                    </div>
                </div>

                <!-- Quantity (Inventory) -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Quantity (Inventory)</h3>
                        <MaviInputIntegerNullable @bind-Value="_formSampleModel.Quantity"
                                                  ElementSize="ElementSize.Regular"
