@code {
    private readonly SampleIntegerNullableModel _formSampleModel = new();

    private void OnValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form validation successful for nullable integer model.");
        Logger?.LogInformation("Model JSON: {ModelJson}", GetModelJson());
    }

    private void OnInValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form validation failed for nullable integer model.");
    }

    private async Task SimulateCalculation(MouseClickEventArgs args)
    {
        Logger?.LogInformation("Calculation started for input: {ButtonId}", args.ButtonId);
        await Task.Delay(2000); // Simulate processing
        Logger?.LogInformation("Calculation completed for input: {ButtonId}", args.ButtonId);
    }

    private void ClearAllValues()
    {
        _formSampleModel.NumberOne = null;
        _formSampleModel.NumberTwo = null;
        _formSampleModel.NumberThree = null;
        _formSampleModel.NumberFour = null;
        _formSampleModel.NumberFive = null;
        _formSampleModel.NumberSix = null;
        _formSampleModel.NumberSeven = null;
        _formSampleModel.FixedPoint = null;
        _formSampleModel.Currency = null;
        _formSampleModel.Percentage = null;
        _formSampleModel.General = null;
        _formSampleModel.ZipCode = null;
        _formSampleModel.Separator = null;
        _formSampleModel.Age = null;
        _formSampleModel.Quantity = null;

        Logger?.LogInformation("All nullable integer values cleared to null");
        StateHasChanged();
    }

    private string GetModelJson()
    {
        return System.Text.Json.JsonSerializer.Serialize(_formSampleModel, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true,
            DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.Never
        });
    }
}