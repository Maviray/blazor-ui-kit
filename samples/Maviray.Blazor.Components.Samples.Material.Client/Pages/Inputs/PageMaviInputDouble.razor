@page "/PageMaviInputDouble"
@inherits SamplePageBase

<PageTitle>Double Input</PageTitle>


<div class="p-6 max-w-7xl mx-auto">
<!-- Page Header -->
<div class="mb-8">
    <h1 class="@CssManager.Combine(Tailwind.Theme.Typography.DISPLAY_MEDIUM, "mb-2")">MaviInputDouble Component</h1>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_LARGE, "text-gray-600")">
        Comprehensive showcase demonstrating all available parameters, use cases, and formatting options for the MaviInputDouble component.
        This component is optimized for decimal number input with support for various formatting masks, decimal precision control, and scientific notation.
    </p>
</div>

<EditForm Model="@_formSampleModel" OnValidSubmit="OnValidFormSubmit" OnInvalidSubmit="OnInValidFormSubmit" novalidate>
<DataAnnotationsValidator/>

<!-- Section 1: Size Variants -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">1. Size Variants</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Three size options: Small, Regular (default), and Large - optimized for decimal number input
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Small -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Small</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.NumberOne"
                                 ElementSize="ElementSize.Small"
                                 StartIcon="lni lni-android-old"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.NumberOne)"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    &lt;MaviInputDouble
                    @@bind-Value="value"
                    ElementSize="ElementSize.Small"
                    StartIcon="lni lni-android-old"
                    Width="w-full" /&gt;
                </code>
            </div>
        </div>

        <!-- Regular -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Regular (Default)</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.NumberTwo"
                                 ElementSize="ElementSize.Regular"
                                 StartIcon="lni lni-angle-double-right"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.NumberTwo)"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    &lt;MaviInputDouble
                    @@bind-Value="value"
                    ElementSize="ElementSize.Regular"
                    StartIcon="lni lni-angle-double-right"
                    Width="w-full" /&gt;
                </code>
            </div>
        </div>

        <!-- Large -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Large</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.NumberThree"
                                 ElementSize="ElementSize.Large"
                                 StartIcon="lni lni-adobe"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.NumberThree)"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    &lt;MaviInputDouble
                    @@bind-Value="value"
                    ElementSize="ElementSize.Large"
                    StartIcon="lni lni-adobe"
                    Width="w-full" /&gt;
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 2: State Variants -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">2. Input States</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Control input interactivity with Disabled and Readonly states
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Disabled -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Disabled</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.NumberFour"
                                 ElementSize="ElementSize.Small"
                                 Disabled="true"
                                 StartIcon="lni lni-angle-double-right"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.NumberFour)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    User cannot interact with disabled inputs
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    &lt;MaviInputDouble
                    @@bind-Value="value"
                    Disabled="true"
                    StartIcon="lni lni-angle-double-right"
                    Width="w-full" /&gt;
                </code>
            </div>
        </div>

        <!-- Readonly -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Readonly</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.NumberFive"
                                 ElementSize="ElementSize.Regular"
                                 Readonly="true"
                                 StartIcon="lni lni-angle-double-right"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.NumberFive)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Value is visible but not editable
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    &lt;MaviInputDouble
                    @@bind-Value="value"
                    Readonly="true"
                    StartIcon="lni lni-angle-double-right"
                    Width="w-full" /&gt;
                </code>
            </div>
        </div>

        <!-- Normal (for comparison) -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Normal (Enabled)</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.NumberSix"
                                 ElementSize="ElementSize.Small"
                                 StartIcon="lni lni-angle-double-right"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.NumberSix)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Fully interactive input
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    &lt;MaviInputDouble
                    @@bind-Value="value"
                    StartIcon="lni lni-angle-double-right"
                    Width="w-full" /&gt;
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 3: Format Masks for Double Values -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">3. Format Masks for Decimal Numbers</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Apply various decimal formatting patterns - values are shown formatted when not focused, raw when editing
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Fixed Point 2 Decimals -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Fixed Point (2 decimals)</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.FixedPoint2"
                                 ElementSize="ElementSize.Small"
                                 FormatMask="F2"
                                 StartIcon="lni lni-calculator-1"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.FixedPoint2)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Format: 1234.56
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    FormatMask="F2"
                </code>
            </div>
        </div>

        <!-- Fixed Point 4 Decimals -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Fixed Point (4 decimals)</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.FixedPoint4"
                                 ElementSize="ElementSize.Small"
                                 FormatMask="F4"
                                 StartIcon="lni lni-calculator-1"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.FixedPoint4)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Format: 1234.5678
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    FormatMask="F4"
                </code>
            </div>
        </div>

        <!-- Number with 2 Decimals -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Number (2 decimals)</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.Separator"
                                 ElementSize="ElementSize.Small"
                                 FormatMask="N2"
                                 StartIcon="lni lni-calculator-1"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Separator)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Format: 1,234,567.89
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    FormatMask="N2"
                </code>
            </div>
        </div>

        <!-- Currency -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Currency</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.Currency"
                                 ElementSize="ElementSize.Small"
                                 FormatMask="C2"
                                 StartIcon="lni lni-euro"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Currency)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Format: $1,234.56
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    FormatMask="C2"
                </code>
            </div>
        </div>

        <!-- Percentage -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Percentage</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.Percentage"
                                 ElementSize="ElementSize.Small"
                                 FormatMask="P2"
                                 StartIcon="lni lni-bar-chart-dollar"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Percentage)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Format: 12.34% (value 0.1234)
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    FormatMask="P2"
                </code>
            </div>
        </div>

        <!-- Scientific Notation -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Scientific Notation</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.Scientific"
                                 ElementSize="ElementSize.Small"
                                 FormatMask="E2"
                                 AllowScientificNotation="true"
                                 StartIcon="lni lni-microscope"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Scientific)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Format: 1.23E+006
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    FormatMask="E2"
                    AllowScientificNotation="true"
                </code>
            </div>
        </div>

        <!-- General Format -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">General Format</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.General"
                                 ElementSize="ElementSize.Small"
                                 FormatMask="G"
                                 StartIcon="lni lni-calculator-1"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.General)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Compact general format
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    FormatMask="G"
                </code>
            </div>
        </div>

        <!-- Custom Format -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Custom Format</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.General"
                                 ElementSize="ElementSize.Small"
                                 FormatMask="#,##0.00"
                                 StartIcon="lni lni-gears-3"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.General)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Custom: #,##0.00
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    FormatMask="#,##0.00"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 4: Decimal Places Control -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">4. Decimal Places Control</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Restrict decimal precision using the DecimalPlaces parameter - automatically rounds to specified precision
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- 2 Decimal Places -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">2 Decimal Places</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.DecimalPlaces2"
                                 ElementSize="ElementSize.Small"
                                 DecimalPlaces="2"
                                 StartIcon="lni lni-gears-3"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.DecimalPlaces2)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Rounds to 2 decimals: 123.46
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    DecimalPlaces="2"
                </code>
            </div>
        </div>

        <!-- 4 Decimal Places -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">4 Decimal Places</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.DecimalPlaces4"
                                 ElementSize="ElementSize.Small"
                                 DecimalPlaces="4"
                                 StartIcon="lni lni-gears-3"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.DecimalPlaces4)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Rounds to 4 decimals: 123.4568
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    DecimalPlaces="4"
                </code>
            </div>
        </div>

        <!-- Combined: Decimal Places + Format Mask -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Combined: Precision + Format</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.Price"
                                 ElementSize="ElementSize.Small"
                                 DecimalPlaces="2"
                                 FormatMask="C2"
                                 StartIcon="lni lni-euro"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Price)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    2 decimals + currency format
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    DecimalPlaces="2"
                    FormatMask="C2"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 5: Icons & Interactive Elements -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">5. Icons & Interactive Elements</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Add visual context and interaction through start icons, end icons, buttons, and event handlers
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Start Icon Only -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Start Icon</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.Temperature"
                                 ElementSize="ElementSize.Regular"
                                 FormatMask="F1"
                                 StartIcon="lni lni-gears-3"
                                 Width="w-full"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Icon positioned at input start
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    StartIcon="lni lni-gears-3"
                </code>
            </div>
        </div>

        <!-- End Icon & Alternative -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">End Icon with Alternative</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.Weight"
                                 ElementSize="ElementSize.Regular"
                                 FormatMask="F2"
                                 EndIcon="lni lni-power-button"
                                 EndIconAlternative="lni lni-checkmark"
                                 Width="w-full"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Switches between two end icons
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    EndIcon="lni-power-button"
                    EndIconAlternative="lni lni-checkmark"
                </code>
            </div>
        </div>

        <!-- With Button -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Action Button</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.FixedPoint2"
                                 ElementSize="ElementSize.Regular"
                                 FormatMask="F2"
                                 ButtonLabel="Calculate"
                                 EndIcon="lni lni-calculator"
                                 OnEndIconClick="SimulateCalculation"
                                 Width="w-full"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Button triggers custom action
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ButtonLabel="Calculate"
                    EndIcon="lni lni-calculator"
                    OnEndIconClick="HandleClick"
                </code>
            </div>
        </div>

        <!-- Complete Example -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Complete: Icons + Button</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.Price"
                                 ElementSize="ElementSize.Regular"
                                 FormatMask="C2"
                                 DecimalPlaces="2"
                                 StartIcon="lni lni-euro"
                                 EndIcon="lni lni-calculator"
                                 EndIconAlternative="lni lni-checkmark"
                                 ButtonLabel="Process"
                                 OnEndIconClick="SimulateCalculation"
                                 Width="w-full"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    All icon and button features combined
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    StartIcon="lni lni-euro"
                    EndIcon="lni lni-calculator"
                    EndIconAlternative="lni lni-checkmark"
                    ButtonLabel="Process"
                    OnEndIconClick="HandleClick"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 6: Real-World Use Cases -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">6. Real-World Use Cases</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Practical examples demonstrating common scenarios for double input fields
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Price Input -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Product Price</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.Price"
                                 ElementSize="ElementSize.Regular"
                                 FormatMask="C2"
                                 DecimalPlaces="2"
                                 Min="0.01"
                                 StartIcon="lni lni-dollar"
                                 HelperText="Enter product price"
                                 Width="w-full"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Currency with 2 decimal precision
                </span>
            </div>
        </div>

        <!-- Temperature -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Temperature (°F)</h3>
                <MaviInputDouble @bind-Value="_formSampleModel.Temperature"
                                 ElementSize="ElementSize.Regular"
                                 FormatMask="F1"
                                 DecimalPlaces="1"
