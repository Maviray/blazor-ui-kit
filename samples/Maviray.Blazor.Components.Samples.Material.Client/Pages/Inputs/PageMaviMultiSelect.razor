@page "/PageMaviMultiSelect"
@using Maviray.Blazor.Components.Core.Models
@inherits SamplePageBase

<PageTitle>MaviMultiSelect</PageTitle>


<div class="p-6 max-w-7xl mx-auto">
<!-- Page Header -->
<div class="mb-8">
    <h1 class="@CssManager.Combine(Tailwind.Theme.Typography.DISPLAY_MEDIUM, "mb-2")">MaviMultiSelect Component</h1>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_LARGE, "text-gray-600")">
        Comprehensive showcase demonstrating all available parameters, use cases, and data binding options for the MaviMultiSelect component with multiple selection support.
    </p>
</div>

<EditForm Model="@_formSampleModel" OnValidSubmit="OnValidFormSubmit" OnInvalidSubmit="OnInValidFormSubmit" novalidate>
<DataAnnotationsValidator/>

<!-- Section 1: Size Variants -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">1. Size Variants</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Three size options: Small, Regular (default), and Large - all supporting multiple selections
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Small -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Small</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.Countries"
                                 Items="@_countries.Select(c => c.Name)"
                                 ElementSize="ElementSize.Small"
                                 StartIcon="lni lni-world"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Countries)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Selected: @(_formSampleModel.Countries?.Count ?? 0) countries
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    &lt;MaviMultiSelect TItem="string" TValue="string"
                    @@bind-Value="value"
                    Items="@@items"
                    ElementSize="ElementSize.Small"
                    StartIcon="lni lni-world"
                    Width="w-full" /&gt;
                </code>
            </div>
        </div>

        <!-- Regular -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Regular (Default)</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.States"
                                 Items="@_states"
                                 ElementSize="ElementSize.Regular"
                                 StartIcon="lni lni-map"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.States)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Selected: @(_formSampleModel.States?.Count ?? 0) states
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    &lt;MaviMultiSelect TItem="string" TValue="string"
                    @@bind-Value="value"
                    Items="@@items"
                    ElementSize="ElementSize.Regular"
                    StartIcon="lni lni-map"
                    Width="w-full" /&gt;
                </code>
            </div>
        </div>

        <!-- Large -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Large</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.Cities"
                                 Items="@_cities"
                                 ElementSize="ElementSize.Large"
                                 StartIcon="lni lni-home"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Cities)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Selected: @(_formSampleModel.Cities?.Count ?? 0) cities
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    &lt;MaviMultiSelect TItem="string" TValue="string"
                    @@bind-Value="value"
                    Items="@@items"
                    ElementSize="ElementSize.Large"
                    StartIcon="lni lni-home"
                    Width="w-full" /&gt;
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 2: States (Disabled, Readonly) -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">2. MultiSelect States</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Control multi-select interactivity with Disabled and Readonly states
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Disabled -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Disabled</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.Departments"
                                 Items="@_departments.Select(d => d.Name)"
                                 ElementSize="ElementSize.Small"
                                 Disabled="true"
                                 StartIcon="lni lni-briefcase"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Departments)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    User cannot interact with disabled multi-select
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    Disabled="true"
                </code>
            </div>
        </div>

        <!-- Readonly -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Readonly</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.JobRoles"
                                 Items="@_jobRoles"
                                 ElementSize="ElementSize.Regular"
                                 Readonly="true"
                                 StartIcon="lni lni-user"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.JobRoles)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Values are visible but not changeable
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    Readonly="true"
                </code>
            </div>
        </div>

        <!-- Normal (for comparison) -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Normal (Enabled)</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.Languages"
                                 Items="@_languages"
                                 ElementSize="ElementSize.Small"
                                 StartIcon="lni lni-comments"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Languages)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Fully interactive multi-select
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    Default state - fully enabled
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 3: Enum Binding -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">3. Multi-Select Enum Binding</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Automatically populate multi-select from C# enum types - select multiple values
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- SkillLevel Enum -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Skill Levels (Enum)</h3>
                <MaviMultiSelect TItem="SkillLevel" TValue="SkillLevel"
                                 @bind-Value="_formSampleModel.SkillLevels"
                                 Items="_skillLevels"
                                 ElementSize="ElementSize.Small"
                                 StartIcon="lni lni-bar-chart"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.SkillLevels)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Selected @(_formSampleModel.SkillLevels?.Count ?? 0) skill levels
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    TItem="SkillLevel" TValue="SkillLevel"
                    Items="@@Enum.GetValues&lt;SkillLevel&gt;()"
                </code>
            </div>
        </div>

        <!-- Status Enum -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Status (Enum)</h3>
                <MaviMultiSelect TItem="Status" TValue="Status"
                                 @bind-Value="_formSampleModel.Statuses"
                                 Items="_statuses"
                                 ElementSize="ElementSize.Small"
                                 StartIcon="lni lni-checkmark-circle"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Statuses)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Multiple status selection
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    TItem="Status" TValue="Status"
                </code>
            </div>
        </div>

        <!-- Category Enum -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Categories</h3>
                <MaviMultiSelect TItem="Category" TValue="Category"
                                 @bind-Value="_formSampleModel.Categories"
                                 Items="_categories"
                                 ElementSize="ElementSize.Small"
                                 StartIcon="lni lni-tag"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Categories)"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    TItem="Category" TValue="Category"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 4: Complex Object Binding -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">4. Complex Object Multi-Select</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Bind to complex objects with custom value and text selectors - select multiple items
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Country Object -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Countries (Complex Object)</h3>
                <MaviMultiSelect TItem="Country" TValue="string"
                                 @bind-Value="_formSampleModel.CountryCodes"
                                 Items="@_countries"
                                 ValueSelector="@(c => c.Code)"
                                 TextSelector="@(c => c.Name)"
                                 ElementSize="ElementSize.Regular"
                                 StartIcon="lni lni-world"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.CountryCodes)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Selected Codes: @(string.Join(", ", _formSampleModel.CountryCodes ?? new List<string>()))
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    TItem="Country" TValue="string"
                    Items="@@countries"
                    ValueSelector="@@(c => c.Code)"
                    TextSelector="@@(c => c.Name)"
                </code>
            </div>
        </div>

        <!-- Department Object -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Departments (With Description)</h3>
                <MaviMultiSelect TItem="Department" TValue="string"
                                 @bind-Value="_formSampleModel.DepartmentNames"
                                 Items="@_departments"
                                 ValueSelector="@(d => d.Name)"
                                 TextSelector="@(d => $"{d.Name} - {d.Description}")"
                                 ElementSize="ElementSize.Regular"
                                 StartIcon="lni lni-briefcase"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.DepartmentNames)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Displays combined text with description
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    TItem="Department" TValue="string"
                    ValueSelector="@@(d => d.Name)"
                    TextSelector="@@(d => $"{d.Name} - {d.Description}")"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 5: Advanced Features -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">5. Advanced Multi-Select Features</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Custom placeholder, helper text, Select All/Clear All, and event handling
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Custom Placeholder -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Custom Placeholder</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.Currencies"
                                 Items="@_currencies"
                                 ElementSize="ElementSize.Regular"
                                 PlaceholderText="Choose your currencies..."
                                 StartIcon="lni lni-money-protection"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Currencies)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Custom placeholder text
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    PlaceholderText="Choose your currencies..."
                </code>
            </div>
        </div>

        <!-- With Helper Text -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Helper Text</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.Timezones"
                                 Items="@_timezones"
                                 ElementSize="ElementSize.Regular"
                                 HelperText="Select all applicable timezones"
                                 StartIcon="lni lni-timer"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Timezones)"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    HelperText="Select all applicable timezones"
                </code>
            </div>
        </div>

        <!-- With Change Event -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Change Event</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.ColorThemes"
                                 Items="@_colorThemes"
                                 ElementSize="ElementSize.Regular"
                                 OnSelectionChanged="HandleThemeChange"
                                 StartIcon="lni lni-paint-bucket"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.ColorThemes)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Last change: @_lastThemeChange
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    OnSelectionChanged="HandleThemeChange"
                </code>
            </div>
        </div>

        <!-- Select All Option -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Without Select All</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.Skills"
                                 Items="@_skillList"
                                 ElementSize="ElementSize.Regular"
                                 ShowSelectAllOption="false"
                                 StartIcon="lni lni-cog"
                                 Width="w-full"/>
                <ValidationMessage For="@(() => _formSampleModel.Skills)"/>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Select All button hidden
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ShowSelectAllOption="false"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 6: Theme Color Schemes -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">6. Multi-Select Theme Color Schemes</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Apply different color themes to match your design system
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Primary -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Primary</h3>
                <MaviMultiSelect TItem="Priority" TValue="Priority"
                                 @bind-Value="_formSampleModel.Priorities"
                                 Items="_priorities"
                                 ElementSize="ElementSize.Small"
                                 ThemeColorScheme="ThemeColorScheme.Primary"
                                 StartIcon="lni lni-flag-alt"
                                 Width="w-full"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ThemeColorScheme="ThemeColorScheme.Primary"
                </code>
            </div>
        </div>

        <!-- Secondary -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Secondary</h3>
                <MaviMultiSelect TItem="Status" TValue="Status"
                                 @bind-Value="_formSampleModel.Statuses"
                                 Items="_statuses"
                                 ElementSize="ElementSize.Small"
                                 ThemeColorScheme="ThemeColorScheme.Secondary"
                                 StartIcon="lni lni-checkmark-circle"
                                 Width="w-full"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ThemeColorScheme="ThemeColorScheme.Secondary"
                </code>
            </div>
        </div>

        <!-- Success -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Success</h3>
                <MaviMultiSelect TItem="Category" TValue="Category"
                                 @bind-Value="_formSampleModel.Categories"
                                 Items="_categories"
                                 ElementSize="ElementSize.Small"
                                 ThemeColorScheme="ThemeColorScheme.Success"
                                 StartIcon="lni lni-tag"
                                 Width="w-full"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ThemeColorScheme="ThemeColorScheme.Success"
                </code>
            </div>
        </div>

        <!-- Alert -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Alert</h3>
                <MaviMultiSelect TItem="SkillLevel" TValue="SkillLevel"
                                 @bind-Value="_formSampleModel.SkillLevels"
                                 Items="_skillLevels"
                                 ElementSize="ElementSize.Small"
                                 ThemeColorScheme="ThemeColorScheme.Alert"
                                 StartIcon="lni lni-bar-chart"
                                 Width="w-full"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ThemeColorScheme="ThemeColorScheme.Alert"
                </code>
            </div>
        </div>

        <!-- Warning -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Warning</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.Languages"
                                 Items="@_languages"
                                 ElementSize="ElementSize.Small"
                                 ThemeColorScheme="ThemeColorScheme.Warning"
                                 StartIcon="lni lni-comments"
                                 Width="w-full"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ThemeColorScheme="ThemeColorScheme.Warning"
                </code>
            </div>
        </div>

        <!-- Info -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Info</h3>
                <MaviMultiSelect TItem="string" TValue="string"
                                 @bind-Value="_formSampleModel.Currencies"
                                 Items="@_currencies"
                                 ElementSize="ElementSize.Small"
                                 ThemeColorScheme="ThemeColorScheme.Info"
                                 StartIcon="lni lni-money-protection"
                                 Width="w-full"/>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ThemeColorScheme="ThemeColorScheme.Info"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 7: Complete Parameter Reference -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">7. Complete Parameter Reference</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        All available parameters for MaviMultiSelect component
    </p>

    <div class="overflow-x-auto bg-white shadow-md rounded-lg">
        <table class="min-w-full">
            <thead class="@CssManager.Combine(Tailwind.Theme.Colors.Background.THEME_LIGHT_FOUR_BG)">
            <tr>
                <th class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "px-6 py-3 text-left")">Parameter</th>
                <th class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "px-6 py-3 text-left")">Type</th>
