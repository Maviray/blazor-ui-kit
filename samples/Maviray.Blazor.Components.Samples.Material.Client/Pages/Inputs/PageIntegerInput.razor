@page "/PageIntegerInput"
@inherits SamplePageBase
@using Maviray.Blazor.Components.Core.Constants
@using Maviray.Blazor.Components.Core.EventArgs
@using Maviray.Blazor.Components.Material.Components.Inputs
@using Maviray.Blazor.Components.Samples.Material.Client.Models

<PageTitle>Integer Input</PageTitle>

<div class="p-4">
    <EditForm Model="@_formSampleModel" OnValidSubmit="OnValidFormSubmit" OnInvalidSubmit="OnInValidFormSubmit" novalidate>
        <DataAnnotationsValidator />
        <div class="flex flex-col gap-2">
            <div class="flex flex-col 2xl:flex-row gap-2">
                <div class="basis-1/3 flex flex-col">
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.NumberOne"
                                          ElementSize="ElementSize.Small"
                                          StartIcon="lni lni-android-old"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberOne)" />
                    </div>
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.NumberTwo"
                                          ElementSize="ElementSize.Regular"
                                          StartIcon="lni lni-angle-double-right"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberTwo)" />
                    </div>
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.NumberThree"
                                          ElementSize="ElementSize.Large"
                                          StartIcon="lni lni-adobe"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberThree)" />
                    </div>
                </div>
                <div class="basis-1/3 flex flex-col">
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.NumberFour"
                                          ElementSize="ElementSize.Small"
                                          Disabled="true"
                                          StartIcon="lni lni-android-old"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberFour)" />
                    </div>
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.NumberFive"
                                          ElementSize="ElementSize.Regular"
                                          Readonly="true"
                                          StartIcon="lni lni-angle-double-right"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberFive)" />
                    </div>
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.NumberSix"
                                          ElementSize="ElementSize.Small"
                                          Disabled="true"
                                          StartIcon="lni lni-android-old"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberSix)" />
                    </div>
                </div>
            </div>
            <div class="flex flex-col 2xl:flex-row gap-2">
                <div class="basis-1/3 flex flex-col">
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.FixedPoint"
                                          ElementSize="ElementSize.Small"
                                          FormatMask="@InputFormatMasks.FIXED_POINT"
                                          StartIcon="lni lni-android-old"
                                          EndIcon="lni lni-search-1"
                                          EndIconAlternative="lni lni-xmark"
                                          ButtonLabel="Calculate"
                                          OnEndIconClick="SimulateCalculation"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.FixedPoint)" />
                    </div>
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.Currency"
                                          ElementSize="ElementSize.Small"
                                          FormatMask="@InputFormatMasks.CURRENCY"
                                          StartIcon="lni lni-android-old"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Currency)" />
                    </div>
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.Percentage"
                                          ElementSize="ElementSize.Small"
                                          FormatMask="@InputFormatMasks.CUSTOM_PERCENTAGE"
                                          StartIcon="lni lni-android-old"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Percentage)" />
                    </div>
                </div>
                <div class="basis-1/3 flex flex-col">
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.General"
                                          ElementSize="ElementSize.Small"
                                          FormatMask="@InputFormatMasks.GENERAL"
                                          StartIcon="lni lni-android-old"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.General)" />
                    </div>
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.ZipCode"
                                          ElementSize="ElementSize.Small"
                                          FormatMask="@InputFormatMasks.ZIP_CODE5"
                                          StartIcon="lni lni-android-old"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.ZipCode)" />
                    </div>
                    <div>
                        <MaviInputInteger @bind-Value="_formSampleModel.Separator"
                                          ElementSize="ElementSize.Small"
                                          FormatMask="@InputFormatMasks.THOUSAND_SEPARATORS"
                                          StartIcon="lni lni-android-old"
                                          Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Separator)" />
                    </div>
                </div>
            </div>
        </div>
        <div class="p-2">
            <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                        ElementSize="ElementSize.Regular"
                        Title="Submit"
                        ButtonRole="ButtonRole.Submit"
                        ElementVariant="ElementVariant.Outlined"
                        TextTransform="TextTransform.Capitalize">

            </MaviButton>
        </div>
    </EditForm>
</div>


@code {
    private readonly SampleIntegerModel _formSampleModel = new();

    private string? DirectString { get; set; }

    private void OnValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form Valid.");
    }

    private void OnInValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form In-Valid.");
    }

    private Task OnInputIconClick(MouseClickEventArgs args)
    {
        Logger?.LogInformation("Input item icon click. ID: {ArgsButtonId}", args.ButtonId);
        return Task.CompletedTask;
    }

    private async Task SimulateCalculation(MouseClickEventArgs args)
    {
        Logger?.LogInformation("Starting search for: {SearchTerm}", args.ButtonId);
    
        // Simulate a long-running search operation
        await Task.Delay(2000); // 2-second delay
    
        Logger?.LogInformation("Search completed for: {SearchTerm}", args.ButtonId);
    }
}