@page "/PageLinks"
@using Maviray.Blazor.Components.Core.Utilities
@using Maviray.Blazor.Components.Material.Components.Inputs
@inherits SamplePageBase

<PageTitle>Links</PageTitle>

<div class="container mx-auto p-8 space-y-12">
    <header class="mb-8">
        <h1 class="text-4xl font-bold mb-2">MaviLink Component Showcase</h1>
        <p class="text-gray-600">Material UI styled navigation links with Tailwind CSS</p>
    </header>
    <div class="flex flex-col gap-2">
        <div class="flex gap-2">
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Default"
                      Label="Default"
                      Title="Default">
                <LeftIcon><i class="lni lni-chevron-left"></i></LeftIcon>
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Primary"
                      Label="Primary"
                      Title="Primary">
                <LeftIcon><i class="lni lni-chevron-left"></i></LeftIcon>
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Secondary"
                      Label="Secondary"
                      Title="Secondary">
                <LeftIcon><i class="lni lni-chevron-left"></i></LeftIcon>
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Success"
                      Label="Success"
                      Title="Success">
                <LeftIcon><i class="lni lni-chevron-left"></i></LeftIcon>
            </MaviLink>
        </div>
        <div class="flex gap-2">
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Alert"
                      Label="Alert"
                      Title="Alert">
                <LeftIcon><i class="lni lni-chevron-left"></i></LeftIcon>
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Warning"
                      Label="Warning"
                      Title="Warning">
                <LeftIcon><i class="lni lni-chevron-left"></i></LeftIcon>
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Info"
                      Label="Info"
                      Title="Info">
                <LeftIcon><i class="lni lni-chevron-left"></i></LeftIcon>
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Dark"
                      Label="Dark"
                      Title="Dark">
                <LeftIcon><i class="lni lni-chevron-left"></i></LeftIcon>
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Light"
                      Label="Light"
                      Title="Light">
                <LeftIcon><i class="lni lni-chevron-left"></i></LeftIcon>
            </MaviLink>
        </div>
    </div>
    <div class="flex flex-col gap-2">
        <div class="flex gap-2">
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Default"
                      Label="Default"
                      Title="Default">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Primary"
                      Label="Primary"
                      Title="Primary">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Secondary"
                      Label="Secondary"
                      Title="Secondary">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Success"
                      Label="Success"
                      Title="Success">
            </MaviLink>
        </div>
        <div class="flex gap-2">
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Alert"
                      Label="Alert"
                      Title="Alert">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Warning"
                      Label="Warning"
                      Title="Warning">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Info"
                      Label="Info"
                      Title="Info">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Dark"
                      Label="Dark"
                      Title="Dark">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Light"
                      Label="Light"
                      Title="Light">
            </MaviLink>
        </div>
    </div>
    <div class="flex gap-2">
        <div class="flex flex-col gap-2">
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Default"
                      ElementSize="ElementSize.Large"
                      Label="Default Small"
                      Title="Default Small">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Default"
                      ElementSize="ElementSize.Regular"
                      Label="Default Regular"
                      Title="Default Regular">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Default"
                      ElementSize="ElementSize.Large"
                      Label="Default Large"
                      Title="Default Large">
            </MaviLink>
        </div>
        <div class="flex flex-col gap-2">
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Primary"
                      ElementSize="ElementSize.Large"
                      Label="Primary Small"
                      Title="Primary Small">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Primary"
                      ElementSize="ElementSize.Regular"
                      Label="Primary Regular"
                      Title="Primary Regular">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Primary"
                      ElementSize="ElementSize.Large"
                      Label="Primary Large"
                      Title="Primary Large">
            </MaviLink>
        </div>
        <div class="flex flex-col gap-2">
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Secondary"
                      ElementSize="ElementSize.Large"
                      Label="Secondary Small"
                      Title="Secondary Small">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Secondary"
                      ElementSize="ElementSize.Regular"
                      Label="Secondary Regular"
                      Title="Secondary Regular">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Secondary"
                      ElementSize="ElementSize.Large"
                      Label="Secondary Large"
                      Title="Secondary Large">
            </MaviLink>
        </div>
        <div class="flex flex-col gap-2">
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Success"
                      ElementSize="ElementSize.Large"
                      Label="Success Small"
                      Title="Success Small">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Success"
                      ElementSize="ElementSize.Regular"
                      Label="Success Regular"
                      Title="Success Regular">
            </MaviLink>
            <MaviLink Href="/"
                      ThemeColorScheme="ThemeColorScheme.Success"
                      ElementSize="ElementSize.Large"
                      Label="Success Large"
                      Title="Success Large">
            </MaviLink>
        </div>
    </div>
</div>

@code {
    private RenderFragment Icon(string emoji) => @<span>@emoji</span>;
}