    <!-- Section 6: Disabled States -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Disabled States</h2>
            <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
                Button groups can be disabled entirely or have individual buttons disabled. Disabled buttons have reduced opacity and are non-interactive.
            </p>
        </div>

        <div class="space-y-4">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Filled Variant - Disabled</h3>
            <div class="flex flex-wrap gap-4">
                <div class="flex flex-col gap-2 items-center">
                    <MaviButtonGroup ElementVariant="ElementVariant.Filled"
                                     ElementSize="ElementSize.Regular"
                                     ThemeColorScheme="ThemeColorScheme.Primary"
                                     OnClick="OnButtonGroupClick"
                                     Disabled="true"
                                     Buttons="@GenerateTextButtonGroup()" />
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, "text-gray-600")">All Disabled</span>
                </div>
                <div class="flex flex-col gap-2 items-center">
                    <MaviButtonGroup ElementVariant="ElementVariant.Filled"
                                     ElementSize="ElementSize.Regular"
                                     ThemeColorScheme="ThemeColorScheme.Primary"
                                     OnClick="OnButtonGroupClick"
                                     Buttons="@GeneratePartiallyDisabledButtonGroup()" />
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, "text-gray-600")">Partial Disabled</span>
