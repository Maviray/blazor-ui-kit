@page "/PageMaviButtonGroup"
@using Maviray.Blazor.Components.Core.Models.Buttons

@inherits SamplePageBase

<PageTitle>Button Groups</PageTitle>

<div class="p-8 max-w-7xl mx-auto space-y-12">

    <!-- Page Header -->
    <div class="space-y-2">
        <h1 class="@Tailwind.Theme.Typography.DISPLAY_MEDIUM">Button Group Components</h1>
        <p class="@Tailwind.Theme.Typography.BODY_LARGE text-gray-600">
            Button groups combine related actions together. They support text, icons, sizes, variants, and color schemes.
        </p>
    </div>

    <!-- Section 1: Basic Usage -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Basic Button Groups</h2>
            <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
                Simple button groups with text labels. Use for toggling between related options or navigating between views.
            </p>
        </div>

        <div class="space-y-4">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Text Button Groups</h3>
            <div class="flex flex-wrap gap-4">
                <MaviButtonGroup ElementVariant="ElementVariant.Filled"
                                 ElementSize="ElementSize.Regular"
                                 ThemeColorScheme="ThemeColorScheme.Primary"
                                 OnClick="OnButtonGroupClick"
                                 Buttons="@GenerateTextButtonGroup()" />
                <MaviButtonGroup ElementVariant="ElementVariant.Filled"
                                 ElementSize="ElementSize.Regular"
                                 ThemeColorScheme="ThemeColorScheme.Secondary"
                                 OnClick="OnButtonGroupClick"
                                 Buttons="@GenerateTextButtonGroup()" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 border border-gray-200 rounded-lg p-4")">
                <code class="text-purple-600">
                    &lt;MaviButtonGroup ElementVariant="ElementVariant.Filled" Buttons="@GenerateTextButtonGroup()" ... /&gt;<br />
                    <br />
                    @@code {<br />
                    &nbsp;&nbsp;private static List&lt;ButtonModel&gt; GenerateTextButtonGroup() =&gt; [<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;new() { Title = "Left" },<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;new() { Title = "Middle" },<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;new() { Title = "Right" }<br />
                    &nbsp;&nbsp;];<br />
                    }
                </code>
            </div>
        </div>
    </section>

    <!-- Section 2: Icon Button Groups -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Icon Button Groups</h2>
            <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
                Button groups can contain icons for more compact interfaces. Perfect for toolbars and action bars.
            </p>
        </div>

        <div class="space-y-4">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Icon-Only Groups</h3>
            <div class="flex flex-wrap gap-4">
                <MaviButtonGroup ElementVariant="ElementVariant.Filled"
                                 ElementSize="ElementSize.Regular"
                                 ThemeColorScheme="ThemeColorScheme.Primary"
                                 OnClick="OnButtonGroupClick"
                                 Buttons="@GenerateIconButtonGroup()" />
                <MaviButtonGroup ElementVariant="ElementVariant.Outlined"
                                 ElementSize="ElementSize.Regular"
                                 ThemeColorScheme="ThemeColorScheme.Primary"
                                 OnClick="OnButtonGroupClick"
                                 Buttons="@GenerateIconButtonGroup()" />
                <MaviButtonGroup ElementVariant="ElementVariant.Text"
                                 ElementSize="ElementSize.Regular"
                                 ThemeColorScheme="ThemeColorScheme.Primary"
                                 OnClick="OnButtonGroupClick"
                                 Buttons="@GenerateIconButtonGroup()" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 border border-gray-200 rounded-lg p-4")">
                <code class="text-purple-600">
                    &lt;MaviButtonGroup Buttons="@GenerateIconButtonGroup()" ... /&gt;<br />
                    <br />
                    @@code {<br />
                    &nbsp;&nbsp;private static List&lt;ButtonModel&gt; GenerateIconButtonGroup() =&gt; [<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;new() { StartIcon = "lni lni-chevron-left" },<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;new() { StartIcon = "lni lni-shield-2-check" },<br />
                    &nbsp;&nbsp;&nbsp;&nbsp;new() { EndIcon = "lni lni-chevron-right" }<br />
                    &nbsp;&nbsp;];<br />
                    }
                </code>
            </div>
        </div>
    </section>

    <!-- Section 3: Size Variations -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Size Variations</h2>
            <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
                Button groups support three sizes: Large, Regular, and Small. Choose based on context and available space.
            </p>
        </div>

        <div class="space-y-4">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Primary Filled - All Sizes</h3>
            <div class="flex flex-col gap-4">
                <div class="flex items-center gap-4">
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_MEDIUM, "w-20 text-gray-600")">Large:</span>
                    <MaviButtonGroup ElementVariant="ElementVariant.Filled"
                                     ElementSize="ElementSize.Large"
                                     ThemeColorScheme="ThemeColorScheme.Primary"
                                     OnClick="OnButtonGroupClick"
                                     Buttons="@GenerateTextButtonGroup()" />
                </div>
                <div class="flex items-center gap-4">
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_MEDIUM, "w-20 text-gray-600")">Regular:</span>
                    <MaviButtonGroup ElementVariant="ElementVariant.Filled"
                                     ElementSize="ElementSize.Regular"
                                     ThemeColorScheme="ThemeColorScheme.Primary"
                                     OnClick="OnButtonGroupClick"
                                     Buttons="@GenerateTextButtonGroup()" />
                </div>
                <div class="flex items-center gap-4">
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_MEDIUM, "w-20 text-gray-600")">Small:</span>
                    <MaviButtonGroup ElementVariant="ElementVariant.Filled"
                                     ElementSize="ElementSize.Small"
                                     ThemeColorScheme="ThemeColorScheme.Primary"
                                     OnClick="OnButtonGroupClick"
                                     Buttons="@GenerateTextButtonGroup()" />
                </div>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 border border-gray-200 rounded-lg p-4")">
                <code class="text-purple-600">
                    &lt;MaviButtonGroup ElementSize="ElementSize.Large" ... /&gt;<br />
                    &lt;MaviButtonGroup ElementSize="ElementSize.Regular" ... /&gt;<br />
                    &lt;MaviButtonGroup ElementSize="ElementSize.Small" ... /&gt;
                </code>
            </div>
        </div>
    </section>

    <!-- Section 4: Variant Styles -->
    <section class="space-y-6">
