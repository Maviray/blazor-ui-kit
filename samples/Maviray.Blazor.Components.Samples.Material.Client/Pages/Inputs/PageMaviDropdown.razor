@page "/PageMaviDropdown"
@using Maviray.Blazor.Components.Core.Models
@inherits SamplePageBase

<PageTitle>MaviDropdown</PageTitle>


<div class="p-6 max-w-7xl mx-auto">
    <!-- Page Header -->
    <div class="mb-8">
        <h1 class="@CssManager.Combine(Tailwind.Theme.Typography.DISPLAY_MEDIUM, "mb-2")">MaviDropdown Component</h1>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_LARGE, "text-gray-600")">
            Comprehensive showcase demonstrating all available parameters, use cases, and data binding options for the MaviDropdown component.
        </p>
    </div>

    <EditForm Model="@_formSampleModel" OnValidSubmit="OnValidFormSubmit" OnInvalidSubmit="OnInValidFormSubmit" novalidate>
        <DataAnnotationsValidator />

        <!-- Section 1: Size Variants -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">1. Size Variants</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Three size options: Small, Regular (default), and Large
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Small -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Small</h3>
                        <MaviDropdown TItem="string" TValue="string"
                                      @bind-Value="_formSampleModel.Country"
                                      Items="@_countries.Select(c => c.Name)"
                                      ElementSize="ElementSize.Small"
                                      StartIcon="lni lni-world"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Country)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviDropdown TItem="string" TValue="string"
                            @@bind-Value="value"
                            Items="@@items"
                            ElementSize="ElementSize.Small"
                            StartIcon="lni lni-world"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>

                <!-- Regular -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Regular (Default)</h3>
                        <MaviDropdown TItem="string" TValue="string"
                                      @bind-Value="_formSampleModel.State"
                                      Items="@_states"
                                      ElementSize="ElementSize.Regular"
                                      StartIcon="lni lni-map"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.State)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviDropdown TItem="string" TValue="string"
                            @@bind-Value="value"
                            Items="@@items"
                            ElementSize="ElementSize.Regular"
                            StartIcon="lni lni-map"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>

                <!-- Large -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Large</h3>
                        <MaviDropdown TItem="string" TValue="string"
                                      @bind-Value="_formSampleModel.City"
                                      Items="@_cities"
                                      ElementSize="ElementSize.Large"
                                      StartIcon="lni lni-map-marker"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.City)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviDropdown TItem="string" TValue="string"
                            @@bind-Value="value"
                            Items="@@items"
                            ElementSize="ElementSize.Large"
                            StartIcon="lni lni-map-marker"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 2: States (Disabled, Readonly) -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">2. Dropdown States</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Control dropdown interactivity with Disabled and Readonly states
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Disabled -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Disabled</h3>
                        <MaviDropdown TItem="string" TValue="string"
                                      @bind-Value="_formSampleModel.Department"
                                      Items="@_departments.Select(d => d.Name)"
                                      ElementSize="ElementSize.Small"
                                      Disabled="true"
                                      StartIcon="lni lni-briefcase"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Department)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            User cannot interact with disabled dropdowns
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            Disabled="true"
                        </code>
                    </div>
                </div>

                <!-- Readonly -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Readonly</h3>
                        <MaviDropdown TItem="string" TValue="string"
                                      @bind-Value="_formSampleModel.JobRole"
                                      Items="@_jobRoles"
                                      ElementSize="ElementSize.Regular"
                                      Readonly="true"
                                      StartIcon="lni lni-user"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.JobRole)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Value is visible but not changeable
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            Readonly="true"
                        </code>
                    </div>
                </div>

                <!-- Normal (for comparison) -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Normal (Enabled)</h3>
                        <MaviDropdown TItem="string" TValue="string"
                                      @bind-Value="_formSampleModel.Language"
                                      Items="@_languages"
                                      ElementSize="ElementSize.Small"
                                      StartIcon="lni lni-comments"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Language)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Fully interactive dropdown
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            Default state - fully enabled
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 3: Enum Binding -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">3. Enum Binding</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Automatically populate dropdown from C# enum types
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- SkillLevel Enum -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Skill Level (Enum)</h3>
                        <MaviDropdown TItem="SkillLevel" TValue="SkillLevel"
                                      @bind-Value="_formSampleModel.SkillLevel"
                                      Items="_skiLevels"
                                      ElementSize="ElementSize.Small"
                                      StartIcon="lni lni-graduation"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.SkillLevel)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Nullable enum binding
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            TItem="SkillLevel" TValue="SkillLevel"
                            Items="@@Enum.GetValues&lt;SkillLevel&gt;()"
                        </code>
                    </div>
                </div>

                <!-- Priority Enum (Required) -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Priority (Required Enum)</h3>
                        <MaviDropdown TItem="Priority" TValue="Priority"
                                      @bind-Value="_formSampleModel.Priority"
                                      Items="_priorities"
                                      ElementSize="ElementSize.Small"
                                      StartIcon="lni lni-warning"
                                      ShowPlaceholderOption="false"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Priority)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Non-nullable enum (no placeholder)
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            TItem="Priority" TValue="Priority"
                            ShowPlaceholderOption="false"
                        </code>
                    </div>
                </div>

                <!-- Status Enum -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Status (Enum)</h3>
                        <MaviDropdown TItem="Status" TValue="Status"
                                      @bind-Value="_formSampleModel.Status"
                                      Items="_statuses"
                                      ElementSize="ElementSize.Small"
                                      StartIcon="lni lni-checkmark-circle"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Status)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Status enum with placeholder
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            TItem="Status" TValue="Status"
                        </code>
                    </div>
                </div>

                <!-- Category Enum -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Category</h3>
                        <MaviDropdown TItem="Category" TValue="Category"
                                      @bind-Value="_formSampleModel.Category"
                                      Items="_categories"
                                      ElementSize="ElementSize.Small"
                                      StartIcon="lni lni-tag"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Category)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            TItem="Category" TValue="Category"
                        </code>
                    </div>
                </div>

                <!-- ProductSize Enum -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Product Size</h3>
                        <MaviDropdown TItem="ProductSize" TValue="ProductSize"
                                      @bind-Value="_formSampleModel.ProductSize"
                                      Items="_productSizes"
                                      ElementSize="ElementSize.Small"
                                      StartIcon="lni lni-ruler"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.ProductSize)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            TItem="ProductSize" TValue="ProductSize"
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 4: Complex Object Binding -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">4. Complex Object Binding</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Bind to complex objects with custom value and text selectors
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Country Object -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Country (Complex Object)</h3>
                        <MaviDropdown TItem="Country" TValue="string"
                                      @bind-Value="_formSampleModel.Country"
                                      Items="@_countries"
                                      ValueSelector="@(c => c.Code)"
                                      TextSelector="@(c => c.Name)"
                                      ElementSize="ElementSize.Regular"
                                      StartIcon="lni lni-world"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Country)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Selected Code: @(_formSampleModel.Country ?? "None")
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            TItem="Country" TValue="string"
                            Items="@@countries"
                            ValueSelector="@@(c => c.Code)"
                            TextSelector="@@(c => c.Name)"
                        </code>
                    </div>
                </div>

                <!-- Department Object -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Department (Int ID)</h3>
                        <MaviDropdown TItem="Department" TValue="string"
                                      @bind-Value="_formSampleModel.Department"
                                      Items="@_departments"
                                      ValueSelector="@(d => d.Name)"
                                      TextSelector="@(d => $"{d.Name} - {d.Description}")"
                                      ElementSize="ElementSize.Regular"
                                      StartIcon="lni lni-briefcase"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Department)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Displays combined text with description
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            TItem="Department" TValue="string"
                            ValueSelector="@@(d => d.Name)"
                            TextSelector="@@(d => $"{d.Name} - {d.Description}")"
                        </code>
                    </div>
                </div>

                <!-- Experience Level (Custom Display) -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Experience Level (Custom)</h3>
                        <MaviDropdown TItem="ExperienceOption" TValue="int?"
                                      @bind-Value="_formSampleModel.ExperienceLevel"
                                      Items="@_experienceOptions"
                                      ValueSelector="@(e => e.Years)"
                                      TextSelector="@(e => e.Label)"
                                      ElementSize="ElementSize.Regular"
                                      StartIcon="lni lni-calendar"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.ExperienceLevel)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Selected Years: @(_formSampleModel.ExperienceLevel?.ToString() ?? "None")
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            TItem="ExperienceOption" TValue="int?"
                            ValueSelector="@@(e => e.Years)"
                            TextSelector="@@(e => e.Label)"
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 5: Advanced Features -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">5. Advanced Features</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Custom placeholder, helper text, required fields, and event handling
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Custom Placeholder -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Custom Placeholder</h3>
                        <MaviDropdown TItem="string" TValue="string"
                                      @bind-Value="_formSampleModel.Currency"
                                      Items="@_currencies"
                                      ElementSize="ElementSize.Regular"
                                      PlaceholderText="Choose your currency..."
                                      StartIcon="lni lni-money-protection"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Currency)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Custom placeholder text
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            PlaceholderText="Choose your currency..."
                        </code>
                    </div>
                </div>

                <!-- With Helper Text -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Helper Text</h3>
                        <MaviDropdown TItem="string" TValue="string"
                                      @bind-Value="_formSampleModel.Timezone"
                                      Items="@_timezones"
                                      ElementSize="ElementSize.Regular"
                                      HelperText="Select your local timezone for scheduling"
                                      StartIcon="lni lni-alarm-clock"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Timezone)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            HelperText="Select your local timezone"
                        </code>
                    </div>
                </div>

                <!-- With Change Event -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Change Event</h3>
                        <MaviDropdown TItem="string" TValue="string"
                                      @bind-Value="_formSampleModel.ColorTheme"
                                      Items="@_colorThemes"
                                      ElementSize="ElementSize.Regular"
                                      OnSelectionChanged="HandleThemeChange"
                                      StartIcon="lni lni-palette"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.ColorTheme)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Last selection: @_lastThemeChange
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            OnSelectionChanged="HandleThemeChange"
                        </code>
                    </div>
                </div>

                <!-- Attribute Inference -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Auto Attribute Inference</h3>
                        <MaviDropdown TItem="string" TValue="string"
                                      @bind-Value="_formSampleModel.Country"
                                      Items="@_countries.Select(c => c.Name)"
                                      ElementSize="ElementSize.Regular"
                                      InferFromModelAttributes="true"
                                      StartIcon="lni lni-world"
                                      Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Country)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Label, Required auto-inferred from model
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            InferFromModelAttributes="true"
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 6: Theme Color Schemes -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">6. Theme Color Schemes</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Apply different color themes to match your design system
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Primary -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Primary</h3>
                        <MaviDropdown TItem="Priority" TValue="Priority"
                                      @bind-Value="_formSampleModel.Priority"
                                      Items="_priorities"
                                      ElementSize="ElementSize.Small"
                                      ThemeColorScheme="ThemeColorScheme.Primary"
                                      ShowPlaceholderOption="false"
                                      StartIcon="lni lni-warning"
                                      Width="w-full" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            ThemeColorScheme="ThemeColorScheme.Primary"
                        </code>
                    </div>
                </div>

                <!-- Secondary -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Secondary</h3>
                        <MaviDropdown TItem="Status" TValue="Status"
                                      @bind-Value="_formSampleModel.Status"
                                      Items="_statuses"
                                      ElementSize="ElementSize.Small"
                                      ThemeColorScheme="ThemeColorScheme.Secondary"
                                      StartIcon="lni lni-checkmark-circle"
                                      Width="w-full" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            ThemeColorScheme="ThemeColorScheme.Secondary"
                        </code>
                    </div>
                </div>

                <!-- Success -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Success</h3>
                        <MaviDropdown TItem="Category" TValue="Category"
                                      @bind-Value="_formSampleModel.Category"
                                      Items="_categories"
                                      ElementSize="ElementSize.Small"
                                      ThemeColorScheme="ThemeColorScheme.Success"
                                      StartIcon="lni lni-tag"
                                      Width="w-full" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            ThemeColorScheme="ThemeColorScheme.Success"
                        </code>
                    </div>
                </div>

                <!-- Alert -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Alert</h3>
                        <MaviDropdown TItem="SkillLevel" TValue="SkillLevel"
                                      @bind-Value="_formSampleModel.SkillLevel"
                                      Items="_skiLevels"
                                      ElementSize="ElementSize.Small"
                                      ThemeColorScheme="ThemeColorScheme.Alert"
                                      StartIcon="lni lni-graduation"
                                      Width="w-full" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            ThemeColorScheme="ThemeColorScheme.Alert"
                        </code>
