@page "/PageMaviInputShort"
@inherits SamplePageBase

<PageTitle>MaviInputShort</PageTitle>


<div class="p-6 max-w-7xl mx-auto">
    <!-- Page Header -->
    <div class="mb-8">
        <h1 class="@CssManager.Combine(Tailwind.Theme.Typography.DISPLAY_MEDIUM, "mb-2")">MaviInputShort Component</h1>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_LARGE, "text-gray-600")">
            Comprehensive showcase demonstrating all available parameters, use cases, and formatting options for the MaviInputShort component.
            This component is optimized for 16-bit integer input (Int16), ideal for ages, years, quantities, ratings, and memory-efficient scenarios with values between -32,768 and 32,767.
        </p>
    </div>

    <EditForm Model="@_formSampleModel" OnValidSubmit="OnValidFormSubmit" OnInvalidSubmit="OnInValidFormSubmit" novalidate>
        <DataAnnotationsValidator />

        <!-- Section 1: Size Variants -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">1. Size Variants</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Three size options: Small, Regular (default), and Large - optimized for small integer ranges
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Small -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Small</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.NumberOne"
                                        ElementSize="ElementSize.Small"
                                        StartIcon="lni lni-user"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberOne)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviInputShort
                            @@bind-Value="value"
                            ElementSize="ElementSize.Small"
                            StartIcon="lni lni-user"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>

                <!-- Regular -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Regular (Default)</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.NumberTwo"
                                        ElementSize="ElementSize.Regular"
                                        StartIcon="lni lni-calendar"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberTwo)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviInputShort
                            @@bind-Value="value"
                            ElementSize="ElementSize.Regular"
                            StartIcon="lni lni-calendar"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>

                <!-- Large -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Large</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.NumberThree"
                                        ElementSize="ElementSize.Large"
                                        StartIcon="lni lni-package"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberThree)" />
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviInputShort
                            @@bind-Value="value"
                            ElementSize="ElementSize.Large"
                            StartIcon="lni lni-package"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 2: State Variants -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">2. Input States</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Control input interactivity with Disabled and Readonly states
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Disabled -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Disabled</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.NumberFour"
                                        ElementSize="ElementSize.Small"
                                        Disabled="true"
                                        StartIcon="lni lni-lock"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberFour)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            User cannot interact with disabled inputs
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviInputShort
                            @@bind-Value="value"
                            Disabled="true"
                            StartIcon="lni lni-lock"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>

                <!-- Readonly -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Readonly</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.NumberFive"
                                        ElementSize="ElementSize.Regular"
                                        Readonly="true"
                                        StartIcon="lni lni-eye"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberFive)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Value is visible but not editable
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviInputShort
                            @@bind-Value="value"
                            Readonly="true"
                            StartIcon="lni lni-eye"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>

                <!-- Normal (for comparison) -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Normal (Enabled)</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.NumberSix"
                                        ElementSize="ElementSize.Small"
                                        StartIcon="lni lni-pencil"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.NumberSix)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Fully interactive input
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            &lt;MaviInputShort
                            @@bind-Value="value"
                            StartIcon="lni lni-pencil"
                            Width="w-full" /&gt;
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 3: Format Masks -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">3. Format Masks for Small Integers</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Apply various formatting patterns - values are shown formatted when not focused, raw when editing
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Standard Decimal -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Standard Decimal</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Standard"
                                        ElementSize="ElementSize.Small"
                                        FormatMask="D"
                                        StartIcon="lni lni-hash"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Standard)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Format: 1234
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="D"
                        </code>
                    </div>
                </div>

                <!-- Zero-Padded (4 digits) -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Zero-Padded (4 digits)</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.YearPadded"
                                        ElementSize="ElementSize.Small"
                                        FormatMask="D4"
                                        StartIcon="lni lni-calendar"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.YearPadded)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Format: 2024 (always 4 digits)
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="D4"
                        </code>
                    </div>
                </div>

                <!-- Number with Separators -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Separators</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.WithSeparators"
                                        ElementSize="ElementSize.Small"
                                        FormatMask="N0"
                                        StartIcon="lni lni-text-format"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.WithSeparators)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Format: 12,345
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="N0"
                        </code>
                    </div>
                </div>

                <!-- Hexadecimal -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Hexadecimal</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Hexadecimal"
                                        ElementSize="ElementSize.Small"
                                        FormatMask="X4"
                                        StartIcon="lni lni-code"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Hexadecimal)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Format: 0x3039 (hex)
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="X4"
                        </code>
                    </div>
                </div>

                <!-- Custom Format -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Custom Format</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Custom"
                                        ElementSize="ElementSize.Small"
                                        FormatMask="00000"
                                        StartIcon="lni lni-cog"
                                        Width="w-full" />
                        <ValidationMessage For="@(() => _formSampleModel.Custom)" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Format: 00123 (5-digit zero-padded)
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            FormatMask="00000"
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 4: Real-World Use Cases -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">4. Real-World Use Cases</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Practical examples demonstrating common scenarios for short integer input fields.
                Perfect for values with limited ranges where memory efficiency matters.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Person Age -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Person Age</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Age"
                                        ElementSize="ElementSize.Regular"
                                        Min="0"
                                        Max="150"
                                        StartIcon="lni lni-user"
                                        HelperText="Enter your age (0-150)"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Ideal for age fields
                        </span>
                    </div>
                </div>

                <!-- Birth Year -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Birth Year</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.BirthYear"
                                        ElementSize="ElementSize.Regular"
                                        FormatMask="D4"
                                        Min="1900"
                                        Max="2024"
                                        StartIcon="lni lni-calendar"
                                        HelperText="Enter your birth year"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Perfect for year fields
                        </span>
                    </div>
                </div>

                <!-- Order Quantity -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Order Quantity</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Quantity"
                                        ElementSize="ElementSize.Regular"
                                        Min="1"
                                        Max="999"
                                        StartIcon="lni lni-cart"
                                        HelperText="Quantity (1-999)"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Limited quantity ranges
                        </span>
                    </div>
                </div>

                <!-- Priority Level -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Priority Level</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Priority"
                                        ElementSize="ElementSize.Regular"
                                        Min="1"
                                        Max="100"
                                        StartIcon="lni lni-flag"
                                        HelperText="1 = highest, 100 = lowest"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Priority/ranking systems
                        </span>
                    </div>
                </div>

                <!-- Temperature -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Temperature (°C)</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Temperature"
                                        ElementSize="ElementSize.Regular"
                                        Min="-50"
                                        Max="150"
                                        StartIcon="lni lni-sun"
                                        HelperText="Temperature in Celsius"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Temperature readings
                        </span>
                    </div>
                </div>

                <!-- HTTP Status Code -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">HTTP Status Code</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.StatusCode"
                                        ElementSize="ElementSize.Regular"
                                        FormatMask="D3"
                                        Min="100"
                                        Max="599"
                                        StartIcon="lni lni-code"
                                        HelperText="HTTP response code"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            3-digit status codes
                        </span>
                    </div>
                </div>

                <!-- Percentage (0-100) -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Percentage</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Percentage"
                                        ElementSize="ElementSize.Regular"
                                        Min="0"
                                        Max="100"
                                        StartIcon="lni lni-pie-chart"
                                        HelperText="Enter percentage (0-100)"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Percentage values
                        </span>
                    </div>
                </div>

                <!-- Page Number -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Page Number</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.PageNumber"
                                        ElementSize="ElementSize.Regular"
                                        Min="1"
                                        Max="9999"
                                        StartIcon="lni lni-book"
                                        HelperText="Current page number"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Document pagination
                        </span>
                    </div>
                </div>

                <!-- Employee Count -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Employee Count</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.EmployeeCount"
                                        ElementSize="ElementSize.Regular"
                                        FormatMask="N0"
                                        Min="1"
                                        Max="30000"
                                        StartIcon="lni lni-users"
                                        HelperText="Number of employees"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Small to mid-size companies
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 5: Icons & Interactive Elements -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">5. Icons & Interactive Elements</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Add visual context and interaction through start icons, end icons, buttons, and event handlers
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Start Icon Only -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Start Icon</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Age"
                                        ElementSize="ElementSize.Regular"
                                        Min="0"
                                        Max="150"
                                        StartIcon="lni lni-user"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Icon positioned at input start
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            StartIcon="lni lni-user"
                        </code>
                    </div>
                </div>

                <!-- End Icon & Alternative -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">End Icon with Alternative</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Quantity"
                                        ElementSize="ElementSize.Regular"
                                        Min="1"
                                        Max="999"
                                        EndIcon="lni lni-circle-plus"
                                        EndIconAlternative="lni lni-checkmark"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Switches between two end icons
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            EndIcon="lni lni-circle-plus"
                            EndIconAlternative="lni lni-checkmark"
                        </code>
                    </div>
                </div>

                <!-- With Button -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Action Button</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.BirthYear"
                                        ElementSize="ElementSize.Regular"
                                        FormatMask="D4"
                                        Min="1900"
                                        Max="2024"
                                        ButtonLabel="Set Current Year"
                                        EndIcon="lni lni-calendar"
                                        OnEndIconClick="SetCurrentYear"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            Button sets current year
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            ButtonLabel="Set Current Year"
                            EndIcon="lni lni-calendar"
                            OnEndIconClick="SetCurrentYear"
                        </code>
                    </div>
                </div>

                <!-- Complete Example -->
                <div class="space-y-3">
                    <div>
                        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Complete: Icons + Button</h3>
                        <MaviInputShort @bind-Value="_formSampleModel.Priority"
                                        ElementSize="ElementSize.Regular"
                                        Min="1"
                                        Max="100"
                                        StartIcon="lni lni-flag"
                                        EndIcon="lni lni-reload"
                                        EndIconAlternative="lni lni-checkmark"
                                        ButtonLabel="Reset Priority"
                                        OnEndIconClick="ResetPriority"
                                        Width="w-full" />
                        <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                            All icon and button features combined
                        </span>
                    </div>
                    <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                        <code class="text-xs">
                            StartIcon="lni lni-flag"
                            EndIcon="lni lni-reload"
                            EndIconAlternative="lni lni-checkmark"
                            ButtonLabel="Reset Priority"
                            OnEndIconClick="HandleClick"
                        </code>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 6: Understanding Short (Int16) Range -->
        <div class="mb-12">
            <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">6. Understanding Short (Int16) Range</h2>
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
                Understanding the capabilities, limitations, and memory efficiency of 16-bit integers
            </p>

            <div class="bg-blue-50 border-l-4 border-blue-500 p-6 mb-6">
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-3 text-blue-900")">Range & Capacity</h3>
                <div class="space-y-2 text-blue-900">
                    <p class="@Tailwind.Theme.Typography.BODY_MEDIUM">
                        <strong>Minimum:</strong> -32,768
                    </p>
