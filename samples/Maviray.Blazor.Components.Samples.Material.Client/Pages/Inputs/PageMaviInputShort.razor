@code {
    private readonly SampleShortModel _formSampleModel = new();

    private void OnValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form validation successful.");
    }

    private void OnInValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form validation failed.");
    }

    private async Task SetCurrentYear(MouseClickEventArgs args)
    {
        Logger?.LogInformation("Setting current year for input: {ButtonId}", args.ButtonId);
        _formSampleModel.BirthYear = (short)DateTime.Now.Year;
        await Task.Delay(500);
        Logger?.LogInformation("Year set to: {Year}", _formSampleModel.BirthYear);
    }

    private async Task ResetPriority(MouseClickEventArgs args)
    {
        Logger?.LogInformation("Resetting priority for input: {ButtonId}", args.ButtonId);
        _formSampleModel.Priority = 50; // Default to medium priority
        await Task.Delay(500);
        Logger?.LogInformation("Priority reset to: {Priority}", _formSampleModel.Priority);
    }
}