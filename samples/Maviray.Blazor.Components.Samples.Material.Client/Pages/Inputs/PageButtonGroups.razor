                                     Buttons="@GenerateTextButtonGroup()" />
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, "text-gray-600")">Dark</span>
                </div>
                <div class="flex flex-col gap-2 items-center">
                    <MaviButtonGroup ElementVariant="ElementVariant.Filled"
                                     ElementSize="ElementSize.Regular"
                                     ThemeColorScheme="ThemeColorScheme.Light"
                                     OnClick="OnButtonGroupClick"
                                     Buttons="@GenerateTextButtonGroup()" />
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, "text-gray-600")">Light</span>
                </div>
            </div>
        </div>

        <div class="space-y-4">
            <h3 class="@Tailwind.Theme.Typography.TITLE_MEDIUM">Outlined Variant - All Colors</h3>
            <div class="flex flex-wrap gap-4">
                <div class="flex flex-col gap-2 items-center">
                    <MaviButtonGroup ElementVariant="ElementVariant.Outlined"
