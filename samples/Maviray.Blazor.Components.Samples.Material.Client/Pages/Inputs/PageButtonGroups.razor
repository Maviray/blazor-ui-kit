                <div class="flex items-center gap-4">
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_MEDIUM, "w-24 text-gray-600")">Outlined:</span>
                    <MaviButtonGroup ElementVariant="ElementVariant.Outlined"
                                     ElementSize="ElementSize.Regular"
                                     ThemeColorScheme="ThemeColorScheme.Primary"
                                     OnClick="OnButtonGroupClick"
                                     Buttons="@GenerateTextButtonGroup()" />
                </div>
                <div class="flex items-center gap-4">
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_MEDIUM, "w-24 text-gray-600")">Text:</span>
                    <MaviButtonGroup ElementVariant="ElementVariant.Text"
                                     ElementSize="ElementSize.Regular"
                                     ThemeColorScheme="ThemeColorScheme.Primary"
                                     OnClick="OnButtonGroupClick"
                                     Buttons="@GenerateTextButtonGroup()" />
                </div>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 border border-gray-200 rounded-lg p-4")">
                <code class="text-purple-600">
                    &lt;MaviButtonGroup ElementVariant="ElementVariant.Filled" ... /&gt;<br />
                    &lt;MaviButtonGroup ElementVariant="ElementVariant.Outlined" ... /&gt;<br />
                    &lt;MaviButtonGroup ElementVariant="ElementVariant.Text" ... /&gt;
                </code>
            </div>
        </div>
    </section>

    <!-- Section 5: Color Schemes -->
    <section class="space-y-6">
        <div class="space-y-2">
            <h2 class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM">Color Schemes</h2>
            <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-gray-600">
