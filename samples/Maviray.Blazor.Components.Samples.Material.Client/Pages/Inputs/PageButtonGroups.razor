                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, "text-gray-600")">Secondary</span>
                </div>
                <div class="flex flex-col gap-2 items-center">
                    <MaviButtonGroup ElementVariant="ElementVariant.Outlined"
                                     ElementSize="ElementSize.Regular"
                                     ThemeColorScheme="ThemeColorScheme.Success"
                                     OnClick="OnButtonGroupClick"
                                     Buttons="@GenerateTextButtonGroup()" />
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, "text-gray-600")">Success</span>
                </div>
                <div class="flex flex-col gap-2 items-center">
                    <MaviButtonGroup ElementVariant="ElementVariant.Outlined"
                                     ElementSize="ElementSize.Regular"
                                     ThemeColorScheme="ThemeColorScheme.Alert"
                                     OnClick="OnButtonGroupClick"
                                     Buttons="@GenerateTextButtonGroup()" />
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, "text-gray-600")">Danger</span>
                </div>
                <div class="flex flex-col gap-2 items-center">
                    <MaviButtonGroup ElementVariant="ElementVariant.Outlined"
                                     ElementSize="ElementSize.Regular"
                                     ThemeColorScheme="ThemeColorScheme.Warning"
                                     OnClick="OnButtonGroupClick"
                                     Buttons="@GenerateTextButtonGroup()" />
                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, "text-gray-600")">Warning</span>
                </div>
                <div class="flex flex-col gap-2 items-center">
                    <MaviButtonGroup ElementVariant="ElementVariant.Outlined"
