                    <span class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_SMALL, "text-gray-600")">Primary</span>
                </div>
                <div class="flex flex-col gap-2 items-center">
                    <MaviButtonGroup ElementVariant="ElementVariant.Outlined"
