@code {
    private readonly SampleStringModel _formSampleModel = new();

    private void OnValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form validation successful.");
    }

    private void OnInValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form validation failed.");
    }

    private async Task ValidateUrl(MouseClickEventArgs args)
    {
        Logger?.LogInformation("URL validation started for input: {ButtonId}", args.ButtonId);
        await Task.Delay(1500); // Simulate validation
        Logger?.LogInformation("URL validation completed for input: {ButtonId}", args.ButtonId);
    }

    private async Task HandleTagAction(MouseClickEventArgs args)
    {
        Logger?.LogInformation("Tag action triggered for input: {ButtonId}", args.ButtonId);
        await Task.Delay(500);
        Logger?.LogInformation("Tag action completed for input: {ButtonId}", args.ButtonId);
    }
}