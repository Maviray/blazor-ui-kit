@page "/PageMaviSwitch"
@using Maviray.Blazor.Components.Core.Models
@using Maviray.Blazor.Components.Material.Components
@inherits SamplePageBase

<PageTitle>MaviSwitch</PageTitle>


<div class="flex flex-col gap-4">
    <div class="flex gap-4">
        <MaviSwitch @bind-Value="_medium"
                    Label="Dark mode"
                    ThemeColorScheme="ThemeColorScheme.Dark"
                    ElementSize="ElementSize.Small"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_small"
                    Label="Enable notifications"
                    ThemeColorScheme="ThemeColorScheme.Primary"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_large"
                    Label="I agree to the terms"
                    ElementSize="ElementSize.Large"
                    SwitchStatusChange="HandleButtonValueChange" />
    </div>
    <div class="flex gap-4">
        <MaviSwitch @bind-Value="_primary"
                    Title="Enable notifications"
                    ThemeColorScheme="ThemeColorScheme.Primary"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_secondary"
                    Title="Enable notifications"
                    ThemeColorScheme="ThemeColorScheme.Secondary"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_success"
                    Title="Enable notifications"
                    ThemeColorScheme="ThemeColorScheme.Success"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_alert"
                    Title="Enable notifications"
                    ThemeColorScheme="ThemeColorScheme.Alert"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_warning"
                    Title="Enable notifications"
                    ThemeColorScheme="ThemeColorScheme.Warning"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_info"
                    Title="Enable notifications"
                    ThemeColorScheme="ThemeColorScheme.Info"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_dark"
                    Title="Enable notifications"
                    ThemeColorScheme="ThemeColorScheme.Dark"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_lite"
                    Title="Enable notifications"
                    ThemeColorScheme="ThemeColorScheme.Light"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />
    </div>
    <div class="flex gap-4">
        <MaviSwitch @bind-Value="_disabled"
                    Label="Disabled"
                    Disabled="true"
                    ThemeColorScheme="ThemeColorScheme.Dark"
                    ElementSize="ElementSize.Small"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_disabledTwo"
                    Label="Disabled"
                    Disabled="true"
                    ThemeColorScheme="ThemeColorScheme.Dark"
                    ElementSize="ElementSize.Small"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_reaedonly"
                    Label="Readonly"
                    Readonly="true"
                    ThemeColorScheme="ThemeColorScheme.Primary"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_reaedonlyTwo"
                    Label="Readonly"
                    Readonly="true"
                    ThemeColorScheme="ThemeColorScheme.Primary"
                    ElementSize="ElementSize.Regular"
                    SwitchStatusChange="HandleButtonValueChange" />

        <MaviSwitch @bind-Value="_active"
                    Label="Enabled"
                    ElementSize="ElementSize.Large"
                    SwitchStatusChange="HandleButtonValueChange" />
    </div>
</div>

@code
{
    private bool _small = false;
    private bool _medium = false;
    private bool _large = false;

    private bool _primary = false;
    private bool _secondary = false;
    private bool _success = false;

    private bool _alert = false;
    private bool _warning = false;
    private bool _info = false;

    private bool _dark = false;
    private bool _lite = false;

    private bool _disabled = false;
    private bool _disabledTwo = true;
    private bool _reaedonly = false;
    private bool _reaedonlyTwo = true;
    private bool _active = false;

    private Task HandleButtonValueChange(ValueChangedCallbackParameters<bool> args)
    {
        Logger?.LogInformation("CheckBox: {ButtonId} Status: {Status}", args.ElementId, args.Value);
        return Task.CompletedTask;
    }
}
