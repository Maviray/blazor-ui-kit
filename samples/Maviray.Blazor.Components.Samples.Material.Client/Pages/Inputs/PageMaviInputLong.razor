    private readonly SampleLongModel _formSampleModel = new();

    private void OnValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form validation successful.");
    }

    private void OnInValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form validation failed.");
    }

    private async Task GetCurrentTimestamp(MouseClickEventArgs args)
    {
        Logger?.LogInformation("Getting current timestamp for input: {ButtonId}", args.ButtonId);
        _formSampleModel.UnixTimestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        await Task.Delay(500); // Simulate processing
        Logger?.LogInformation("Timestamp set to: {Timestamp}", _formSampleModel.UnixTimestamp);
    }

    private async Task SimulateCalculation(MouseClickEventArgs args)
    {
        Logger?.LogInformation("Calculation started for input: {ButtonId}", args.ButtonId);
        await Task.Delay(2000); // Simulate processing
        Logger?.LogInformation("Calculation completed for input: {ButtonId}", args.ButtonId);
    }
}