    private ThemeColorScheme GetTemperatureColor()
    {
        if (temperature < 20) return ThemeColorScheme.Info;
        if (temperature < 24) return ThemeColorScheme.Success;
        if (temperature < 27) return ThemeColorScheme.Warning;
        return ThemeColorScheme.Alert;
    }
