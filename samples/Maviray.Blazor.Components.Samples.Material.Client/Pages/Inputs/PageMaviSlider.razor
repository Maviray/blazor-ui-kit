    private Task HandleSliderValueChange(ValueChangedCallbackParameters<double> args)
    {
        Logger?.LogInformation("Slider: {SliderId} Value: {Value}", args.ElementId, args.Value);
        lastEventInfo = $"ElementId: {args.ElementId}, Value: {args.Value:F2}";
        StateHasChanged();
        return Task.CompletedTask;
