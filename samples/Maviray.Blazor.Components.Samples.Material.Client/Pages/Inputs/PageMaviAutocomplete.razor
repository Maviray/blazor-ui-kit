@page "/PageMaviAutocomplete"
@using System.ComponentModel.DataAnnotations
@using Maviray.Blazor.Components.Core.Models
@using Maviray.Blazor.Components.Material.Components
@inherits SamplePageBase

<PageTitle>MaviAutocomplete</PageTitle>


<div class="p-6 max-w-7xl mx-auto">
<!-- Page Header -->
<div class="mb-8">
    <h1 class="@CssManager.Combine(Tailwind.Theme.Typography.DISPLAY_MEDIUM, "mb-2")">MaviAutoComplete Component</h1>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_LARGE, "text-gray-600")">
        Comprehensive showcase demonstrating all available parameters, use cases, and search patterns for the MaviAutoComplete component.
    </p>
</div>

<EditForm Model="@_formSampleModel" OnValidSubmit="OnValidFormSubmit" OnInvalidSubmit="OnInValidFormSubmit" novalidate>
<DataAnnotationsValidator />

<!-- Section 1: Size Variants -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">1. Size Variants</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Three size options: Small, Regular (default), and Large
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Small -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Small</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.Country"
                                  Label="Country"
                                  OnSearch="SearchCountries"
                                  OnValueSelected="HandleCountrySelected"
                                  ElementSize="ElementSize.Small"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <ValidationMessage For="@(() => _formSampleModel.Country)" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ElementSize="ElementSize.Small"
                </code>
            </div>
        </div>

        <!-- Regular -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Regular (Default)</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.City"
                                  Label="City"
                                  OnSearch="SearchCities"
                                  ElementSize="ElementSize.Regular"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <ValidationMessage For="@(() => _formSampleModel.City)" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ElementSize="ElementSize.Regular"
                </code>
            </div>
        </div>

        <!-- Large -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Large</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.Language"
                                  Label="Language"
                                  OnSearch="SearchLanguages"
                                  ElementSize="ElementSize.Large"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <ValidationMessage For="@(() => _formSampleModel.Language)" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ElementSize="ElementSize.Large"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 2: States (Disabled, Readonly) -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">2. AutoComplete States</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Control autocomplete interactivity with Disabled and Readonly states
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Disabled -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Disabled</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_selectedOccupationOne"
                                  Label="Department"
                                  OnSearch="SearchDepartments"
                                  Disabled="true"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    User cannot interact with disabled autocomplete
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    Disabled="true"
                </code>
            </div>
        </div>

        <!-- Readonly -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Readonly</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_selectedOccupationTwo"
                                  Label="Job Role"
                                  OnSearch="SearchJobRoles"
                                  Readonly="true"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Value is visible but not searchable
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    Readonly="true"
                </code>
            </div>
        </div>

        <!-- Normal (for comparison) -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Normal (Enabled)</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.Skill"
                                  Label="Skills"
                                  OnSearch="SearchSkills"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Fully interactive autocomplete
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    Default state - fully enabled
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 3: Complex Object Binding -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">3. Complex Object Binding</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Search and select complex objects with custom text selectors
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Country Object -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Country (Complex Object)</h3>
                <MaviAutoComplete TItem="CountryInfo"
                                  @bind-Value="_selectedCountryInfo"
                                  Label="Select Country"
                                  OnSearch="SearchCountryObjects"
                                  ItemTextSelector="@(c => c.Name)"
                                  OnValueSelected="HandleCountryInfoSelected"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Selected: @(_selectedCountryInfo?.Name ?? "None") (@(_selectedCountryInfo?.Code ?? "N/A"))
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    TItem="CountryInfo"<br />
                    ItemTextSelector="@@(c => c.Name)"
                </code>
            </div>
        </div>

        <!-- User Object with Custom Template -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">User (Custom Template)</h3>
                <MaviAutoComplete TItem="UserInfo"
                                  @bind-Value="_selectedUser"
                                  Label="Search Users"
                                  OnSearch="SearchUsers"
                                  ItemTextSelector="@(u => u.Name)"
                                  OnValueSelected="HandleUserSelected"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full">
                    <ItemTemplate Context="user">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-(--theme-primary-two) flex items-center justify-center text-(--theme-primary-eight) font-semibold">
                                @user.Name.Substring(0, 1).ToUpper()
                            </div>
                            <div>
                                <div class="font-medium">@user.Name</div>
                                <div class="text-xs text-(--theme-default-seven)">@user.Email</div>
                            </div>
                        </div>
                    </ItemTemplate>
                </MaviAutoComplete>
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Selected: @(_selectedUser?.Name ?? "None")
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    &lt;ItemTemplate Context="user"&gt;<br />
                    &nbsp;&nbsp;Custom rendering<br />
                    &lt;/ItemTemplate&gt;
                </code>
            </div>
        </div>

        <!-- Product Search -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Product Search</h3>
                <MaviAutoComplete TItem="ProductInfo"
                                  @bind-Value="_selectedProduct"
                                  Label="Search Products"
                                  OnSearch="SearchProducts"
                                  ItemTextSelector="@(p => $"{p.Name} - ${p.Price}")"
                                  MinSearchLength="2"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Min 2 characters to search
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    MinSearchLength="2"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 4: Search Behavior Configuration -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">4. Search Behavior Configuration</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Configure debounce delay, min search length, and result limits
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Fast Debounce (100ms) -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Fast Search (100ms)</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.FastSearch"
                                  Label="Fast Debounce"
                                  OnSearch="SearchCities"
                                  DebounceDelay="100"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    100ms debounce - very responsive
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    DebounceDelay="100"
                </code>
            </div>
        </div>

        <!-- Default Debounce (300ms) -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Default (300ms)</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.DefaultSearch"
                                  Label="Default Debounce"
                                  OnSearch="SearchCities"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    300ms debounce - balanced
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    Default: 300ms
                </code>
            </div>
        </div>

        <!-- Slow Debounce (600ms) -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Slow Search (600ms)</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.SlowSearch"
                                  Label="Slow Debounce"
                                  OnSearch="SearchCities"
                                  DebounceDelay="600"
                                  StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    600ms debounce - reduces API calls
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    DebounceDelay="600"
                </code>
            </div>
        </div>

        <!-- Limited Results -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Limited Results (5)</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.LimitedResults"
                                  Label="Max 5 Results"
                                  OnSearch="SearchCities"
                                  MaxDisplayItems="5"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Shows max 5 results
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    MaxDisplayItems="5"
                </code>
            </div>
        </div>

        <!-- Min Search Length -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Min 3 Characters</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.MinLength"
                                  Label="Min 3 Chars"
                                  OnSearch="SearchCities"
                                  MinSearchLength="3"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Requires 3+ characters
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    MinSearchLength="3"
                </code>
            </div>
        </div>

        <!-- Clear On Select -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Clear On Select</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.ClearOnSelect"
                                  Label="Tags"
                                  OnSearch="SearchSkills"
                                  ClearOnSelect="true"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Clears input after selection
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ClearOnSelect="true"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 5: Advanced Features -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">5. Advanced Features</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Custom messages, helper text, required fields, and event handling
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Custom No Results Message -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Custom No Results</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.NoResults"
                                  Label="Custom Message"
                                  OnSearch="SearchCities"
                                  NoResultsText="😔 No cities found matching your search"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Try searching for "xyz" to see custom message
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    NoResultsText="Custom message"
                </code>
            </div>
        </div>

        <!-- With Helper Text -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Helper Text</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.WithHelper"
                                  Label="Email"
                                  OnSearch="SearchEmails"
                                  HelperText="Start typing to search from your contacts"
                                  StartIcon="lni lni-gears-3"
                                  Width="w-full" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    HelperText="Helpful guidance text"
                </code>
            </div>
        </div>

        <!-- Required Field -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Required Field</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.Country"
                                  Label="Country"
                                  OnSearch="SearchCountries"
                                  Required="true"
                                  StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <ValidationMessage For="@(() => _formSampleModel.Country)" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    Required="true"
                </code>
            </div>
        </div>

        <!-- With Selection Event -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Selection Event</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.Technology"
                                  Label="Technology"
                                  OnSearch="SearchTechnologies"
                                  OnValueSelected="HandleTechnologySelected"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
                <span class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-500")">
                    Last selection: @_lastTechnologySelection
                </span>
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    OnValueSelected="HandleEvent"
                </code>
            </div>
        </div>
    </div>
</div>

<!-- Section 6: Theme Color Schemes -->
<div class="mb-12">
    <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">6. Theme Color Schemes</h2>
    <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
        Apply different color themes to match your design system
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Primary -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Primary</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.ThemePrimary"
                                  Label="Primary Theme"
                                  OnSearch="SearchCities"
                                  ThemeColorScheme="ThemeColorScheme.Primary"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ThemeColorScheme="Primary"
                </code>
            </div>
        </div>

        <!-- Secondary -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Secondary</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.ThemeSecondary"
                                  Label="Secondary Theme"
                                  OnSearch="SearchCities"
                                  ThemeColorScheme="ThemeColorScheme.Secondary"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ThemeColorScheme="Secondary"
                </code>
            </div>
        </div>

        <!-- Success -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Success</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.ThemeSuccess"
                                  Label="Success Theme"
                                  OnSearch="SearchCities"
                                  ThemeColorScheme="ThemeColorScheme.Success"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ThemeColorScheme="Success"
                </code>
            </div>
        </div>

        <!-- Alert -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Alert</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.ThemeAlert"
                                  Label="Alert Theme"
                                  OnSearch="SearchCities"
                                  ThemeColorScheme="ThemeColorScheme.Alert"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
            </div>
            <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                <code class="text-xs">
                    ThemeColorScheme="Alert"
                </code>
            </div>
        </div>

        <!-- Warning -->
        <div class="space-y-3">
            <div>
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Warning</h3>
                <MaviAutoComplete TItem="string"
                                  @bind-Value="_formSampleModel.ThemeWarning"
                                  Label="Warning Theme"
                                  OnSearch="SearchCities"
                                  ThemeColorScheme="ThemeColorScheme.Warning"
                                          StartIcon="lni lni-gears-3"
                                  Width="w-full" />
            </div>
