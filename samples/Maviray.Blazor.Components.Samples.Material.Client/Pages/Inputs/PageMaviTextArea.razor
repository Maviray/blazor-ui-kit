@code {
    private readonly SampleTextAreaModel _formSampleModel = new();
    private MaviTextArea? _liveTextArea;
    private string? _capturedText;

    private void OnValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form validation successful.");
    }

    private void OnInValidFormSubmit(EditContext context)
    {
        Logger?.LogInformation("Form validation failed.");
    }

    private void CaptureText()
    {
        _capturedText = _liveTextArea?.GetCurrentText() ?? string.Empty;
        Logger?.LogInformation("Captured textarea content ({Length} chars).", _capturedText.Length);
    }

}