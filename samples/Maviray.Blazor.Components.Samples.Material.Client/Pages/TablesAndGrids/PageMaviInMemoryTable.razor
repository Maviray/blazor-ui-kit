@page "/PageMaviInMemoryTable"
@using Maviray.Blazor.Components.Core.Extensions
@using Maviray.Blazor.Components.Core.Models.Tables
@using Maviray.Blazor.Components.Material.Components.Tables
@using Maviray.Blazor.Components.Samples.Material.Client.Enums
@inherits SamplePageBase

<PageTitle>MaviInMemoryTable</PageTitle>

<div class="p-6 max-w-7xl mx-auto">
    <!-- Page Header -->
    <div class="mb-8">
        <h1 class="@CssManager.Combine(Tailwind.Theme.Typography.DISPLAY_MEDIUM, "mb-2")">MaviInMemoryTable Component</h1>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_LARGE, "text-gray-600")">
            Comprehensive showcase demonstrating all available parameters, features, and configuration options for the MaviInMemoryTable component.
        </p>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_LARGE, "text-gray-600 mt-2")">
            MaviInMemoryTable is a component aimed at providing simple table with basic paging, sorting and filtering capabilities. Its purpose is to serve as a quick solution to standard requirements of data display. It is not designed to be a feature-rich highly customizable component to address all potential requirements or handle complex mechanics of displaying millions of data records dynamically. This is driven by the reality where I find myself often needing just a simple solution to display a collection of data.
        </p>
    </div>

    <!-- Section 1: Basic Table with All Features -->
    <div class="mb-12">
        <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">1. Full-Featured Table</h2>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
            Table with sorting, filtering, pagination, and row context menus
        </p>

        <div class="bg-white  p-4">
            <MaviInMemoryTable @ref="_maviInMemoryTable" 
                               FetchData="FetchDataFullFeatures"
                               ConstructContextMenu="ConstructMainContextMenu"
                               OnMainContextMenuClick="OnMainContextMenuClick"
                               OnRowClick="OnRowClick"
                               Parameters="_fullFeaturedParameters"
                               OnRowContextMenuClick="OnRowContextMenuClick">
            </MaviInMemoryTable>
        </div>
        
        <div>
            <MaviButton ThemeColorScheme="ThemeColorScheme.Primary"
                        ElementVariant="ElementVariant.Outlined"
                        ElementSize="ElementSize.Regular"
                        Title="Simulate Table Data Load"
                        TextTransform="TextTransform.UpperCase"
                        OnClick="SimulateDataLoad">
            </MaviButton>
        </div>

        <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-4 rounded-md mt-4")">
            <code class="text-xs block whitespace-pre-wrap">
private readonly TableParameters _parameters = new()
{
    TableRowContextMenuDisplayStyle = TableRowContextMenuDisplayStyle.Icons,
    EnableFilters = true,
    PaginationHorizontalAlignment = ElementHorizontalAlignment.Center,
    ContentMenuTitle = "Table Actions",
    FilterPlaceholderText = "Search...",
    NoDataAvailableTitle = "No data available to display",
    RowsPerPageText = "Rows per page"
};

&lt;MaviInMemoryTable FetchData="FetchData"
                   ConstructContextMenu="ConstructContextMenu"
                   OnMainContextMenuClick="OnMainContextMenuClick"
                   OnRowClick="OnRowClick"
                   Parameters="_parameters"
                   OnRowContextMenuClick="OnRowContextMenuClick"&gt;
&lt;/MaviInMemoryTable&gt;
            </code>
        </div>
    </div>

    <!-- Section 2: Row Context Menu Display Styles -->
    <div class="mb-12">
        <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">2. Row Context Menu Display Styles</h2>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
            Choose between icon-based or dropdown-based row actions
        </p>

        <div class="flex flex-col gap-4">
            <!-- Icons Style -->
            <div class="space-y-3">
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Icon Display Style</h3>
                <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-600 mb-3")">
                    Actions shown as individual icon buttons
                </p>
                <div class="bg-white  p-4">
                    <MaviInMemoryTable FetchData="FetchDataIconStyle"
                                       OnRowClick="OnRowClick"
                                       Parameters="_iconStyleParameters"
                                       OnRowContextMenuClick="OnRowContextMenuClick">
                    </MaviInMemoryTable>
                </div>
                <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                    <code class="text-xs">
                        TableRowContextMenuDisplayStyle = TableRowContextMenuDisplayStyle.Icons
                    </code>
                </div>
            </div>

            <!-- Dropdown Style -->
            <div class="space-y-3">
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Dropdown Display Style</h3>
                <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-600 mb-3")">
                    Actions shown in a dropdown menu
                </p>
                <div class="bg-white  p-4">
                    <MaviInMemoryTable FetchData="FetchDataDropdownStyle"
                                       OnRowClick="OnRowClick"
                                       Parameters="_dropdownStyleParameters"
                                       OnRowContextMenuClick="OnRowContextMenuClick">
                    </MaviInMemoryTable>
                </div>
                <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                    <code class="text-xs">
                        TableRowContextMenuDisplayStyle = TableRowContextMenuDisplayStyle.DropDown
                    </code>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 3: Pagination Alignment -->
    <div class="mb-12">
        <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">3. Pagination Alignment</h2>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
            Control pagination controls alignment: Left, Center, or Right
        </p>

        <div class="grid grid-cols-1 gap-6">
            <!-- Left Alignment -->
            <div class="space-y-3">
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Left Alignment</h3>
                <div class="bg-white  p-4">
                    <MaviInMemoryTable FetchData="FetchDataPaginationLeft"
                                       Parameters="_paginationLeftParameters"
                                       OnRowClick="OnRowClick">
                    </MaviInMemoryTable>
                </div>
                <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                    <code class="text-xs">
                        PaginationHorizontalAlignment = ElementHorizontalAlignment.Left
                    </code>
                </div>
            </div>

            <!-- Center Alignment -->
            <div class="space-y-3">
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Center Alignment</h3>
                <div class="bg-white  p-4">
                    <MaviInMemoryTable FetchData="FetchDataPaginationCenter"
                                       Parameters="_paginationCenterParameters"
                                       OnRowClick="OnRowClick">
                    </MaviInMemoryTable>
                </div>
                <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                    <code class="text-xs">
                        PaginationHorizontalAlignment = ElementHorizontalAlignment.Center
                    </code>
                </div>
            </div>

            <!-- Right Alignment (Default) -->
            <div class="space-y-3">
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Right Alignment (Default)</h3>
                <div class="bg-white  p-4">
                    <MaviInMemoryTable FetchData="FetchDataPaginationRight"
                                       Parameters="_paginationRightParameters"
                                       OnRowClick="OnRowClick">
                    </MaviInMemoryTable>
                </div>
                <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                    <code class="text-xs">
                        PaginationHorizontalAlignment = ElementHorizontalAlignment.Right
                    </code>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 4: Filtering Options -->
    <div class="mb-12">
        <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">4. Filtering Options</h2>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
            Enable or disable column-based filtering
        </p>

        <div class="flex flex-col gap-4">
            <!-- With Filters -->
            <div class="space-y-3">
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">With Filters Enabled</h3>
                <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-600 mb-3")">
                    Filter inputs appear below each column header
                </p>
                <div class="bg-white  p-4">
                    <MaviInMemoryTable FetchData="FetchDataWithFilters"
                                       Parameters="_withFiltersParameters"
                                       OnRowClick="OnRowClick">
                    </MaviInMemoryTable>
                </div>
                <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                    <code class="text-xs">
                        EnableFilters = true
                    </code>
                </div>
            </div>

            <!-- Without Filters -->
            <div class="space-y-3">
                <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "mb-2")">Without Filters</h3>
                <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-gray-600 mb-3")">
                    Clean table without filter inputs
                </p>
                <div class="bg-white  p-4">
                    <MaviInMemoryTable FetchData="FetchDataWithoutFilters"
                                       Parameters="_withoutFiltersParameters"
                                       OnRowClick="OnRowClick">
                    </MaviInMemoryTable>
                </div>
                <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-3 rounded-md")">
                    <code class="text-xs">
                        EnableFilters = false
                    </code>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 5: Custom Text Labels -->
    <div class="mb-12">
        <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">5. Custom Text Labels</h2>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
            Customize all text labels for localization or branding
        </p>

        <div class="bg-white  p-4">
            <MaviInMemoryTable FetchData="FetchDataCustomLabels"
                               Parameters="_customLabelsParameters"
                               OnRowClick="OnRowClick">
            </MaviInMemoryTable>
        </div>

        <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-4 rounded-md mt-4")">
            <code class="text-xs block whitespace-pre-wrap">
private readonly TableParameters _customLabelsParameters = new()
{
    ContentMenuTitle = "🔧 Actions",
    NoDataAvailableTitle = "📋 No records found in the system",
    RowsPerPageText = "📊 Items per page",
    SelectNumberOfRowsToDisplayText = "Choose page size",
    GoToPreviousPageText = "⬅️ Previous",
    GoToNextPageText = "Next ➡️",
    FilterPlaceholderText = "🔍 Type to filter..."
};
            </code>
        </div>
    </div>

    <!-- Section 6: Main Context Menu -->
    <div class="mb-12">
        <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">6. Main Context Menu</h2>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
            Add table-level actions with a main context menu
        </p>

        <div class="bg-white  p-4">
            <MaviInMemoryTable FetchData="FetchDataWithMainMenu"
                               ConstructContextMenu="ConstructMainContextMenu"
                               OnMainContextMenuClick="OnMainContextMenuClick"
                               Parameters="_mainMenuParameters"
                               OnRowClick="OnRowClick">
            </MaviInMemoryTable>
        </div>

        <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-4 rounded-md mt-4")">
            <code class="text-xs block whitespace-pre-wrap">
private Task&lt;IEnumerable&lt;MaviTableContextMenuItem&gt;&gt; ConstructContextMenu()
{
    IEnumerable&lt;MaviTableContextMenuItem&gt; menu = new List&lt;MaviTableContextMenuItem&gt;()
    {
        new() { Id = "export", Title = "Export to CSV" },
        new() { Id = "import", Title = "Import Data" },
        new() { Id = "refresh", Title = "Refresh Table" },
        new() { Id = "settings", Title = "Table Settings" }
    };
    
    return Task.FromResult(menu);
}

private Task OnMainContextMenuClick(MaviTableContextMenuItem item)
{
    Logger?.LogInformation($"Main menu clicked: {item.Title}");
    return Task.CompletedTask;
}
            </code>
        </div>

        <div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-md">
            <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-blue-800")">
                💡 <strong>Last Action:</strong> @_lastMainMenuAction
            </p>
        </div>
    </div>

    <!-- Section 7: Event Handling -->
    <div class="mb-12">
        <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">7. Event Handling</h2>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
            Handle row clicks and context menu interactions
        </p>

        <div class="bg-white  p-4">
            <MaviInMemoryTable FetchData="FetchDataEventHandling"
                               Parameters="_eventHandlingParameters"
                               OnRowClick="OnRowClickWithLogging"
                               OnRowContextMenuClick="OnRowContextMenuClickWithLogging">
            </MaviInMemoryTable>
        </div>

        <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-4 rounded-md mt-4")">
            <code class="text-xs block whitespace-pre-wrap">
private Task OnRowClick(TableClickData data)
{
    var row = data.Row;
    var column = data.Column;
    Logger?.LogInformation($"Row clicked - ID: {row?.Id}, Column: {column?.Key}");
    return Task.CompletedTask;
}

private Task OnRowContextMenuClick(MaviTableRowContextMenuItem menuItem)
{
    Logger?.LogInformation($"Row action: {menuItem.Key} - {menuItem.Title}");
    // Handle action (edit, delete, etc.)
    return Task.CompletedTask;
}
            </code>
        </div>

        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-4 bg-green-50 border border-green-200 rounded-md">
                <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-green-800")">
                    🖱️ <strong>Last Row Click:</strong> @_lastRowClick
                </p>
            </div>
            <div class="p-4 bg-purple-50 border border-purple-200 rounded-md">
                <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "text-purple-800")">
                    ⚡ <strong>Last Row Action:</strong> @_lastRowAction
                </p>
            </div>
        </div>
    </div>

    <!-- Section 8: Complete Parameter Reference -->
    <div class="mb-12">
        <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">8. Complete Parameter Reference</h2>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
            All available parameters for MaviInMemoryTable component
        </p>

        <div class="overflow-x-auto bg-white shadow-md rounded-lg">
            <table class="min-w-full">
                <thead class="@CssManager.Combine(Tailwind.Theme.Colors.Background.THEME_LIGHT_FOUR_BG)">
                    <tr>
                        <th class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "px-6 py-3 text-left")">Parameter</th>
                        <th class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "px-6 py-3 text-left")">Type</th>
                        <th class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "px-6 py-3 text-left")">Default</th>
                        <th class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "px-6 py-3 text-left")">Description</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <tr>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>FetchData</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Func&lt;Task&lt;TableDataCollection&gt;&gt;</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Required</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Function that returns table data</td>
                    </tr>
                    <tr class="@Tailwind.Theme.Colors.Background.THEME_LIGHT_ONE_BG">
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>Parameters</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">TableParameters</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">new()</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Configuration object for table behavior</td>
                    </tr>
                    <tr>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>ConstructContextMenu</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Func&lt;Task&lt;IEnumerable&lt;MaviTableContextMenuItem&gt;&gt;&gt;</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">null</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Builds main context menu</td>
                    </tr>
                    <tr class="@Tailwind.Theme.Colors.Background.THEME_LIGHT_ONE_BG">
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>OnMainContextMenuClick</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">EventCallback&lt;MaviTableContextMenuItem&gt;</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">null</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Main context menu click event</td>
                    </tr>
                    <tr>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>OnRowClick</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">EventCallback&lt;TableClickData&gt;</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">null</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Row/cell click event</td>
                    </tr>
                    <tr class="@Tailwind.Theme.Colors.Background.THEME_LIGHT_ONE_BG">
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>OnRowContextMenuClick</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">EventCallback&lt;MaviTableRowContextMenuItem&gt;</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">null</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Row context menu click event</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <h3 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_SMALL, "mt-8 mb-4")">TableParameters Properties</h3>
        
        <div class="overflow-x-auto bg-white shadow-md rounded-lg">
            <table class="min-w-full">
                <thead class="@CssManager.Combine(Tailwind.Theme.Colors.Background.THEME_LIGHT_FOUR_BG)">
                    <tr>
                        <th class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "px-6 py-3 text-left")">Property</th>
                        <th class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "px-6 py-3 text-left")">Type</th>
                        <th class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "px-6 py-3 text-left")">Default</th>
                        <th class="@CssManager.Combine(Tailwind.Theme.Typography.LABEL_LARGE, "px-6 py-3 text-left")">Description</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <tr>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>ContentMenuTitle</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">string</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">"Actions"</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Title for context menu button</td>
                    </tr>
                    <tr class="@Tailwind.Theme.Colors.Background.THEME_LIGHT_ONE_BG">
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>NoDataAvailableTitle</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">string</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">"No data available to display"</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Message when table is empty</td>
                    </tr>
                    <tr>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>RowsPerPageText</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">string</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">"Rows per page"</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Label for page size selector</td>
                    </tr>
                    <tr class="@Tailwind.Theme.Colors.Background.THEME_LIGHT_ONE_BG">
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>SelectNumberOfRowsToDisplayText</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">string</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">"Select number of rows to display"</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Tooltip for page size selector</td>
                    </tr>
                    <tr>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")"><code>GoToPreviousPageText</code></td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">string</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">"Go to previous page"</td>
                        <td class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "px-6 py-4")">Tooltip for previous button</td>
                    </tr>
                    <tr class="@Tailwind.Theme.Colors.Background.THEME_LIGHT_ONE_BG">
