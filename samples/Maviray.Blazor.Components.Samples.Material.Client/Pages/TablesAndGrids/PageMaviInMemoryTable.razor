    <div class="mb-12">
        <h2 class="@CssManager.Combine(Tailwind.Theme.Typography.HEADLINE_MEDIUM, "mb-3")">9. Data Model Configuration</h2>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6")">
            How to configure your data model with TableColumn attributes
        </p>
        
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6 mt-2")">
            I have made a conscious decision to avoid making some components generic, including this table. I find in a lot of cases that generic - inevitably leads to overcomplicated components. Hence this table ultimately is a collection of MaviTableCell elements with Value property of string type. Ultimately it boils down to displaying value as a string in the cell so lets not get too fancy about it. 
        </p>
        
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6 mt-2")">
            Ultimately the table expects to receive a TableDataCollection object. You are welcome to consume your own implementation of constructing that object and its nice to have full flexibility of how to achieve it but there is a default method provided as part of this library where TableDataCollectionFactory type will construct TableDataCollection for you inferring values from standard primitive types. my experience is it covers vast majority of real-world day-to-day scenarios. TableDataCollectionFactory expects to receive a collection of ITableDataItem items with relevant properties decorated with TableColumn attribute.
        </p>
        
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-gray-600 mb-6 mt-2")">
            Typically you would use your DTO models or alternatively map the DTOs to intermediate model. You then pass the collection of ITableDataItem objects to TableDataCollectionFactory.FromDataSource method. Here is sample implementation of ITableDataItem

        </p>

        <div class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_SMALL, "bg-gray-50 p-4 rounded-md")">
            <code class="text-xs block whitespace-pre-wrap">
using Maviray.Blazor.Components.Core.Attributes;
using Maviray.Blazor.Components.Core.Models.Tables;
using System.ComponentModel.DataAnnotations;

public class SampleTableCollectionItemModel : ITableDataItem
{
    public int Id { get; set; }
    public string? Guid { get; set; }

    [Display(Name = "Product Name")]
    [TableColumn(1, true)] // Sequence 1, Navigational
    public string? SampleString { get; set; }

    [Display(Name = "Category")]
    [TableColumn(2)] // Sequence 2
    public SampleEnum SampleEnum { get; set; }

    [Display(Name = "In Stock")]
    [TableColumn(3, "Positive", "Negative")] // Boolean with custom labels
    public bool? SampleBoolean { get; set; }

    [Display(Name = "Quantity")]
    [TableColumn(4)]
    public int? SampleInteger { get; set; }

    [Display(Name = "Price")]
    [TableColumn(5)]
    public decimal? SampleDecimal { get; set; }

    [Display(Name = "Last Updated")]
    [TableColumn(6, "dd.MM.yyyy")] // DateTime with format
    public DateTime? SampleDateTime { get; set; }

    // Row context menu actions
    public IEnumerable&lt;MaviTableRowContextMenuItem&gt; ContextMenu { get; set; } = [];
}

// Generate table data
private Task&lt;TableDataCollection&gt; FetchData()
{
    var items = new List&lt;SampleTableCollectionItemModel&gt; { /* your data */ };
    return Task.FromResult(TableDataCollectionFactory.FromDataSource(items));
}
