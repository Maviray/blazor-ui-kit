        <!-- Code Example -->
        <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
            <pre class="text-green-400 text-sm"><code>&lt;MaviSpinnerEqualizer ThemeColorScheme="ThemeColorScheme.Primary" 
                      ElementSize="ElementSize.Small" /&gt;

&lt;MaviSpinnerEqualizer ThemeColorScheme="ThemeColorScheme.Info" 
                      Lines="9" 
                      Label="Loading..." /&gt;

&lt;MaviSpinnerEqualizer ThemeColorScheme="ThemeColorScheme.Success" 
                      ElementSize="ElementSize.Large"
                      AriaLabel="Submitting form" /&gt;</code></pre>
        </div>

        <!-- Visual Examples -->
        <div class="space-y-4">
            @foreach (var colorScheme in (ThemeColorScheme[])Enum.GetValues(typeof(ThemeColorScheme)))
            {
                <div class="flex gap-4 items-center flex-wrap">
                    <MaviSpinnerEqualizer ThemeColorScheme="colorScheme"
                                          ElementSize="ElementSize.Small" />

                    <MaviSpinnerEqualizer ThemeColorScheme="colorScheme"
                                          ElementSize="ElementSize.Regular"
                                          Lines="9"
                                          Label="Loading..." />

                    <MaviSpinnerEqualizer ThemeColorScheme="colorScheme"
                                          ElementSize="ElementSize.Large"
                                          AriaLabel="Submitting form" />
                </div>
            }
        </div>
