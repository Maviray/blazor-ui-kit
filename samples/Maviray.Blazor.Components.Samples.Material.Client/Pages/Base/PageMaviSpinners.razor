@page "/PageMaviSpinners"
@using Maviray.Blazor.Components.Material.Components.Spinner
@inherits SamplePageBase

<PageTitle>Spinners</PageTitle>

<div class="flex flex-col gap-8 p-6 max-w-7xl mx-auto">

    <!-- MaviSpinnerStar Section -->
    <section class="space-y-4">
        <h2 class="text-2xl font-bold text-gray-800">MaviSpinnerStar</h2>
        <p class="text-gray-600">A star-shaped loading spinner with pulsing animation.</p>

        <!-- Parameters Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Parameter</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Default</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-purple-600">ElementSize</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">ElementSize</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">Regular</td>
                        <td class="px-6 py-4 text-sm text-gray-600">Size of the spinner: Small, Regular, or Large</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-purple-600">ThemeColorScheme</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">ThemeColorScheme</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">Default</td>
                        <td class="px-6 py-4 text-sm text-gray-600">Color theme: Default, Primary, Secondary, Success, Alert, Warning, Info, Dark, Light</td>
                    </tr>
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-purple-600">Scale</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">double</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">0</td>
                        <td class="px-6 py-4 text-sm text-gray-600">Custom scale value (0-1). When 0, uses ElementSize. 0.5 = half size, 1 = full size</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Code Example -->
        <div class="bg-gray-900 rounded-lg p-4 overflow-x-auto">
            <pre class="text-green-400 text-sm"><code>&lt;MaviSpinnerStar ThemeColorScheme="ThemeColorScheme.Primary" 
                 ElementSize="ElementSize.Small" /&gt;

&lt;MaviSpinnerStar ThemeColorScheme="ThemeColorScheme.Success" /&gt;

&lt;MaviSpinnerStar ThemeColorScheme="ThemeColorScheme.Alert" 
                 ElementSize="ElementSize.Large" /&gt;

&lt;MaviSpinnerStar Scale="0.75" /&gt;</code></pre>
        </div>

        <!-- Visual Examples -->
        <div class="space-y-4">
            <h3 class="text-lg font-semibold text-gray-700">Small</h3>
            <div class="flex gap-4 flex-wrap">
                @foreach (var colorScheme in (ThemeColorScheme[])Enum.GetValues(typeof(ThemeColorScheme)))
                {
                    <MaviSpinnerStar ThemeColorScheme="colorScheme" ElementSize="ElementSize.Small" />
                }
            </div>

            <h3 class="text-lg font-semibold text-gray-700">Regular</h3>
            <div class="flex gap-4 flex-wrap">
                @foreach (var colorScheme in (ThemeColorScheme[])Enum.GetValues(typeof(ThemeColorScheme)))
                {
                    <MaviSpinnerStar ThemeColorScheme="colorScheme" />
                }
            </div>

            <h3 class="text-lg font-semibold text-gray-700">Large</h3>
            <div class="flex gap-4 flex-wrap">
                @foreach (var colorScheme in (ThemeColorScheme[])Enum.GetValues(typeof(ThemeColorScheme)))
                {
                    <MaviSpinnerStar ThemeColorScheme="colorScheme" ElementSize="ElementSize.Large" />
                }
            </div>
        </div>
    </section>

    <hr class="border-gray-300" />

