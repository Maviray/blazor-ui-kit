@page "/PageIconColors"
@inherits SamplePageBase

<PageTitle>Icon Colors</PageTitle>

<div class="container mx-auto p-6 flex flex-col gap-2">
    <h1 class="text-3xl font-bold mb-6">Icon Colors</h1>

    <div>
        <p class="@CssManager.Combine(Tailwind.Theme.Typography.BODY_MEDIUM, "text-(--theme-dark-six)")">
            Example Usage
        </p>
        <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
        <code>  
&lt;MaviIconMini IconMiniType="IconMiniType.ArrowDownMini" IconColor="IconColor.DimGrey" IconSize="IconSize.Medium"&gt;&lt;/MaviIconMini&gt;

&lt;MaviIconOnline IconOnlineType="IconOnlineType.ArrowDownMini" IconColor="IconColor.DimGrey" IconSize="IconSize.Medium" OnClick="ProvideDelegate"&gt;&lt;/MaviIconOnline&gt;

&lt;MaviIconSolid IconSolidType="IconSolidType.ArrowDownMini" IconColor="IconColor.DimGrey" IconSize="IconSize.Medium" OnClick="ProvideDelegate"&gt;&lt;/MaviIconSolid&gt;
        </code>
     </pre>
    </div>

    <div class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));">
        @foreach (var iconColor in Enum.GetValues<ElementColor>())
        {
            <div class="flex flex-col justify-center items-center p-4 border rounded-lg hover:shadow-lg transition-shadow bg-white min-h-[140px]">
                <div class="flex p-4 gap-2">
                    <MaviIconMini IconMiniType="IconMiniType.XCircleMini" IconColor="@iconColor" IconSize="IconSize.Medium"></MaviIconMini>
                    <MaviIconOnline IconOnlineType="IconOnlineType.XCircleOnline" IconColor="@iconColor" IconSize="IconSize.Medium"></MaviIconOnline>
                    <MaviIconSolid IconSolidType="IconSolidType.XCircleSolid" IconColor="@iconColor" IconSize="IconSize.Medium"></MaviIconSolid>
                </div>
                <span class="mt-2 text-sm text-center text-gray-700">
                    <span class="font-semibold">IconColor.</span>@iconColor
                </span>
            </div>
        }
    </div>
</div>