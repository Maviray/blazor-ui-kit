@page "/PageTypography"
@inherits SamplePageBase
<PageTitle>Typography</PageTitle>

<div class="mx-auto max-w-5xl px-6 py-10 space-y-12">

<!-- PAGE HEADER -->
<header class="space-y-3">
    <h1 class="@Tailwind.Theme.Typography.DISPLAY_SMALL text-slate-900">
        Typography
    </h1>
    <p class="@Tailwind.Theme.Typography.BODY_MEDIUM text-slate-600">
        Material-style typography scale implemented with Tailwind CSS and design tokens.
    </p>

    <pre class="rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>
&lt;h1 class="@Tailwind.Theme.Typography.DISPLAY_SMALL text-slate-900"&gt;
   Typography
&lt;/h1&gt;
</code>
        </pre>
</header>

<!-- DISPLAY -->
<section class="space-y-6">
    <div>
        <h2 class="@Tailwind.Theme.Typography.HEADLINE_LARGE text-slate-900">Display</h2>
        <p class="@Tailwind.Theme.Typography.BODY_SMALL text-slate-600">
            Big, expressive type for hero areas.
        </p>
    </div>

    <div class="space-y-8">

        <!-- DISPLAY LARGE -->
        <div>
            <div class="@Tailwind.Theme.Typography.DISPLAY_LARGE text-slate-900">
                Display Large
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>&lt;div class="@@Tailwind.Theme.Typography.DISPLAY_LARGE text-slate-900"&gt;
    Display Large
&lt;/div&gt;
</code>
                </pre>
        </div>

        <!-- DISPLAY MEDIUM -->
        <div>
            <div class="@Tailwind.Theme.Typography.DISPLAY_MEDIUM text-slate-900">
                Display Medium
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>&lt;div class="@@Tailwind.Theme.Typography.DISPLAY_MEDIUM text-slate-900"&gt;
    Display Medium
&lt;/div&gt;
</code>
                </pre>
        </div>

        <!-- DISPLAY SMALL -->
        <div>
            <div class="@Tailwind.Theme.Typography.DISPLAY_SMALL text-slate-900">
                Display Small
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>&lt;div class="@@Tailwind.Theme.Typography.DISPLAY_SMALL text-slate-900"&gt;
    Display Small
&lt;/div&gt;
</code>
                </pre>
        </div>

    </div>
</section>


<!-- HEADING -->
<section class="space-y-6">
    <div>
        <h2 class="@Tailwind.Theme.Typography.HEADLINE_LARGE text-slate-900">Heading</h2>
        <p class="@Tailwind.Theme.Typography.BODY_SMALL text-slate-600">
            Big, expressive type for hero areas.
        </p>
    </div>

    <div class="space-y-8">

        <!-- HEADING X-LARGE -->
        <div>
            <div class="@Tailwind.Theme.Typography.HEADING_XLARGE text-slate-900">
                Heading X-Large
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>&lt;div class="@@Tailwind.Theme.Typography.HEADING_XLARGE text-slate-900"&gt;
    Heading X-Large
&lt;/div&gt;
</code>
                </pre>
        </div>

        <!-- HEADING LARGE -->
        <div>
            <div class="@Tailwind.Theme.Typography.HEADING_LARGE text-slate-900">
                Heading Large
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>&lt;div class="@@Tailwind.Theme.Typography.HEADING_LARGE text-slate-900"&gt;
    Heading Large
&lt;/div&gt;
</code>
                </pre>
        </div>

        <!-- HEADING MEDIUM -->
        <div>
            <div class="@Tailwind.Theme.Typography.HEADING_MEDIUM text-slate-900">
                Heading Medium
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>&lt;div class="@@Tailwind.Theme.Typography.HEADING_MEDIUM text-slate-900"&gt;
    Heading Medium
&lt;/div&gt;
</code>
                </pre>
        </div>

        <!-- HEADING SMALL -->
        <div>
            <div class="@Tailwind.Theme.Typography.HEADING_SMALL text-slate-900">
                Heading Small
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>&lt;div class="@@Tailwind.Theme.Typography.HEADING_SMALL text-slate-900"&gt;
    Display Small
&lt;/div&gt;
</code>
                </pre>
        </div>

    </div>
</section>

<!-- HEADLINE -->
<section class="space-y-6">
    <div>
        <h2 class="@Tailwind.Theme.Typography.HEADLINE_LARGE text-slate-900">Headline</h2>
        <p class="@Tailwind.Theme.Typography.BODY_SMALL text-slate-600">
            Page and section headings.
        </p>
    </div>

    <div class="space-y-6">

        <div>
            <div class="@Tailwind.Theme.Typography.HEADLINE_LARGE text-slate-900">
                Headline Large
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>&lt;h2 class="@@Tailwind.Theme.Typography.HEADLINE_LARGE text-slate-900"&gt;
    Headline Large
&lt;/h2&gt;</code>
                </pre>
        </div>

        <div>
            <div class="@Tailwind.Theme.Typography.HEADLINE_MEDIUM text-slate-900">
                Headline Medium
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
                <code>  
&lt;h3 class="@@Tailwind.Theme.Typography.HEADLINE_MEDIUM text-slate-900"&gt;
    Headline Medium
    &lt;/h3&gt;
                </code>
                </pre>
        </div>

        <div>
            <div class="@Tailwind.Theme.Typography.HEADLINE_SMALL text-slate-900">
                Headline Small
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>&lt;h4 class="@@Tailwind.Theme.Typography.HEADLINE_SMALL text-slate-900"&gt;
    Headline Small
&lt;/h4&gt;</code>
                </pre>
        </div>

    </div>
</section>

<!-- TITLE -->
<section class="space-y-6">
    <div>
        <h2 class="@Tailwind.Theme.Typography.HEADLINE_LARGE text-slate-900">Title</h2>
        <p class="@Tailwind.Theme.Typography.BODY_SMALL text-slate-600">
            Cards, dialogs, lists.
        </p>
    </div>

    <div class="space-y-6">

        <div>
            <div class="@Tailwind.Theme.Typography.TITLE_LARGE text-slate-900">
                TITLE LARGE
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
                <code>  
&lt;div class="@@Tailwind.Theme.Typography.TITLE_LARGE text-slate-900"&gt;
    TITLE LARGE
&lt;/div&gt;
                </code>
                </pre>
        </div>

        <div>
            <div class="@Tailwind.Theme.Typography.TITLE_MEDIUM text-slate-900">
                TITLE MEDIUM
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
                <code>  
&lt;div class="@@Tailwind.Theme.Typography.TITLE_MEDIUM text-slate-900"&gt;
    TITLE MEDIUM
&lt;/div&gt;
                </code>
                </pre>
        </div>

        <div>
            <div class="@Tailwind.Theme.Typography.TITLE_SMALL text-slate-900">
                TITLE SMALL
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
                <code>  
&lt;div class="@@Tailwind.Theme.Typography.TITLE_SMALL text-slate-900"&gt;
    TITLE SMALL
&lt;/div&gt;
                </code>
                </pre>
        </div>
    </div>
</section>

<!-- BODY -->
<section class="space-y-6">
    <div>
        <h2 class="@Tailwind.Theme.Typography.HEADLINE_LARGE text-slate-900">Body</h2>
    </div>

    <div class="space-y-6 max-w-3xl">

        <div>
            <div class="@Tailwind.Theme.Typography.BODY_LARGE text-slate-900">
                BODY_LARGE — @LOREM_IPSUM
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
                <code>  
&lt;div class="@@Tailwind.Theme.Typography.BODY_LARGE text-slate-900"&gt;
    BODY_LARGE
&lt;/div&gt;
                </code>
                </pre>
        </div>

        <div>
            <div class="@Tailwind.Theme.Typography.BODY_MEDIUM text-slate-900">
                BODY_MEDIUM — @LOREM_IPSUM
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
                <code>  
&lt;div class="@@Tailwind.Theme.Typography.BODY_MEDIUM text-slate-900"&gt;
    BODY_MEDIUM
&lt;/div&gt;
                </code>
                </pre>
        </div>

        <div>
            <div class="@Tailwind.Theme.Typography.BODY_SMALL">
                BODY_SMALL — @LOREM_IPSUM
            </div>
            <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
                <code>  
&lt;div class="@@Tailwind.Theme.Typography.BODY_SMALL text-slate-900"&gt;
    BODY_SMALL
&lt;/div&gt;
                </code>
                </pre>
        </div>
    </div>
</section>

<!-- LABEL -->
<section class="space-y-6">
    <div>
        <h2 class="@Tailwind.Theme.Typography.HEADLINE_LARGE text-slate-900">Label</h2>
        <p class="@Tailwind.Theme.Typography.BODY_SMALL text-slate-600">
            Buttons, chips, UI labels.
        </p>
    </div>

    <div class="flex flex-wrap gap-6">

        <div class="flex flex-col gap-2">
            <div class="rounded-md border px-3 py-2 text-slate-900 border-slate-200 bg-slate-50 w-48 @Tailwind.Theme.Typography.LABEL_LARGE">
                LABEL LARGE
            </div>
            <div>
                <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>  
  &lt;div class="@@Tailwind.Theme.Typography.LABEL_LARGE rounded-md border px-3 py-2 text-slate-900 border-slate-200 bg-slate-50 py-2"&gt;
         LABEL LARGE
  &lt;/div&gt;
</code>
                </pre>
            </div>
        </div>

        <div class="flex flex-col gap-2">
            <div class="rounded-md border px-3 py-2 text-slate-900 border-slate-200 bg-slate-50 w-40 @Tailwind.Theme.Typography.LABEL_MEDIUM">
                LABEL MEDIUM
            </div>
            <div>
                <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>  
  &lt;div class="@@Tailwind.Theme.Typography.LABEL_MEDIUM rounded-md border px-3 py-2 text-slate-900 border-slate-200 bg-slate-50 py-2"&gt;
         LABEL MEDIUM
  &lt;/div&gt;
</code>
                </pre>
            </div>
        </div>

        <div class="flex flex-col gap-2">
            <div class="rounded-md border px-3 py-2 text-slate-900 border-slate-200 bg-slate-50 w-32 @Tailwind.Theme.Typography.LABEL_SMALL">
                LABEL SMALL
            </div>
            <div>
                <pre class="mt-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
<code>  
  &lt;div class="@@Tailwind.Theme.Typography.LABEL_SMALL rounded-md border px-3 py-2 text-slate-900 border-slate-200 bg-slate-50 py-2"&gt;
         LABEL SMALL
  &lt;/div&gt;
</code>
                </pre>
            </div>
        </div>

    </div>
</section>

</div>

