<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maviray.Blazor.Components.Samples.Material.Client\Maviray.Blazor.Components.Samples.Material.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <TailwindCssOutput>wwwroot/css/maviray.showcase.server.min.css</TailwindCssOutput>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Tailwind.targets" />
</Project>
